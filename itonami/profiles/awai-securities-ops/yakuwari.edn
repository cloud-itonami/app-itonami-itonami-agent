;; What awai-securities-ops may do (AWAI-3156, network-awai-apex ADR 0042 D4).
;; Drafting, reading and reconciling only. Ordering, delivering or paying,
;; sending and signing are blocked; the account holder acts through their own custodian.
{:yakuwari/capabilities
 [{:capability :read_source :decision :autonomous :note "Only the holder's request and received-message files in workspace/inbox and the profile's fixtures; no credentials, market data or network access"}
  {:capability :review_source :decision :autonomous :note "Checks and reconciliations of the holder's own messages only; no approval minting"}
  {:capability :draft_artifact :decision :autonomous :note "Settlement-instruction drafts and reconciliation records in its own host-local workspace; a draft is not an order or a sent message"}
  {:capability :record_local_receipt :decision :autonomous :note "Own job evidence only; no settlement or paid-work claim"}
  {:capability :delegate_task :decision :blocked}
  {:capability :external_messaging :decision :blocked :note "No message to a custodian, CSD, broker, SWIFTNet or any other party"}
  {:capability :publish :decision :blocked}
  {:capability :spend :decision :blocked :note "No purchase, order or fee of any kind"}
  {:capability :transfer_funds :decision :blocked :note "No order, delivery, receipt instruction to a third party, payment or trade"}
  {:capability :storage_upload :decision :blocked}
  {:capability :delete_data :decision :blocked}
  {:capability :manage_services :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked :note "No signing of messages or transactions"}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
