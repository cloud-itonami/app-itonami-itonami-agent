;; What awai-web-research may do (AWAI-3164, network-awai-apex ADR 0043 D5 and D8).
;; Read the Kumade snapshots the user supplied, draft the index and its Awai file,
;; and, with the user's approval for each write, put that Awai file into Yataverse.
;; No network fetch (O2 is open), no publishing, sending, signing or spending.
{:yakuwari/capabilities
 [{:capability :read_source :decision :autonomous :note "Only Kumade snapshot exports the user placed in workspace/inbox and the profile's fixtures; no network fetch or credentials"}
  {:capability :review_source :decision :autonomous :note "Index fields, duplicates and noindex from the supplied snapshots only; no approval minting"}
  {:capability :draft_artifact :decision :autonomous :note "Index drafts and Awai files in its own host-local workspace; a draft is not a publication"}
  {:capability :record_local_receipt :decision :autonomous :note "Own job evidence only"}
  {:capability :storage_upload :decision :approval-required :note "Only yataverse car-put of its own workspace/awai/<batch>.awai, one write per approval naming that root CID and destination (ADR 0043 D8); index columns only, never page text, links or HTML"}
  {:capability :delegate_task :decision :blocked}
  {:capability :external_messaging :decision :blocked}
  {:capability :publish :decision :blocked :note "Persisting to Yataverse is not an announcement or a post"}
  {:capability :spend :decision :blocked}
  {:capability :transfer_funds :decision :blocked}
  {:capability :delete_data :decision :blocked}
  {:capability :manage_services :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
