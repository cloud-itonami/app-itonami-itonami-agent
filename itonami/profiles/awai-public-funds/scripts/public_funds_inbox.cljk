;; Handle the requests placed in <profile>/workspace/inbox/ (AWAI-3294).
;; Source files a request names in :sources (:file "sources/<name>") are read
;; from <profile>/workspace/inbox/sources/; the user downloads them from the
;; publisher. This job makes no network request (ADR 0046 D8, O1 pending).
;;
;; For each <name>.edn request it writes, under <profile>/workspace/drafts/,
;; <request-id>.result.edn (an awai.public-funds/1 record) or
;; <request-id>.refusal.edn. The workspace is host-local and never part of the
;; profile bundle. Nothing is published or sent (O2 pending).
;;
;; Run by itonami-agent as a no-agent cron job (cwd = scripts/).
(require '["node:fs" :as fs]
         '["node:path" :as path]
         '[public-funds-io :as io]
         '[awai-public-funds.analyze :as a])

(def inbox (path/join io/home "workspace" "inbox"))
(def drafts (path/join io/home "workspace" "drafts"))
(def data (io/data))

(defn spit [p s] (fs/writeFileSync p (str s)))

(fs/mkdirSync drafts #js {:recursive true})
(let [files (if (fs/existsSync inbox)
              (sort (filter #(.endsWith % ".edn") (js->clj (fs/readdirSync inbox))))
              [])]
  (doseq [file files]
    (let [request (io/read-edn (path/join inbox file))
          id (:request/id request)]
      (if-not (and (io/safe-id? id) (every? (comp io/safe-rel? :file) (:sources request)))
        (println (str "skip  " file "  bad :request/id or :sources path"))
        (let [{:keys [result refusal]} (a/analyze request (io/inputs inbox request) (:cofog-map data) (:ministries data))]
          (if refusal
            (do (spit (path/join drafts (str id ".refusal.edn")) (str (pr-str refusal) "\n"))
                (println (str "refused  " id "  " (name (:reason refusal)))))
            (do (spit (path/join drafts (str id ".result.edn")) (str (pr-str result) "\n"))
                (println (str "analyzed  " id "  " (count (:rows result)) " rows"))))))))
  (println (str (count files) " request(s) read from workspace/inbox")))
