;; What awai-data-contribution-rewards may do (AWAI-3208, under AWAI-3206).
;; Checking contributions and requesting a test-stage epoch calculation only.
;; Paying, minting, reserving, signing, contacting participants and uploading
;; are blocked. Production payout stays disabled (cloud-murakumo-api ADR-261016).
{:yakuwari/capabilities
 [{:capability :read_source :decision :autonomous :note "Only contribution requests in workspace/inbox, the profile's fixtures and the pinned contract commit of a local cloud-murakumo-api clone; no credentials or network access"}
  {:capability :review_source :decision :autonomous :note "Rights, consent and training-use decisions by the pinned contract only; never sets a -verified? or -reviewed? marker"}
  {:capability :draft_artifact :decision :autonomous :note "Reward-calculation requests and test-stage results in its own host-local workspace; a result is not a payout"}
  {:capability :record_local_receipt :decision :autonomous :note "Own job evidence and its duplicate index only; no settlement or paid-work claim"}
  {:capability :delegate_task :decision :blocked}
  {:capability :external_messaging :decision :blocked :note "No message to a participant, reviewer or any other party"}
  {:capability :publish :decision :blocked}
  {:capability :spend :decision :blocked}
  {:capability :transfer_funds :decision :blocked :note "No YATA mint, reservation, claim or transfer"}
  {:capability :storage_upload :decision :blocked :note "No upload to Yataverse, Awai FS or any store"}
  {:capability :delete_data :decision :blocked :note "Withdrawal is recorded by the server; the bot deletes nothing"}
  {:capability :manage_services :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked :note "No signing of epochs, claims or transactions"}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
