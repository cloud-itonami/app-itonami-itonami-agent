;; What awai-hiring-ops may do (AWAI-3173, network-awai-apex ADR 0043 D4).
;; Checking and publishing the user's own company's postings to the host-local
;; index, and searching it. Posting to LinkedIn, Indeed or any job board,
;; messaging and contacting applicants are blocked.
{:yakuwari/capabilities
 [{:capability :read_source :decision :autonomous :note "Only the user's request files in workspace/inbox, the host-local posting index and the profile's fixtures; no credentials or network access"}
  {:capability :review_source :decision :autonomous :note "recruit and isic-6399 gate checks of the user's own postings only; no approval minting"}
  {:capability :draft_artifact :decision :autonomous :note "Announcement drafts and posting records in its own host-local workspace and index; a local record is not an external publication"}
  {:capability :record_local_receipt :decision :autonomous :note "Own job evidence only; no hiring outcome or paid-work claim"}
  {:capability :delegate_task :decision :blocked}
  {:capability :external_messaging :decision :blocked :note "No message to an applicant, LinkedIn, Indeed or any other party"}
  {:capability :publish :decision :blocked :note "No posting to LinkedIn, Indeed, a job board or any public index"}
  {:capability :spend :decision :blocked}
  {:capability :transfer_funds :decision :blocked}
  {:capability :storage_upload :decision :blocked}
  {:capability :delete_data :decision :blocked}
  {:capability :manage_services :decision :blocked}
  {:capability :git_push :decision :blocked}
  {:capability :git_merge :decision :blocked}
  {:capability :use_signing_identity :decision :blocked}
  {:capability :export_private_keys :decision :blocked}
  {:capability :enable_cron :decision :blocked}]
 :yakuwari/runners [{:runner :itonami-agent :weight 1}]}
