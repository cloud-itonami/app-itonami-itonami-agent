        (= i 127) -4614344751691227646
        :else (zero)))

(defn- count128 [frame :string i :i64 acc :i64] :i64
  (if (>= i 128)
    acc
    (count128 frame (+ i 1)
              (if (close? (log-mel-bin-n frame 128 i) (want128 i)) (+ acc 1) acc))))

;; llama.cpp fill_mel_filterbank_matrix(128, 400, 16000) weights, billionths
(defn- nano [v :i64] :i64
  (f64-to-i64-truncating (f64-add (f64-mul (f64-from-bits v) 1000000000.0) 0.5)))
(defn- w-ok? [m :i64 k :i64 ref :i64] :bool
  (let [d (- (nano (mel-weight-n 128 m k)) ref)]
    (and (<= d 1) (>= d -1))))

;; 89 (80 filters) + 128 log-mel values + 4 filterbank weights + 1 refusal of an
;; invalid frame by the 128 path = 222
(defn match-count [] :i64
  (+ (match-count-80)
  (+ (count128 (test-frame) 0 0)
  (+ (if (w-ok? 3 2 18018579) 1 0)
  (+ (if (w-ok? 40 24 40376365) 1 0)
  (+ (if (w-ok? 77 59 11133937) 1 0)
  (+ (if (w-ok? 127 195 5041602) 1 0)
     (if (close? (log-mel-bin-n "8000" 128 0) (zero)) 1 0))))))))
