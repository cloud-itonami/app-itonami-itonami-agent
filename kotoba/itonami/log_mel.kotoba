(defn- close? [a :i64 b :i64] :bool
  (f64-lt (f64-abs (f64-sub (f64-from-bits a) (f64-from-bits b))) 0.000001))

(defn- count-run [i :i64 mx :i64 acc :i64] :i64
  (if (>= i 80)
    acc
    (count-run (+ i 1) mx (if (close? (test-log-mel i) (want i)) (+ acc 1) acc))))

;; 80 log-mel matches + 3 normalised matches (bin 0, the peak, bin 79) = 83
(defn match-count [] :i64
  (let [mx 4610605438108607510
        n (count-run 0 mx 0)]
    (+ n
       (+ (if (close? (normalize-log (test-log-mel 0) mx) 4604909686020972960) 1 0)
          (+ (if (close? (normalize-log (test-log-mel 26) mx) 4609164073534007558) 1 0)
             (if (close? (normalize-log (test-log-mel 79) mx) 4603668686551299024) 1 0))))))
