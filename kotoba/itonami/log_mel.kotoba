(defn- close? [a :i64 b :i64] :bool
  (f64-lt (f64-abs (f64-sub (f64-from-bits a) (f64-from-bits b))) 0.000001))

(defn- count-run [frame :string i :i64 acc :i64] :i64
  (if (>= i 80)
    acc
    (count-run frame (+ i 1)
               (if (close? (log-mel-bin frame i) (want i)) (+ acc 1) acc))))

;; 80 log-mel matches + 3 normalised (bin 0, peak, bin 79) + 2 silence floors
;; (bin 0 and 79 at -10) + 4 frame checks (valid, short, non-hex, long) = 89
(defn- match-count-80 [] :i64
  (let [f (test-frame)
        mx 4610605418141932256
        n (count-run f 0 0)]
    (+ n
    (+ (if (close? (normalize-log (log-mel-bin f 0) mx) 4604909737945871916) 1 0)
    (+ (if (close? (normalize-log (log-mel-bin f 26) mx) 4609164068542338744) 1 0)
    (+ (if (close? (normalize-log (log-mel-bin f 79) mx) 4603668748900529800) 1 0)
    (+ (if (close? (log-mel-bin (silence-frame) 0) (fsub (zero) (f64-to-bits 10.0))) 1 0)
    (+ (if (close? (log-mel-bin (silence-frame) 79) (fsub (zero) (f64-to-bits 10.0))) 1 0)
    (+ (if (frame-valid? f) 1 0)
    (+ (if (frame-valid? "8000") 0 1)
    (+ (if (frame-valid? (string-concat "zz" (string-substring f 2 1600))) 0 1)
    (if (frame-valid? (string-concat f "00")) 0 1))))))))))))

