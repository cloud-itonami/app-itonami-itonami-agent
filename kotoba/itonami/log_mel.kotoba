;; Scalar core of whisper's log-mel front end (JUN-866, native STT step 1).
;; The pinned Amu seed subset has no sin/cos/exp/log and no vectors, so the
;; math is built here from f64 add/sub/mul/div on bit patterns held in i64:
;;   - turn-cos / turn-sin: cos/sin(2*pi*r/n) by integer quarter-turn reduction
;;     plus a 12-term Taylor series on [0, pi/2)
;;   - exp: 30-term series (domain |x| <= 4, enough for the mel scale)
;;   - ln: halving/doubling into [1/sqrt2, sqrt2), then 2*atanh(z) series
;; On top: periodic Hann window, Slaney mel scale and filterbank weights
;; (80 mels, 0-8000 Hz, sr 16000, n_fft 400, librosa htk=False norm=slaney),
;; log10 with the 1e-10 floor, and whisper's normalisation. Every f64 value is
;; an i64 bit pattern.
;;
;; INPUT PATH (JUN-867). The seed has no vectors or byte reads, and a native
;; guest receives data as strings (argv on :cli/args, lines on :io/read). A
;; frame is therefore one string of exactly 1600 hex characters: 400 samples
;; of 4 digits each, offset-binary int16 (hex of sample + 32768, so 8000 is
;; silence), sample n at characters 4n..4n+3, samples scaled by 1/32768. The
;; host drives the 3000-frame window one such line per frame.
(ns itonami.log-mel
  (:export [turn-cos turn-sin exp-series ln-pos log10-floor hann
            hz-to-mel mel-to-hz mel-weight mel-weight-n log-mel-bin-n normalize-log
            frame-valid? frame-sample power-bin log-mel-bin match-count]))

(defn- fadd [a :i64 b :i64] :i64 (f64-to-bits (f64-add (f64-from-bits a) (f64-from-bits b))))
(defn- fsub [a :i64 b :i64] :i64 (f64-to-bits (f64-sub (f64-from-bits a) (f64-from-bits b))))
(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- fdiv [a :i64 b :i64] :i64 (f64-to-bits (f64-div (f64-from-bits a) (f64-from-bits b))))
(defn- flt [a :i64 b :i64] :bool (f64-lt (f64-from-bits a) (f64-from-bits b)))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))
(defn- one [] :i64 (f64-to-bits 1.0))
(defn- zero [] :i64 (f64-to-bits 0.0))
(defn- half-pi [] :i64 4609753056924675352)
(defn- neg [a :i64] :i64 (f64-to-bits (f64-neg (f64-from-bits a))))

;; ---- sin / cos of a rational turn ---------------------------------------
;; Horner on t2 = theta^2:  sin = theta*(1 - t2/(2*3)*(1 - t2/(4*5)*(...)))
(defn- sin-poly [t2 :i64 k :i64 acc :i64] :i64
  (if (< k 1)
    acc
    (sin-poly t2 (- k 1)
              (fsub (one) (fmul (fdiv t2 (itof (* (* 2 k) (+ (* 2 k) 1)))) acc)))))

;; cos = 1 - t2/(1*2)*(1 - t2/(3*4)*(...))
(defn- cos-poly [t2 :i64 k :i64 acc :i64] :i64
  (if (< k 1)
    acc
    (cos-poly t2 (- k 1)
              (fsub (one) (fmul (fdiv t2 (itof (* (- (* 2 k) 1) (* 2 k)))) acc)))))

(defn- theta [s :i64 quarter :i64] :i64
  (fdiv (fmul (half-pi) (itof s)) (itof quarter)))

(defn- sin-first [s :i64 quarter :i64] :i64
  (let [t (theta s quarter)]
    (fmul t (sin-poly (fmul t t) 12 (one)))))

(defn- cos-first [s :i64 quarter :i64] :i64
  (let [t (theta s quarter)]
    (cos-poly (fmul t t) 12 (one))))

;; cos(2*pi*r/n), n a positive multiple of 4, r >= 0
(defn turn-cos [r :i64 n :i64] :i64
  (let [quarter (quot n 4)
        m (mod r n)
        q (quot m quarter)
        s (mod m quarter)]
    (cond (= q 0) (cos-first s quarter)
          (= q 1) (neg (sin-first s quarter))
          (= q 2) (neg (cos-first s quarter))
          :else (sin-first s quarter))))

;; sin(2*pi*r/n)
(defn turn-sin [r :i64 n :i64] :i64
  (let [quarter (quot n 4)
        m (mod r n)
        q (quot m quarter)
        s (mod m quarter)]
    (cond (= q 0) (sin-first s quarter)
          (= q 1) (cos-first s quarter)
          (= q 2) (neg (sin-first s quarter))
          :else (neg (cos-first s quarter)))))

;; ---- exp / ln -------------------------------------------------------------
;; exp(x) = 1 + x/1*(1 + x/2*(1 + x/3*(...))), 30 terms, for |x| <= 4
(defn- exp-run [x :i64 k :i64 acc :i64] :i64
  (if (< k 1)
    acc
    (exp-run x (- k 1) (fadd (one) (fmul (fdiv x (itof k)) acc)))))

(defn exp-series [x :i64] :i64
  (exp-run x 30 (one)))

;; scale x > 0 into [1/sqrt2, sqrt2) by powers of two; the count is separate
(defn- scaled [x :i64] :i64
  (cond (not (flt x 4609047870845172685)) (scaled (fdiv x (f64-to-bits 2.0)))
        (flt x 4604544271217802189) (scaled (fmul x (f64-to-bits 2.0)))
        :else x))

(defn- exponent [x :i64 e :i64] :i64
  (cond (not (flt x 4609047870845172685)) (exponent (fdiv x (f64-to-bits 2.0)) (+ e 1))
        (flt x 4604544271217802189) (exponent (fmul x (f64-to-bits 2.0)) (- e 1))
        :else e))

;; sum_{j=0..K} z^(2j)/(2j+1) by Horner in z2
(defn- atanh-run [z2 :i64 j :i64 acc :i64] :i64
  (if (< j 0)
    acc
    (atanh-run z2 (- j 1) (fadd (fdiv (one) (itof (+ (* 2 j) 1))) (fmul z2 acc)))))

;; ln(x) for finite x > 0
(defn ln-pos [x :i64] :i64
  (let [m (scaled x)
        e (exponent x 0)
        z (fdiv (fsub m (one)) (fadd m (one)))
        s (atanh-run (fmul z z) 15 (fdiv (one) (itof 31)))]
    (fadd (fmul (itof e) 4604418534313441775)
          (fmul (f64-to-bits 2.0) (fmul z s)))))

;; log10(max(x, 1e-10))
(defn log10-floor [x :i64] :i64
  (let [v (if (flt x 4457293557087583675) 4457293557087583675 x)]
    (fdiv (ln-pos v) 4612367379483415830)))

;; ---- window, mel scale, filterbank -----------------------------------------
;; periodic Hann, as torch.hann_window(400)
(defn hann [n :i64] :i64
  (fsub (f64-to-bits 0.5) (fmul (f64-to-bits 0.5) (turn-cos n 400))))

(defn- f-sp [] :i64 (fdiv (f64-to-bits 200.0) (f64-to-bits 3.0)))
(defn- logstep [] :i64 (fdiv (ln-pos (f64-to-bits 6.4)) (f64-to-bits 27.0)))

;; Slaney mel scale
(defn hz-to-mel [f :i64] :i64
  (if (flt f (f64-to-bits 1000.0))
    (fdiv f (f-sp))
    (fadd (f64-to-bits 15.0)
          (fdiv (ln-pos (fdiv f (f64-to-bits 1000.0))) (logstep)))))

(defn mel-to-hz [m :i64] :i64
  (if (flt m (f64-to-bits 15.0))
    (fmul (f-sp) m)
    (fmul (f64-to-bits 1000.0)
          (exp-series (fmul (logstep) (fsub m (f64-to-bits 15.0)))))))

;; edge i of the 82 mel-spaced points between 0 and 8000 Hz
(defn- mel-point [i :i64 nm :i64] :i64
  (mel-to-hz (fdiv (fmul (itof i) (hz-to-mel (f64-to-bits 8000.0))) (itof (+ nm 1)))))

;; weight of FFT bin k in the triangle with edges p0 < p1 < p2 (Hz), then slaney
;; area norm
(defn- weight-at [p0 :i64 p1 :i64 p2 :i64 k :i64] :i64
  (let [fk (fdiv (fmul (itof k) (f64-to-bits 16000.0)) (f64-to-bits 400.0))
        lower (fdiv (fsub fk p0) (fsub p1 p0))
        upper (fdiv (fsub p2 fk) (fsub p2 p1))
        tri (f64-to-bits (f64-max 0.0 (f64-min (f64-from-bits lower) (f64-from-bits upper))))]
    (fdiv (fmul tri (f64-to-bits 2.0)) (fsub p2 p0))))

;; weight of FFT bin k in mel filter m of an nm-filter bank (80 for whisper small,
;; 128 for whisper large-v3 / Qwen3-ASR)
(defn mel-weight-n [nm :i64 m :i64 k :i64] :i64
  (weight-at (mel-point m nm) (mel-point (+ m 1) nm) (mel-point (+ m 2) nm) k))

;; the 80-filter bank
(defn mel-weight [m :i64 k :i64] :i64 (mel-weight-n 80 m k))

;; whisper: clamp to (max over the whole window) - 8, then (x + 4) / 4
(defn normalize-log [x :i64 window-max :i64] :i64
  (fdiv (fadd (f64-to-bits (f64-max (f64-from-bits x)
                                    (f64-sub (f64-from-bits window-max) 8.0)))
              (f64-to-bits 4.0))
        (f64-to-bits 4.0)))

;; ---- frame input (hex string) and direct DFT ------------------------------
(defn- hex-digit [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55)
        :else -1))

(defn- all-hex? [s :string i :i64 n :i64] :bool
  (cond (>= i n) true
        (< (hex-digit (string-code-point-at s i)) 0) false
        :else (all-hex? s (+ i 1) n)))

;; exactly 1600 hex characters
(defn frame-valid? [frame :string] :bool
  (and (= (string-length frame) 1600) (all-hex? frame 0 1600)))

;; sample n of a valid frame, as f64 bits: (hex4 - 32768) / 32768
(defn frame-sample [frame :string n :i64] :i64
  (let [o (* 4 n)
        v (+ (* 4096 (hex-digit (string-code-point-at frame o)))
          (+ (* 256 (hex-digit (string-code-point-at frame (+ o 1))))
          (+ (* 16 (hex-digit (string-code-point-at frame (+ o 2))))
             (hex-digit (string-code-point-at frame (+ o 3))))))]
    (fdiv (itof (- v 32768)) (f64-to-bits 32768.0))))

;; Direct DFT by rotation: (cn, sn) = (cos, sin) of 2*pi*k*n/400 and (ch, sh) the
;; same for 2*pi*n/400 (the Hann window), each stepped by the angle-addition
;; formula from the constants (ck, sk) and (c1, s1) -- one series evaluation per
;; bin instead of two per sample, the rounding drift over 400 steps stays near
;; 1e-14 (the gate holds 1e-6).
(defn- dft-run [frame :string n :i64 re :i64 im :i64
                cn :i64 sn :i64 ch :i64 sh :i64
                ck :i64 sk :i64 c1 :i64 s1 :i64] :i64
  (if (>= n 400)
    (fadd (fmul re re) (fmul im im))
    (let [xw (fmul (frame-sample frame n)
                   (fsub (f64-to-bits 0.5) (fmul (f64-to-bits 0.5) ch)))]
      (dft-run frame (+ n 1)
               (fadd re (fmul xw cn))
               (fadd im (fmul xw sn))
               (fsub (fmul cn ck) (fmul sn sk))
               (fadd (fmul sn ck) (fmul cn sk))
               (fsub (fmul ch c1) (fmul sh s1))
               (fadd (fmul sh c1) (fmul ch s1))
               ck sk c1 s1))))

;; |X_k|^2 of the Hann-windowed frame, k = 0..200; -1.0 for an invalid frame
(defn power-bin [frame :string k :i64] :i64
  (if (frame-valid? frame)
    (dft-run frame 0 (zero) (zero)
             (one) (zero) (one) (zero)
             (turn-cos k 400) (turn-sin k 400) (turn-cos 1 400) (turn-sin 1 400))
    (fsub (zero) (one))))

(defn- energy-run [frame :string p0 :i64 p1 :i64 p2 :i64 k :i64 acc :i64] :i64
  (if (>= k 201)
    acc
    (let [w (weight-at p0 p1 p2 k)]
      (energy-run frame p0 p1 p2 (+ k 1)
                  (if (flt (zero) w) (fadd acc (fmul w (power-bin frame k))) acc)))))

;; log10(max(mel energy, 1e-10)) of mel filter m (0..79) for one frame;
;; 0.0 for an invalid frame so a caller cannot mistake it for the floor
(defn log-mel-bin-n [frame :string nm :i64 m :i64] :i64
  (if (frame-valid? frame)
    (log10-floor (energy-run frame (mel-point m nm) (mel-point (+ m 1) nm) (mel-point (+ m 2) nm) 0 (zero)))
    (zero)))

;; the 80-filter bank
(defn log-mel-bin [frame :string m :i64] :i64 (log-mel-bin-n frame 80 m))

;; ---- gate fixtures ------------------------------------------------------------
;; two tones and a quadratic chirp, quantised to int16
(defn- test-frame [] :string
  "")

;; digital silence: every sample 0 -> every mel at the 1e-10 floor
(defn- silence-frame [] :string
  "")

