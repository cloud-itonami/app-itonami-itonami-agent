;; The feed-forward half of one Qwen3-ASR audio-encoder layer on the real weights (JUN-916):
;;   out = x + fc2(gelu(fc1(LayerNorm(x))))      (every projection with its bias)
;; for one 896-wide token. The weights stay in the safetensors file and are read one row at a
;; time with FS2 E requests (itonami.weights-file reads the header); activations live in internal
;; vector-i64 arrays of f64 bit patterns (vector-alloc, filled in place with vector-assoc!; a
;; vector-f64 built by conj copies itself on every append and exhausts the arena), which the
;; seed allows only inside a module (exports are i64 bit patterns).
;; LayerNorm uses eps 1e-5 (the torch default; config.json names none) and the exact GELU.
;; erf and exp are series, so results are compared with CPython to a tolerance, not bit for bit.
;; The input token t is x[i] = (((3 i + 1 + 5 t) mod 11) - 5) / 4 (t = 0 for the feed-forward half).
;; The attention half (JUN-917) runs 3 tokens through
;;   out_t = x_t + out_proj(softmax(q_t . k_u / 8) v_u)   with q, k, v from LayerNorm(x)
;; over 14 heads of 64, softmax over all three tokens (non-causal), every projection with its bias.
(ns itonami.audio-ffn
  (:require [itonami.bf16 :as bf]
            [itonami.gelu-erf :as ge]
            [itonami.nn-ops :as nn]
            [itonami.safetensors :as st]
            [itonami.weights-file :as wf])
  (:export [ffn-at ffn-sum attn-at attn-sum layer-at layer-sum])
  (:capabilities [:fs/app-data]))

(defn- fadd [a :i64 b :i64] :i64 (f64-to-bits (f64-add (f64-from-bits a) (f64-from-bits b))))
(defn- fsub [a :i64 b :i64] :i64 (f64-to-bits (f64-sub (f64-from-bits a) (f64-from-bits b))))
(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- fdiv [a :i64 b :i64] :i64 (f64-to-bits (f64-div (f64-from-bits a) (f64-from-bits b))))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))
(defn- zero [] :i64 (f64-to-bits 0.0))

(defn- frame [op :string path :string tail :string] :string
  (string-concat "\u0000FS2\u0000"
    (string-concat op (string-concat path (string-concat "\u0000" tail)))))

;; integer BF16 -> f64 (same as itonami.weights-file; zero and subnormals take the exact decoder)
(defn- bf16-fast [v :i64] :i64
  (let [e (mod (quot v 128) 256)]
    (if (= e 0)
      (bf/bf16-to-f64 v)
      (let [pos (+ (i64-shift-left (+ e 896) 52) (i64-shift-left (mod v 128) 45))]
        (if (>= v 32768)
          (f64-to-bits (f64-neg (f64-from-bits pos)))
          pos)))))

(defn- push-bf16 [r :bytes i :i64 n :i64 v :vector-i64] :vector-i64
  (if (>= i n)
    v
    (push-bf16 r (+ i 1) n
      (vector-assoc! v i
        (bf16-fast (+ (bytes-at r (+ 5 (* 2 i))) (* 256 (bytes-at r (+ 6 (* 2 i))))))))))

;; count BF16 elements at absolute file offset off, as a vector (empty when short)
(defn- read-vec [path :string off :i64 count :i64] :vector-i64
  (let [r (typed-cap-call :fs/app-data :string :bytes
            (frame "E" path (string-concat (string-from-i64 off)
                              (string-concat ":" (string-from-i64 (* count 2))))))]
    (if (= (bytes-count r) (+ 5 (* count 2)))
      (push-bf16 r 0 count (vector-alloc count))
      (vector-alloc 0))))

;; absolute data offset of a 2-D or 1-D BF16 tensor, or -1
(defn- tensor-off [h :string n :i64 name :string] :i64
  (if (string=? (st/st-dtype h name) "BF16")
    (let [b (st/st-begin h name)]
      (if (< b 0) -1 (+ (+ 8 n) b)))
    -1))

(defn- lname [layer :i64 tail :string] :string
  (string-concat "thinker.audio_tower.layers."
    (string-concat (string-from-i64 layer) (string-concat "." tail))))

(defn- vec-sum [v :vector-i64 i :i64 acc :i64] :i64
  (if (>= i (vector-count v))
    acc
    (vec-sum v (+ i 1) (fadd acc (vector-at v i)))))

(defn- sq-dev [v :vector-i64 i :i64 mean :i64 acc :i64] :i64
  (if (>= i (vector-count v))
    acc
    (let [d (fsub (vector-at v i) mean)]
      (sq-dev v (+ i 1) mean (fadd acc (fmul d d))))))

(defn- ln-run [x :vector-i64 g :vector-i64 b :vector-i64 i :i64 mean :i64 inv :i64 out :vector-i64] :vector-i64
  (if (>= i (vector-count x))
    out
    (ln-run x g b (+ i 1) mean inv
      (vector-assoc! out i
        (nn/ln-normalize (vector-at x i) mean inv (vector-at g i) (vector-at b i))))))

(defn- layer-norm [x :vector-i64 g :vector-i64 b :vector-i64] :vector-i64
  (let [n (itof (vector-count x))
        mean (fdiv (vec-sum x 0 (zero)) n)
        var (fdiv (sq-dev x 0 mean (zero)) n)
        inv (nn/inv-std var (f64-to-bits 0.00001))]
    (ln-run x g b 0 mean inv (vector-alloc (vector-count x)))))

(defn- dot-vec [r :bytes i :i64 cols :i64 x :vector-i64 acc :i64] :i64
  (if (>= i cols)
    acc
    (dot-vec r (+ i 1) cols x
      (fadd acc (fmul (bf16-fast (+ (bytes-at r (+ 5 (* 2 i))) (* 256 (bytes-at r (+ 6 (* 2 i))))))
                      (vector-at x i))))))

;; y[r] = W[r] . x + bias[r] for every row; a short read gives an empty vector
(defn- linear-run [path :string woff :i64 rows :i64 cols :i64 x :vector-i64 bias :vector-i64 r :i64 out :vector-i64] :vector-i64
  (if (>= r rows)
    out
    (let [row (typed-cap-call :fs/app-data :string :bytes
                (frame "E" path (string-concat (string-from-i64 (+ woff (* r (* cols 2))))
                                  (string-concat ":" (string-from-i64 (* cols 2))))))]
      (if (= (bytes-count row) (+ 5 (* cols 2)))
        (linear-run path woff rows cols x bias (+ r 1)
          (vector-assoc! out r (fadd (dot-vec row 0 cols x (zero)) (vector-at bias r))))
        (vector-alloc 0)))))

(defn- gelu-run [v :vector-i64 i :i64 out :vector-i64] :vector-i64
  (if (>= i (vector-count v))
    out
    (gelu-run v (+ i 1) (vector-assoc! out i (ge/gelu-erf (vector-at v i))))))

(defn- add-run [a :vector-i64 b :vector-i64 i :i64 out :vector-i64] :vector-i64
  (if (>= i (vector-count a))
    out
    (add-run a b (+ i 1) (vector-assoc! out i (fadd (vector-at a i) (vector-at b i))))))

(defn- input-run [t :i64 i :i64 n :i64 v :vector-i64] :vector-i64
  (if (>= i n)
    v
    (input-run t (+ i 1) n
      (vector-assoc! v i
        (fdiv (itof (- (mod (+ (* 3 i) (+ 1 (* 5 t))) 11) 5)) (f64-to-bits 4.0))))))

;; the whole sublayer, or an empty vector when anything cannot be read
(defn- ffn-on [path :string layer :i64 x :vector-i64] :vector-i64
  (let [h (wf/wf-header-text path)
        n (wf/wf-header-len path)
        gn (tensor-off h n (lname layer "final_layer_norm.weight"))
        bn (tensor-off h n (lname layer "final_layer_norm.bias"))
        w1 (tensor-off h n (lname layer "fc1.weight"))
        b1 (tensor-off h n (lname layer "fc1.bias"))
        w2 (tensor-off h n (lname layer "fc2.weight"))
        b2 (tensor-off h n (lname layer "fc2.bias"))]
    (if (or (< gn 0) (< bn 0) (< w1 0) (< b1 0) (< w2 0) (< b2 0)
            (not (= (st/st-dim h (lname layer "fc1.weight") 0) 3584))
            (not (= (st/st-dim h (lname layer "fc1.weight") 1) 896))
            (not (= (st/st-dim h (lname layer "fc2.weight") 0) 896))
            (not (= (st/st-dim h (lname layer "fc2.weight") 1) 3584)))
      (vector-alloc 0)
      (let [y (layer-norm x (read-vec path gn 896) (read-vec path bn 896))
            a (linear-run path w1 3584 896 y (read-vec path b1 3584) 0 (vector-alloc 3584))
            g (gelu-run a 0 (vector-alloc 3584))
            c (linear-run path w2 896 3584 g (read-vec path b2 896) 0 (vector-alloc 896))]
        (if (and (= (vector-count a) 3584) (= (vector-count c) 896))
          (add-run x c 0 (vector-alloc 896))
          (vector-alloc 0))))))

(defn- ffn [path :string layer :i64] :vector-i64
  (ffn-on path layer (input-run 0 0 896 (vector-alloc 896))))

;; output element idx as f64 bits, or -1
(defn ffn-at [path :string layer :i64 idx :i64] :i64
  (let [o (ffn path layer)]
    (if (or (< idx 0) (>= idx (vector-count o)))
      -1
      (vector-at o idx))))

;; sequential sum of the 896 outputs as f64 bits, or -1
(defn ffn-sum [path :string layer :i64] :i64
  (let [o (ffn path layer)]
    (if (= (vector-count o) 896) (vec-sum o 0 (zero)) -1)))

;; ---- the attention half ---------------------------------------------------------------------
(defn- dot-range [a :vector-i64 b :vector-i64 base :i64 i :i64 n :i64 acc :i64] :i64
  (if (>= i n)
    acc
    (dot-range a b base (+ i 1) n
      (fadd acc (fmul (vector-at a (+ base i)) (vector-at b (+ base i)))))))

;; q . k over one head of 64 times the scale 1/8
(defn- score [q :vector-i64 k :vector-i64 base :i64] :i64
  (fmul (dot-range q k base 0 64 (zero)) (f64-to-bits 0.125)))

(defn- fmax [a :i64 b :i64] :i64 (if (f64-lt (f64-from-bits a) (f64-from-bits b)) b a))

;; p0 v0[j] + p1 v1[j] + p2 v2[j]
(defn- mix [v0 :vector-i64 v1 :vector-i64 v2 :vector-i64 j :i64 p0 :i64 p1 :i64 p2 :i64] :i64
  (fadd (fadd (fmul p0 (vector-at v0 j))
              (fmul p1 (vector-at v1 j)))
        (fmul p2 (vector-at v2 j))))

(defn- ctx-fill [v0 :vector-i64 v1 :vector-i64 v2 :vector-i64 base :i64 d :i64 p0 :i64 p1 :i64 p2 :i64 out :vector-i64] :vector-i64
  (if (>= d 64)
    out
    (ctx-fill v0 v1 v2 base (+ d 1) p0 p1 p2
      (vector-assoc! out (+ base d) (mix v0 v1 v2 (+ base d) p0 p1 p2)))))

;; the context vector of token q over all 14 heads, softmax over the three keys
(defn- ctx-heads [q :vector-i64 k0 :vector-i64 k1 :vector-i64 k2 :vector-i64 v0 :vector-i64 v1 :vector-i64 v2 :vector-i64 h :i64 out :vector-i64] :vector-i64
  (if (>= h 14)
    out
    (let [base (* h 64)
          s0 (score q k0 base)
          s1 (score q k1 base)
          s2 (score q k2 base)
          m (fmax s0 (fmax s1 s2))
          e0 (nn/exp-wide (fsub s0 m))
          e1 (nn/exp-wide (fsub s1 m))
          e2 (nn/exp-wide (fsub s2 m))
          z (fadd e0 (fadd e1 e2))]
      (ctx-heads q k0 k1 k2 v0 v1 v2 (+ h 1)
        (ctx-fill v0 v1 v2 base 0 (fdiv e0 z) (fdiv e1 z) (fdiv e2 z) out)))))

(defn- project [path :string woff :i64 boff :i64 x :vector-i64] :vector-i64
  (linear-run path woff 896 896 x (read-vec path boff 896) 0 (vector-alloc 896)))

;; out vector of token t: x_t + out_proj(ctx_t)
(defn- attn-token [path :string wo :i64 bo :i64 x :vector-i64 q :vector-i64 k0 :vector-i64 k1 :vector-i64 k2 :vector-i64 v0 :vector-i64 v1 :vector-i64 v2 :vector-i64] :vector-i64
  (let [ctx (ctx-heads q k0 k1 k2 v0 v1 v2 0 (vector-alloc 896))
        o (linear-run path wo 896 896 ctx (read-vec path bo 896) 0 (vector-alloc 896))]
    (if (= (vector-count o) 896) (add-run x o 0 (vector-alloc 896)) (vector-alloc 0))))

(defn- concat-run [src :vector-i64 i :i64 at :i64 out :vector-i64] :vector-i64
  (if (>= i (vector-count src))
    out
    (concat-run src (+ i 1) at (vector-assoc! out (+ at i) (vector-at src i)))))

(defn- concat3 [a :vector-i64 b :vector-i64 c :vector-i64] :vector-i64
  (let [n (vector-count a)
        out (vector-alloc (* 3 n))]
    (concat-run c 0 (* 2 n) (concat-run b 0 n (concat-run a 0 0 out)))))

;; all three outputs concatenated (2688 elements), or an empty vector when anything cannot be read
(defn- attn [path :string layer :i64] :vector-i64
  (let [h (wf/wf-header-text path)
        n (wf/wf-header-len path)
        gn (tensor-off h n (lname layer "self_attn_layer_norm.weight"))
        bn (tensor-off h n (lname layer "self_attn_layer_norm.bias"))
        wq (tensor-off h n (lname layer "self_attn.q_proj.weight"))
        bq (tensor-off h n (lname layer "self_attn.q_proj.bias"))
        wk (tensor-off h n (lname layer "self_attn.k_proj.weight"))
        bk (tensor-off h n (lname layer "self_attn.k_proj.bias"))
        wv (tensor-off h n (lname layer "self_attn.v_proj.weight"))
        bv (tensor-off h n (lname layer "self_attn.v_proj.bias"))
        wo (tensor-off h n (lname layer "self_attn.out_proj.weight"))
        bo (tensor-off h n (lname layer "self_attn.out_proj.bias"))]
    (if (or (< gn 0) (< bn 0) (< wq 0) (< bq 0) (< wk 0) (< bk 0) (< wv 0) (< bv 0) (< wo 0) (< bo 0)
            (not (= (st/st-dim h (lname layer "self_attn.q_proj.weight") 0) 896))
            (not (= (st/st-dim h (lname layer "self_attn.q_proj.weight") 1) 896)))
      (vector-alloc 0)
      (let [g (read-vec path gn 896)
            b (read-vec path bn 896)
            x0 (input-run 0 0 896 (vector-alloc 896))
            x1 (input-run 1 0 896 (vector-alloc 896))
            x2 (input-run 2 0 896 (vector-alloc 896))
            h0 (layer-norm x0 g b)
            h1 (layer-norm x1 g b)
            h2 (layer-norm x2 g b)
            k0 (project path wk bk h0)
            k1 (project path wk bk h1)
            k2 (project path wk bk h2)
            v0 (project path wv bv h0)
            v1 (project path wv bv h1)
            v2 (project path wv bv h2)
            q0 (project path wq bq h0)
            q1 (project path wq bq h1)
            q2 (project path wq bq h2)
            o0 (attn-token path wo bo x0 q0 k0 k1 k2 v0 v1 v2)
            o1 (attn-token path wo bo x1 q1 k0 k1 k2 v0 v1 v2)
            o2 (attn-token path wo bo x2 q2 k0 k1 k2 v0 v1 v2)]
        (if (and (= (vector-count k2) 896) (= (vector-count v2) 896) (= (vector-count q2) 896)
                 (= (vector-count o0) 896) (= (vector-count o1) 896) (= (vector-count o2) 896))
          (concat3 o0 o1 o2)
          (vector-alloc 0))))))

;; output element idx (token idx / 896, dimension idx mod 896) as f64 bits, or -1
(defn attn-at [path :string layer :i64 idx :i64] :i64
  (let [o (attn path layer)]
    (if (or (< idx 0) (>= idx (vector-count o)))
      -1
      (vector-at o idx))))

;; sequential sum of the 2688 outputs as f64 bits, or -1
(defn attn-sum [path :string layer :i64] :i64
  (let [o (attn path layer)]
    (if (= (vector-count o) 2688) (vec-sum o 0 (zero)) -1)))

;; ---- the whole layer: attention half, then the feed-forward half on each token -----------------
(defn- slice-run [v :vector-i64 i :i64 end :i64 out :vector-i64] :vector-i64
  (if (>= i end)
    out
    (slice-run v (+ i 1) end (vector-assoc! out (- i (- end 896)) (vector-at v i)))))

(defn- token-of [v :vector-i64 t :i64] :vector-i64
  (slice-run v (* t 896) (* (+ t 1) 896) (vector-alloc 896)))

;; h = x + attn(LN1(x));  out = h + ffn(LN2(h)), for the three tokens; empty when anything fails
(defn- encoder-layer [path :string layer :i64] :vector-i64
  (let [a (attn path layer)]
    (if (= (vector-count a) 2688)
      (let [f0 (ffn-on path layer (token-of a 0))
            f1 (ffn-on path layer (token-of a 1))
            f2 (ffn-on path layer (token-of a 2))]
        (if (and (= (vector-count f0) 896) (= (vector-count f1) 896) (= (vector-count f2) 896))
          (concat3 f0 f1 f2)
          (vector-alloc 0)))
      (vector-alloc 0))))

;; output element idx of the layer (token idx / 896, dimension idx mod 896) as f64 bits, or -1
(defn layer-at [path :string layer-index :i64 idx :i64] :i64
  (let [o (encoder-layer path layer-index)]
    (if (or (< idx 0) (>= idx (vector-count o)))
      -1
      (vector-at o idx))))

;; sequential sum of the 2688 layer outputs as f64 bits, or -1
(defn layer-sum [path :string layer-index :i64] :i64
  (let [o (encoder-layer path layer-index)]
    (if (= (vector-count o) 2688) (vec-sum o 0 (zero)) -1)))
