;; Reading a real safetensors file natively (JUN-892): FS2 range reads through :fs/app-data.
;; The host grants one directory on fd 3; paths are relative to it ("/d/model.safetensors").
;; F returns the file's metadata (the second field is its size in bytes); E returns up to
;; 262,144 bytes at "<offset>:<count>" after a 5-byte "\0FS2\0" acknowledgement. Every
;; function here returns -1 (or "" for the header text) instead of touching the file when
;; its arguments or the file cannot satisfy the request, because an invalid E request traps
;; the whole program. The header is parsed by itonami.safetensors; one BF16 element is
;; decoded by itonami.bf16. The data area is never held in memory.
(ns itonami.weights-file
  (:require [itonami.bf16 :as bf]
            [itonami.safetensors :as st])
  (:export [wf-size wf-header-len wf-header-text wf-bf16 wf-row-dot wf-matvec-sum wf-fast-matches-exact])
  (:capabilities [:fs/app-data]))

(defn- frame [op :string path :string tail :string] :string
  (string-concat "\u0000FS2\u0000"
    (string-concat op (string-concat path (string-concat "\u0000" tail)))))

(defn- digit? [c :i64] :bool (and (>= c 48) (<= c 57)))

(defn- digits-end [s :string i :i64] :i64
  (if (and (< i (string-length s)) (digit? (string-code-point-at s i))) (digits-end s (+ i 1)) i))
(defn- digits-val [s :string i :i64 e :i64 acc :i64] :i64
  (if (>= i e) acc (digits-val s (+ i 1) e (+ (* acc 10) (- (string-code-point-at s i) 48)))))

;; the size field of an F reply ("<mode> <size> ..."), or -1 when the file is absent
(defn wf-size [path :string] :i64
  (let [r (typed-cap-call :fs/app-data :string :string (frame "F" path ""))]
    (if (< (string-length r) 6)
      -1
      (let [body (string-substring r 5 (string-length r))
            sp (string-index-of body " ")]
        (if (< sp 0)
          -1
          (let [e (digits-end body (+ sp 1))]
            (if (= e (+ sp 1)) -1 (digits-val body (+ sp 1) e 0))))))))

;; little-endian fold of n bytes of r starting at index i (after the acknowledgement)
(defn- le-fold [r :bytes i :i64 n :i64 acc :i64 scale :i64] :i64
  (if (>= i n)
    acc
    (le-fold r (+ i 1) n (+ acc (* (bytes-at r i) scale)) (* scale 256))))

;; the u64 header length at the start of the file, or -1
(defn wf-header-len [path :string] :i64
  (if (< (wf-size path) 8)
    -1
    (let [r (typed-cap-call :fs/app-data :string :bytes (frame "E" path "0:8"))]
      (if (= (bytes-count r) 13) (le-fold r 5 13 0 1) -1))))

;; the JSON header as text ("" when unreadable or larger than one E request)
(defn wf-header-text [path :string] :string
  (let [n (wf-header-len path)]
    (if (or (<= n 0) (> n 262144) (> (+ 8 n) (wf-size path)))
      ""
      (let [r (typed-cap-call :fs/app-data :string :bytes
                (frame "E" path (string-concat "8:" (string-from-i64 n))))]
        (if (= (bytes-count r) (+ 5 n))
          (string-from-utf8 (bytes-slice r 5 (+ 5 n)))
          "")))))

;; exact f64 bits of element idx of a BF16 tensor, or -1 when the file, tensor, dtype or
;; index is not usable (-1 is a NaN pattern, never the bits of a finite bfloat16)
(defn wf-bf16 [path :string name :string idx :i64] :i64
  (let [h (wf-header-text path)
        n (wf-header-len path)]
    (if (or (= (string-length h) 0) (< idx 0) (not (string=? (st/st-dtype h name) "BF16")))
      -1
      (let [b (st/st-begin h name)
            e (st/st-end h name)
            off (+ (+ 8 n) (+ b (* 2 idx)))]
        (if (or (< b 0) (< e 0) (> (+ (+ b (* 2 idx)) 2) e) (> (+ off 2) (wf-size path)))
          -1
          (let [r (typed-cap-call :fs/app-data :string :bytes
                    (frame "E" path (string-concat (string-from-i64 off) ":2")))]
            (if (= (bytes-count r) 7)
              (let [v (+ (bytes-at r 5) (* 256 (bytes-at r 6)))]
                (if (bf/bf16-finite? v) (bf/bf16-to-f64 v) -1))
              -1)))))))

;; Integer BF16 -> f64 for the hot loop: a normal bfloat16 (exponent 1..254) maps to the f64 with
;; exponent e + 896 and the 7 mantissa bits shifted to the top of the 52. Zero and subnormals
;; (exponent 0) take the exact decoder. Equal to itonami.bf16/bf16-to-f64 on every finite pattern
;; (wf-fast-matches-exact checks all 65536 patterns).
(defn- bf16-fast [v :i64] :i64
  (let [e (mod (quot v 128) 256)]
    (if (= e 0)
      (bf/bf16-to-f64 v)
      (let [pos (+ (i64-shift-left (+ e 896) 52) (i64-shift-left (mod v 128) 45))]
        (if (>= v 32768)
          (f64-to-bits (f64-neg (f64-from-bits pos)))
          pos)))))

(defn- fast-run [v :i64] :i64
  (if (>= v 65536)
    1
    (if (and (bf/bf16-finite? v) (not (= (bf16-fast v) (bf/bf16-to-f64 v))))
      0
      (fast-run (+ v 1)))))

;; 1 when the fast decoder equals the exact one for every finite bfloat16 pattern
(defn wf-fast-matches-exact [] :i64 (fast-run 0))

;; x[i] = (((i + seed) mod 7) - 3) / 8, a deterministic dyadic input vector (exact in f64)
(defn- x-at [i :i64 seed :i64] :i64
  (f64-to-bits (f64-div (i64-to-f64-rounded (- (mod (+ i seed) 7) 3)) 8.0)))

;; sum over i of w[i] * x[i], in index order, for the BF16 pairs that follow the
;; acknowledgement in r; -1 when an element is not finite
(defn- dot-run [r :bytes i :i64 c :i64 seed :i64 acc :i64] :i64
  (if (>= i c)
    acc
    (let [v (+ (bytes-at r (+ 5 (* 2 i))) (* 256 (bytes-at r (+ 6 (* 2 i)))))]
      (if (bf/bf16-finite? v)
        (dot-run r (+ i 1) c seed
          (f64-to-bits (f64-add (f64-from-bits acc)
                                (f64-mul (f64-from-bits (bf16-fast v))
                                         (f64-from-bits (x-at i seed))))))
        -1))))

;; one row: cols BF16 elements at absolute file offset off, dotted with x; -1 on a short read
(defn- row-at [path :string off :i64 cols :i64 seed :i64] :i64
  (let [r (typed-cap-call :fs/app-data :string :bytes
            (frame "E" path (string-concat (string-from-i64 off)
                              (string-concat ":" (string-from-i64 (* cols 2))))))]
    (if (= (bytes-count r) (+ 5 (* cols 2)))
      (dot-run r 0 cols seed 0)
      -1)))

;; Dot product of one row of a 2-D BF16 weight (one E request, so at most 131072 columns)
;; with the vector x above, as f64 bits; -1 when the file, tensor, shape or row is unusable.
(defn wf-row-dot [path :string name :string row :i64 seed :i64] :i64
  (let [h (wf-header-text path)
        n (wf-header-len path)]
    (if (or (= (string-length h) 0) (< row 0) (not (string=? (st/st-dtype h name) "BF16"))
            (not (= (st/st-ndim h name) 2)))
      -1
      (let [rows (st/st-dim h name 0)
            cols (st/st-dim h name 1)
            b (st/st-begin h name)
            e (st/st-end h name)
            off (+ (+ 8 n) (+ b (* row (* cols 2))))]
        (if (or (< rows 1) (< cols 1) (>= row rows) (> (* cols 2) 262144)
                (> (+ (+ b (* row (* cols 2))) (* cols 2)) e)
                (> (+ off (* cols 2)) (wf-size path)))
          -1
          (row-at path off cols seed))))))

;; sum of y[r] over rows r in index order, y = W x; each y[r] is the row dot above
(defn- rows-run [path :string base :i64 r :i64 rows :i64 cols :i64 seed :i64 acc :i64] :i64
  (if (>= r rows)
    acc
    (let [y (row-at path (+ base (* r (* cols 2))) cols seed)]
      (if (= y -1)
        -1
        (rows-run path base (+ r 1) rows cols seed
          (f64-to-bits (f64-add (f64-from-bits acc) (f64-from-bits y))))))))

;; Checksum of the whole product W x for a 2-D BF16 weight: the header is parsed once, then
;; every row is read with one E request. f64 bits of the sequential sum of all outputs, or -1.
(defn wf-matvec-sum [path :string name :string seed :i64] :i64
  (let [h (wf-header-text path)
        n (wf-header-len path)]
    (if (or (= (string-length h) 0) (not (string=? (st/st-dtype h name) "BF16"))
            (not (= (st/st-ndim h name) 2)))
      -1
      (let [rows (st/st-dim h name 0)
            cols (st/st-dim h name 1)
            b (st/st-begin h name)
            e (st/st-end h name)]
        (if (or (< rows 1) (< cols 1) (> (* cols 2) 262144)
                (not (= (- e b) (* rows (* cols 2))))
                (> (+ (+ 8 n) e) (wf-size path)))
          -1
          (rows-run path (+ (+ 8 n) b) 0 rows cols seed 0))))))
