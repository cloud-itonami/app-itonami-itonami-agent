;; q4_0 and q5_0 block dequantisation for the native whisper path (JUN-874),
;; ggml's layouts (llama.cpp ggml/src/ggml-quants.c dequantize_row_q4_0 / q5_0):
;;   block_q4_0 { half d; uint8 qs[16] }            18 bytes = 36 hex characters
;;   block_q5_0 { half d; uint8 qh[4]; uint8 qs[16] } 22 bytes = 44 hex characters
;; Output j (0..15) is the low nibble of qs[j], output j+16 the high nibble;
;; q4_0 value = (nibble - 8) * d; q5_0 takes a fifth bit from the little-endian
;; uint32 qh (bit j for the low half, bit j+16 for the high half) and its value
;; is (nibble | bit<<4) - 16) * d. Blocks arrive as hex strings of their bytes
;; in memory order. Built on itonami.ggml-dequant. Every f64 value is an i64
;; bit pattern; the products are exact (at most 16 significant bits), so they
;; equal ggml's float32 results.
(ns itonami.ggml-dequant-q
  (:require [itonami.ggml-dequant :as gd])
  (:export [q4-0-valid? q4-0-value q5-0-valid? q5-0-value match-count]))

(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))

(defn- pow2 [k :i64] :i64 (if (<= k 0) 1 (* 2 (pow2 (- k 1)))))

;; every byte of the first n bytes is readable hex
(defn- bytes-ok? [s :string i :i64 n :i64] :bool
  (cond (>= i n) true
        (< (gd/byte-at s i) 0) false
        :else (bytes-ok? s (+ i 1) n)))

(defn- valid? [block :string len :i64] :bool
  (and (= (string-length block) len)
       (bytes-ok? block 0 (quot len 2))
       (gd/half-finite? (gd/half-bits block 0))))

(defn q4-0-valid? [block :string] :bool (valid? block 36))
(defn q5-0-valid? [block :string] :bool (valid? block 44))

(defn- scale [block :string] :i64 (gd/half-to-f64 (gd/half-bits block 0)))

;; element i (0..31) of a valid q4_0 block
(defn q4-0-value [block :string i :i64] :i64
  (let [b (gd/byte-at block (+ 2 (mod i 16)))
        nib (if (< i 16) (mod b 16) (quot b 16))]
    (fmul (scale block) (itof (- nib 8)))))

;; qh: bytes 2..5, little-endian uint32
(defn- qh [block :string] :i64
  (+ (gd/byte-at block 2)
  (+ (* 256 (gd/byte-at block 3))
  (+ (* 65536 (gd/byte-at block 4))
     (* 16777216 (gd/byte-at block 5))))))

;; element i (0..31) of a valid q5_0 block
(defn q5-0-value [block :string i :i64] :i64
  (let [j (mod i 16)
        b (gd/byte-at block (+ 6 j))
        bit (mod (quot (qh block) (pow2 (if (< i 16) j (+ j 16)))) 2)
        nib (if (< i 16) (mod b 16) (quot b 16))]
    (fmul (scale block) (itof (- (+ nib (* 16 bit)) 16)))))

;; ---- gate fixtures (expected values from ggml's own dequantize_row_*) -----------
(defn- b4 [n :i64] :string
  (cond
        (= n 0) "662e0724415e7b98b5d2ef0c294663809dba"
        (= n 1) "00340714212e3b4855626f7c8996a3b0bdca"
        (= n 2) "00c40702fdf8f3eee9e4dfdad5d0cbc6c1bc"
        :else ""))

(defn- b5 [n :i64] :string
  (cond
        (= n 0) "662ea55a3cc303386da2d70c4176abe0154a7fb4e91e"
        (= n 1) "0034ffffffff031425364758697a8b9cadbecfe0f102"
        (= n 2) "00c400000000035eb9146fca2580db3691ec47a2fd58"
        :else ""))

