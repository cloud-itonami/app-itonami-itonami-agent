(defn- q4-run [i :i64 acc :i64] :i64
  (if (>= i 96)
    acc
    (q4-run (+ i 1) (if (= (q4-0-value (b4 (quot i 32)) (mod i 32)) (w4 i)) (+ acc 1) acc))))
(defn- q5-run [i :i64 acc :i64] :i64
  (if (>= i 96)
    acc
    (q5-run (+ i 1) (if (= (q5-0-value (b5 (quot i 32)) (mod i 32)) (w5 i)) (+ acc 1) acc))))

(defn- b2i [x :bool] :i64 (if x 1 0))

;; 96 q4_0 + 96 q5_0 values, 6 valid blocks and 6 refusals (short, non-hex, non-finite
;; scale for each kind) = 204
(defn match-count [] :i64
  (+ (q4-run 0 0)
    (+ (q5-run 0 0)
    (+ (b2i (q4-0-valid? (b4 0)))
    (+ (b2i (q4-0-valid? (b4 1)))
    (+ (b2i (q4-0-valid? (b4 2)))
    (+ (b2i (q5-0-valid? (b5 0)))
    (+ (b2i (q5-0-valid? (b5 1)))
    (+ (b2i (q5-0-valid? (b5 2)))
    (+ (b2i (not (q4-0-valid? "662e")))
    (+ (b2i (not (q4-0-valid? (string-concat "zz" (string-substring (b4 0) 2 36)))))
    (+ (b2i (not (q4-0-valid? (string-concat "007c" (string-substring (b4 0) 4 36)))))
    (+ (b2i (not (q5-0-valid? "662e")))
    (+ (b2i (not (q5-0-valid? (string-concat (string-substring (b5 0) 0 30) (string-concat "g0" (string-substring (b5 0) 32 44))))))
    (b2i (not (q5-0-valid? (string-concat "007c" (string-substring (b5 0) 4 44)))))))))))))))))))
