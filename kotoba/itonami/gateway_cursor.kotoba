;; Native local cron plan/cursor boundary. Host must serialize writers and
;; call advance only after independently verified GitHub archive readback.
;; Composition: existing gateway_job_node and git_checkpoint sources.
(ns itonami.gateway-cursor (:export [cron-cursor-main]))

(defn- cc-cursor-problem [cursor :vector-i64 pin :string now :i64] :string
  (cond (or (> (vector-count cursor) 1024) (not (json-valid? cursor))
            (not (json-canonical? cursor)) (not (= (json-kind cursor 0) 1))
            (not (= (json-count cursor 0) 3))) "cursor/schema"
        (or (not (= (cp-str cursor 0 "kind") "itonami.cron-cursor/1"))
            (not (= (cp-str cursor 0 "schedule") pin))
            (not (gt-integer? cursor "slot"))) "cursor/binding"
        (or (< (cp-num cursor 0 "slot") 0) (> (cp-num cursor 0 "slot") now)
            (> now 4102444800000)) "cursor/time"
        :else "cursor/ok"))

(defn- cc-plan-problem [definition :vector-i64 pin :string cursor :vector-i64 now :i64] :string
  (let [c (cc-cursor-problem cursor pin now)]
    (cond (not (= c "cursor/ok")) c
          (or (> (vector-count definition) 8192) (not (json-valid? definition))
              (not (json-canonical? definition)) (not (= (json-kind definition 0) 1))
              (not (= (json-count definition 0) 8))
              (not (= (cp-cid definition) pin))) "cursor/definition"
          (or (not (gt-integer? definition "offsetMinutes"))
              (< (gt-num definition "offsetMinutes") -840) (> (gt-num definition "offsetMinutes") 840)
              (not (= (gt-str definition "kind") "itonami.cron-schedule/1"))
              (= (gt-str definition "id") "") (not (= (field-problem (gt-str definition "id")) "enroll/ok"))
              (not (= (job-problem (gt-str definition "profile") (gt-str definition "input")
                                   (gt-str definition "policy") (gt-str definition "rail")) "job/ok"))
              (not (= (cron-problem (gt-str definition "cron")) "schedule/ok"))) "cursor/definition"
          :else
          (let [previous (cp-num cursor 0 "slot")
                next (next-cron-ms (gt-str definition "cron") previous (gt-num definition "offsetMinutes"))]
            (cond (< next 0) "cursor/no-next"
                  (> next now) "cursor/idle"
                  :else (verified-cron-problem true now previous next pin definition))))))

(defn- cc-plan [definition :vector-i64 pin :string cursor :vector-i64 now :i64] :string
  (let [problem (cc-plan-problem definition pin cursor now)]
    (if (not (= problem "trigger/ok")) problem
      (let [previous (cp-num cursor 0 "slot") slot (next-cron-ms (gt-str definition "cron") previous (gt-num definition "offsetMinutes"))]
        (str "cursor/plan " previous " " slot " " (verified-cron-job-id true now previous slot pin definition)
             " " (verified-cron-input-cid true now previous slot pin definition)
             " " (gt-str definition "profile") " " (gt-str definition "policy") "\n"
             (verified-cron-input true now previous slot pin definition))))))

(defn- cc-cursor [pin :string slot :i64] :vector-i64
  (cp-bytes (str "{\"kind\":\"itonami.cron-cursor/1\",\"schedule\":\"" pin "\",\"slot\":" slot "}")))

;; Atomic file replacement is not a multi-host CAS. A lost fsync/rename
;; acknowledgement is UNKNOWN; caller re-reads before any new dispatch.
(defn- cc-advance [path :string original :vector-i64 pin :string slot :i64] :string
  (let [tmp (str path ".pending")]
    (cond (not (= (cp-fs "D" tmp "") "0")) "cursor/pending-unknown"
          (not (cp-write tmp (cc-cursor pin slot))) "cursor/write-unknown"
          (not (= (cp-cid (cp-read path)) (cp-cid original))) "cursor/changed"
          (not (= (cp-fs "L" tmp path) "1")) "cursor/rename-unknown"
          (not (= (cp-fs "M" (cp-parent-dir path) "") "1")) "cursor/fsync-unknown"
          :else "cursor/advanced")))

(defn cron-cursor-main [] :i64
  (let [mode (jn-arg 0) definition-path (jn-arg 1) pin (jn-arg 2) path (jn-arg 3)]
    (cond (= mode "advance") (cron-cursor-advance-main)
          (or (not (jn-attempt-root? definition-path)) (not (jn-attempt-root? path))
              (= definition-path path) (not (cp-exists? definition-path)) (not (cp-exists? path)))
          (let [x (jn-say "cursor/input-unavailable")] 2)
          (or (not (= mode "plan")) (not (= (jn-arg 4) "clock")))
          (let [x (jn-say "cursor/command-refused")] 2)
          (not (= (cp-fs "D" (str path ".pending") "") "0"))
          (let [x (jn-say "cursor/pending-unknown")] 1)
          :else (let [result (cc-plan (cp-read definition-path) pin (cp-read path) (ln-now "clock"))]
                  (let [x (jn-say result)]
                    (if (or (= result "cursor/idle") (= (string-index-of result "cursor/plan ") 0)) 0 1))))))

;; Separate entry point: its caller, not the cursor file or model, is trusted
;; to have archived and read back the pinned job before calling this.
(defn- cron-cursor-advance-main [] :i64
  (let [definition-path (jn-arg 1) pin (jn-arg 2) path (jn-arg 3)
        previous (jn-int (jn-arg 4)) slot (jn-int (jn-arg 5))]
    (if (or (not (= (jn-arg 0) "advance")) (not (jn-attempt-root? definition-path))
            (not (jn-attempt-root? path)) (= definition-path path)
            (not (cp-exists? definition-path)) (not (cp-exists? path)))
      (let [x (jn-say "cursor/input-unavailable")] 2)
      (let [definition (cp-read definition-path) cursor (cp-read path) now (ln-now "clock")
            plan (cc-plan-problem definition pin cursor now)
            next (if (= plan "trigger/ok") (next-cron-ms (gt-str definition "cron") previous (gt-num definition "offsetMinutes")) -1)]
        (if (or (not (= plan "trigger/ok")) (not (= (cp-num cursor 0 "slot") previous)) (not (= next slot)))
          (let [x (jn-say "cursor/advance-refused")] 1)
          (let [result (cc-advance path cursor pin slot) x (jn-say result)]
            (if (= result "cursor/advanced") 0 1)))))))
