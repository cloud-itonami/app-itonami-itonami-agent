        (= i 17) 4591870180066957724
        (= i 18) 4612361558371493479
        (= i 19) -4611686018427387906
        (= i 20) -4613037098315599053
        (= i 21) -4617540697942969549
        (= i 22) -4859383997932765184
        (= i 23) -4620693217682128896
        (= i 24) -4612586738352862003
        (= i 25) 4611911198408756429
        (= i 26) 4612361558371493479
        (= i 27) -4609434218613702656
        (= i 28) -4613037098315599053
        (= i 29) 4602678819172646912
        (= i 30) 4609659398595071181
        (= i 31) 4604480259023595110
        (= i 32) -4611123068473966591
        (= i 33) 4605831338911806256
        (= i 34) 4610560118520545280
        (= i 35) -4614838538166547250
        (= i 36) 4608083138725491507
        (= i 37) -4615964438073389876
        (= i 38) 4612811918334230527
        (= i 39) 4603129179135383960
        (= i 40) -4614388178203810200
        (= i 41) 4605831338911806258
        (= i 42) 4604480259023595111
        (= i 43) 4612361558371493479
        (= i 44) -4626998257160447592
