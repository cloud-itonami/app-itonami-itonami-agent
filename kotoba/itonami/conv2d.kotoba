;; conv2d for the native Qwen3-ASR audio tower (JUN-880): kernel 3x3, padding 1, stride
;; 1 or 2, several input and output channels, with bias. The tower starts with three
;; of these (conv2d1 [480,1,3,3], conv2d2/3 [480,480,3,3], 8x reduction overall).
;; Pure integer index rules (out-len, tap position or -1 in the padding) plus a
;; scalar convolution checked on an analytic fixture (2 in / 2 out channels, 5 x 6
;; input); the seed has no vectors, so a host or later unit drives it over real
;; tensors. Every f64 value is an i64 bit pattern.
(ns itonami.conv2d
  (:export [conv2d-out-len conv2d-tap match-count]))

(defn- fadd [a :i64 b :i64] :i64 (f64-to-bits (f64-add (f64-from-bits a) (f64-from-bits b))))
(defn- fsub [a :i64 b :i64] :i64 (f64-to-bits (f64-sub (f64-from-bits a) (f64-from-bits b))))
(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- fdiv [a :i64 b :i64] :i64 (f64-to-bits (f64-div (f64-from-bits a) (f64-from-bits b))))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))
(defn- zero [] :i64 (f64-to-bits 0.0))

;; output length along one axis for kernel 3, padding 1
(defn conv2d-out-len [n :i64 stride :i64] :i64
  (+ (quot (- (+ n 2) 3) stride) 1))

;; input position read by tap k of output o along one axis, or -1 in the padding
(defn conv2d-tap [o :i64 stride :i64 k :i64 n :i64] :i64
  (let [p (- (+ (* o stride) k) 1)]
    (if (or (< p 0) (>= p n)) -1 p)))

;; ---- gate fixture: C_in 2, C_out 2, H 5, W 6 ---------------------------------------
(defn- fx [c :i64 y :i64 x :i64] :i64
  (fdiv (itof (- (mod (+ (+ (* c 7) (* y 5)) (* x 3)) 11) 5)) (f64-to-bits 4.0)))
(defn- fw [o :i64 c :i64 ky :i64 kx :i64] :i64
  (fdiv (itof (- (mod (+ (+ (+ (* o 5) (* c 3)) (* ky 2)) (* kx 7)) 9) 4)) (f64-to-bits 5.0)))
(defn- fb [o :i64] :i64
  (fsub (fmul (itof o) (f64-to-bits 0.5)) (f64-to-bits 0.25)))

;; sum over input channels c and kernel taps (ky, kx), in the reference's order
(defn- tap-run [o :i64 oy :i64 ox :i64 stride :i64 c :i64 ky :i64 kx :i64 acc :i64] :i64
  (cond (>= c 2) acc
        (>= ky 3) (tap-run o oy ox stride (+ c 1) 0 0 acc)
        (>= kx 3) (tap-run o oy ox stride c (+ ky 1) 0 acc)
        :else
        (let [py (conv2d-tap oy stride ky 5)
              px (conv2d-tap ox stride kx 6)]
          (tap-run o oy ox stride c ky (+ kx 1)
                   (if (or (< py 0) (< px 0))
                     acc
                     (fadd acc (fmul (fw o c ky kx) (fx c py px))))))))

(defn- conv-at [o :i64 oy :i64 ox :i64 stride :i64] :i64
  (fadd (tap-run o oy ox stride 0 0 0 (zero)) (fb o)))

(defn- want-s1 [i :i64] :i64
  (cond
        (= i 0) -4615514078110652825
        (= i 1) 4607407598781385931
        (= i 2) 4608758678669597082
        (= i 3) -4613262278296967580
        (= i 4) 4599075939470750514
        (= i 5) -4631501856787818096
        (= i 6) 4599976659396224616
        (= i 7) -4612136378390124954
        (= i 8) 4587366580439587184
        (= i 9) 4611686018427387904
        (= i 10) -4613712638259704628
        (= i 11) 4604480259023595110
        (= i 12) -4611123068473966593
