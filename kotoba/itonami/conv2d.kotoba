        (= i 49) -4613937818241073152
        (= i 50) 4613037098315599053
        (= i 51) 4612361558371493479
        (= i 52) -4626998257160447592
        (= i 53) -4620242857719391848
        (= i 54) 4596373779694328220
        (= i 55) -4614838538166547252
        (= i 56) -4611348248455335116
        (= i 57) 4608983858650965606
        (= i 58) 4610109758557808230
        (= i 59) 4601778099247172812
        :else (zero)))

(defn- want-s2 [i :i64] :i64
  (cond
        (= i 0) -4615514078110652825
        (= i 1) 4608758678669597082
        (= i 2) 4599075939470750514
        (= i 3) -4611123068473966593
        (= i 4) -4859383997932765184
        (= i 5) 4587366580439587184
        (= i 6) -4612586738352862003
        (= i 7) 4612361558371493479
        (= i 8) -4613037098315599053
        (= i 9) 4609659398595071181
        (= i 10) -4611123068473966591
        (= i 11) 4610560118520545280
        (= i 12) 4604480259023595111
        (= i 13) -4626998257160447592
        (= i 14) 4612811918334230527
        (= i 15) 4596373779694328220
        (= i 16) -4611348248455335116
        (= i 17) 4610109758557808230
        :else (zero)))

(defn- close? [a :i64 b :i64] :bool
  (f64-le (f64-abs (f64-sub (f64-from-bits a) (f64-from-bits b)))
          (f64-mul 0.000000001 (f64-max 1.0 (f64-abs (f64-from-bits b))))))

;; stride 1: output 5 x 6 per channel; stride 2: 3 x 3 per channel
(defn- s1-run [i :i64 acc :i64] :i64
  (if (>= i 60)
    acc
    (s1-run (+ i 1)
            (if (close? (conv-at (quot i 30) (quot (mod i 30) 6) (mod i 6) 1) (want-s1 i)) (+ acc 1) acc))))
(defn- s2-run [i :i64 acc :i64] :i64
  (if (>= i 18)
    acc
    (s2-run (+ i 1)
            (if (close? (conv-at (quot i 9) (quot (mod i 9) 3) (mod i 3) 2) (want-s2 i)) (+ acc 1) acc))))

(defn- b2i [x :bool] :i64 (if x 1 0))

;; 60 stride-1 + 18 stride-2 outputs + 6 length checks (Qwen's real axes: 128 -> 64 -> 32
;; -> 16 over three stride-2 layers) + 4 tap checks = 88
(defn match-count [] :i64
  (+ (s1-run 0 0)
    (+ (s2-run 0 0)
    (+ (b2i (= (conv2d-out-len 5 1) 5))
    (+ (b2i (= (conv2d-out-len 6 2) 3))
    (+ (b2i (= (conv2d-out-len 128 2) 64))
    (+ (b2i (= (conv2d-out-len 64 2) 32))
    (+ (b2i (= (conv2d-out-len 32 2) 16))
    (+ (b2i (= (conv2d-out-len 100 2) 50))
    (+ (b2i (= (conv2d-tap 0 1 0 6) -1))
    (+ (b2i (= (conv2d-tap 0 2 1 6) 0))
    (+ (b2i (= (conv2d-tap 2 2 2 5) -1))
    (b2i (= (conv2d-tap 2 2 1 6) 4))))))))))))))
