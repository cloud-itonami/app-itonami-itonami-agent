;; ggml weight decoding for the native whisper path (JUN-874): IEEE binary16
;; to f64 and the q8_0 block dequantise. A tensor element or block arrives as a
;; hex string of its bytes in memory order (little-endian halves), the same
;; string route the frame input uses, since the seed cannot read bytes.
;;   f16:    2 bytes -> f64, exact (subnormals included); inf / nan refused
;;   q8_0:   block_q8_0 { half d; int8 qs[32] }, 34 bytes = 68 hex characters;
;;           value_i = d * qs[i]
;; Every f64 value is an i64 bit pattern. q5_0 and q4_x blocks are not done.
(ns itonami.ggml-dequant
  (:export [byte-at half-bits half-finite? half-to-f64 q8-0-valid? q8-0-value
            match-count]))

(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- fdiv [a :i64 b :i64] :i64 (f64-to-bits (f64-div (f64-from-bits a) (f64-from-bits b))))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))
(defn- neg [a :i64] :i64 (f64-to-bits (f64-neg (f64-from-bits a))))

(defn- hex-digit [c :i64] :i64
  (cond (and (>= c 48) (<= c 57)) (- c 48)
        (and (>= c 97) (<= c 102)) (- c 87)
        (and (>= c 65) (<= c 70)) (- c 55)
        :else -1))

;; byte i (0-based) of a hex string, or -1 when out of range or not hex
(defn byte-at [s :string i :i64] :i64
  (let [o (* 2 i)]
    (if (or (< i 0) (> (+ o 2) (string-length s)))
      -1
      (let [hi (hex-digit (string-code-point-at s o))
            lo (hex-digit (string-code-point-at s (+ o 1)))]
        (if (or (< hi 0) (< lo 0)) -1 (+ (* 16 hi) lo))))))

;; the half stored at byte offset i (little-endian), or -1 when unreadable
(defn half-bits [s :string i :i64] :i64
  (let [lo (byte-at s i)
        hi (byte-at s (+ i 1))]
    (if (or (< lo 0) (< hi 0)) -1 (+ lo (* 256 hi)))))

(defn- half-exp [h :i64] :i64 (mod (quot h 1024) 32))

;; false for inf / nan (exponent 31) and for an unreadable half (-1)
(defn half-finite? [h :i64] :bool
  (and (>= h 0) (< (half-exp h) 31)))

;; v * 2^k by repeated doubling / halving
(defn- scale2 [v :i64 k :i64] :i64
  (cond (= k 0) v
        (> k 0) (scale2 (fmul v (f64-to-bits 2.0)) (- k 1))
        :else (scale2 (fdiv v (f64-to-bits 2.0)) (+ k 1))))

;; exact value of a finite half: normal (1024+m) * 2^(e-25), subnormal m * 2^-24
(defn half-to-f64 [h :i64] :i64
  (let [e (half-exp h)
        m (mod h 1024)
        mag (if (= e 0)
              (scale2 (itof m) -24)
              (scale2 (itof (+ 1024 m)) (- e 25)))]
    (if (>= h 32768) (neg mag) mag)))

;; every character of s[i,n) is a hex digit
(defn- all-hex? [s :string i :i64 n :i64] :bool
  (cond (>= i n) true
        (< (hex-digit (string-code-point-at s i)) 0) false
        :else (all-hex? s (+ i 1) n)))

;; exactly 68 hex characters whose scale half is finite
(defn q8-0-valid? [block :string] :bool
  (and (= (string-length block) 68)
       (all-hex? block 0 68)
       (half-finite? (half-bits block 0))))

(defn- int8-at [block :string i :i64] :i64
  (let [b (byte-at block (+ 2 i))]
    (if (>= b 128) (- b 256) b)))

;; dequantised element i (0..31) of a valid block
(defn q8-0-value [block :string i :i64] :i64
  (fmul (half-to-f64 (half-bits block 0)) (itof (int8-at block i))))

;; ---- gate fixtures --------------------------------------------------------------
(defn- f16-in [i :i64] :i64
  (cond
        (= i 0) 0
        (= i 1) 32768
        (= i 2) 15360
        (= i 3) 49408
        (= i 4) 31743
        (= i 5) 1
        (= i 6) 1024
        (= i 7) 13653
        (= i 8) 1023
        (= i 9) 64511
        :else 0))
(defn- f16-want [i :i64] :i64
  (cond
        (= i 0) 0
        (= i 1) -9223372036854775808
        (= i 2) 4607182418800017408
        (= i 3) -4610560118520545280
        (= i 4) 4679235614791434240
        (= i 5) 4499096027743125504
        (= i 6) 4544132024016830464
        (= i 7) 4599674953405562880
        (= i 8) 4544123227923808256
        (= i 9) -4544136422063341568
        :else 0))
(defn- nonfinite [i :i64] :i64
  (cond
        (= i 0) 31744
        (= i 1) 64512
        (= i 2) 32256
        :else 0))
(defn- q-want [i :i64] :i64
  (cond
        (= i 0) -4600597512380743680
        (= i 1) -4602681018195902464
        (= i 2) -4606845830802964480
        (= i 3) -4619793817170608128
        (= i 4) 4614161293979418624
        (= i 5) 4619340268624150528
        (= i 6) 4622099149456670720
        (= i 7) -4600766356135084032
        (= i 8) -4603018705704583168
        (= i 9) -4607184617823272960
        (= i 10) -4624297416797978624
        (= i 11) 4614836668996780032
        (= i 12) 4619677956132831232
        (= i 13) 4622267993211011072
        (= i 14) -4600935199889424384
        (= i 15) -4603356393213263872
        (= i 16) -4607859992840634368
        (= i 17) 0
        (= i 18) 4615512044014141440
        (= i 19) 4620015643641511936
        (= i 20) 4622436836965351424
        (= i 21) -4601104043643764736
        (= i 22) -4603694080721944576
        (= i 23) -4608535367857995776
        (= i 24) 4599074620056797184
        (= i 25) 4616187419031502848
        (= i 26) 4620353331150192640
        (= i 27) 4622605680719691776
        (= i 28) -4601272887398105088
        (= i 29) -4604031768230625280
        (= i 30) -4609210742875357184
        (= i 31) 4603578219684167680
        :else 0))

(defn- block [] :string
  "662e8bb0d5fa1f44698eb3d8fd22476c91b6db00254a6f94b9de03284d7297bce106")

(defn- f16-run [i :i64 acc :i64] :i64
  (if (>= i 10)
    acc
    (f16-run (+ i 1) (if (= (half-to-f64 (f16-in i)) (f16-want i)) (+ acc 1) acc))))
(defn- nonfinite-run [i :i64 acc :i64] :i64
  (if (>= i 3)
    acc
    (nonfinite-run (+ i 1) (if (half-finite? (nonfinite i)) acc (+ acc 1)))))
(defn- q-run [i :i64 acc :i64] :i64
  (if (>= i 32)
    acc
    (q-run (+ i 1) (if (= (q8-0-value (block) i) (q-want i)) (+ acc 1) acc))))

;; 10 f16 values + 3 refused non-finite + 1 max finite accepted + 32 block
;; values + 4 block validity checks = 50
(defn match-count [] :i64
  (+ (f16-run 0 0)
  (+ (nonfinite-run 0 0)
  (+ (if (half-finite? 31743) 1 0)
  (+ (q-run 0 0)
  (+ (if (q8-0-valid? (block)) 1 0)
  (+ (if (q8-0-valid? "662e") 0 1)
  (+ (if (q8-0-valid? (string-concat "zz" (string-substring (block) 2 68))) 0 1)
     (if (q8-0-valid? (string-concat (string-substring (block) 0 40) (string-concat "g0" (string-substring (block) 42 68)))) 0 1)))))))))
