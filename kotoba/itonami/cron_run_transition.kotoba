;; Pure state decisions from src/itonami/agent/cron.cljk/record-run-state!.
;; Exported decisions use only the native i64/bool ABI. kind: 0=once, 1=cron,
;; 2=interval, 3=other. Status: 0=ok, 1=delivery_failed, 2=error.
;; Action: 0=keep, 1=error, 2=completed.
(ns itonami.cron-run-transition
  (:export [cron-run-terminal? cron-run-next-error? cron-run-status
            cron-run-state-action cron-run-failure-streak]))

(defn cron-run-terminal? [kind :i64 repeat-times :i64 completed-next :i64
                          has-next :bool] :bool
  (or (and (> repeat-times 0) (>= completed-next repeat-times))
      (and (= kind 0) (not has-next))))

(defn cron-run-next-error? [kind :i64 has-next :bool] :bool
  (and (or (= kind 1) (= kind 2)) (not has-next)))

(defn cron-run-status [failed :bool delivery-error :bool] :i64
  (if failed 2 (if delivery-error 1 0)))

(defn cron-run-state-action [terminal :bool next-error :bool] :i64
  (if terminal 2 (if next-error 1 0)))

(defn cron-run-failure-streak [failed :bool failure-streak :i64] :i64
  (if failed (+ failure-streak 1) 0))
