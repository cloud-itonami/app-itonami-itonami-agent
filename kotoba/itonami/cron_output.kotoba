;; Pure output-record formatting from src/itonami/agent/cron.cljk.
;; The host supplies display-ready run time/schedule. This module performs no
;; file or clock I/O.
(ns itonami.cron-output
  (:export [cron-output-doc-form]))

(defn- output-space? [c :i64] :bool
  (cond (= c 9) true (= c 10) true (= c 11) true (= c 12) true (= c 13) true
        (= c 32) true (= c 160) true (= c 5760) true
        (and (>= c 8192) (<= c 8202)) true
        (= c 8232) true (= c 8233) true (= c 8239) true
        (= c 8287) true (= c 12288) true (= c 65279) true
        :else false))

(defn- output-space-width [c :i64] :i64
  (cond (< c 128) 1 (< c 2048) 2 (< c 65536) 3 :else 4))

(defn- output-blank-run [s :string i :i64 end :i64] :bool
  (if (>= i end) true
    (let [c (string-code-point-at s i)]
      (if (output-space? c)
        (recur s (+ i (output-space-width c)) end)
        false))))

(defn- output-blank? [s :string] :bool
  (output-blank-run s 0 (string-byte-length s)))

(defn cron-output-doc-form [name :string job-id :string run-time :string
                            schedule :string status-line :string prompt :string
                            response :string failed :bool] :string
  (string-concat
    "# Cron Job: "
    (string-concat name
      (string-concat
        (if failed " (FAILED)" "")
        (string-concat
          "\n\n**Job ID:** "
          (string-concat job-id
            (string-concat
              "\n**Run Time:** "
              (string-concat run-time
                (string-concat
                  "\n**Schedule:** "
                  (string-concat schedule
                    (string-concat
                      "\n"
                      (string-concat
                        (if (output-blank? status-line) ""
                          (string-concat status-line "\n"))
                        (string-concat
                          "**Engine:** itonami-agent\n\n## Prompt\n\n"
                          (string-concat prompt
                            (string-concat
                              "\n\n## Response\n\n"
                              (string-concat
                                (if (output-blank? response) "(No response generated)" response)
                                "\n"))))))))))))))))
