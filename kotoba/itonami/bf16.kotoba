;; bf16 weight decoding for the native Qwen3-ASR / Qwen3-TTS path (JUN-879).
;; bfloat16 is the high 16 bits of an IEEE binary32 (1 sign, 8 exponent with bias
;; 127, 7 mantissa bits), so the widening to f64 is exact: normal values are
;; (128 + m) * 2^(e - 134), subnormals m * 2^-133, exponent 255 (inf / nan) is
;; refused. An element arrives as 2 little-endian bytes in a hex string, the same
;; string route as the other weight formats; the 16-bit reader is
;; itonami.ggml-dequant's. Every f64 value is an i64 bit pattern.
(ns itonami.bf16
  (:require [itonami.ggml-dequant :as gd])
  (:export [bf16-bits bf16-finite? bf16-to-f64 match-count]))

(defn- fmul [a :i64 b :i64] :i64 (f64-to-bits (f64-mul (f64-from-bits a) (f64-from-bits b))))
(defn- fdiv [a :i64 b :i64] :i64 (f64-to-bits (f64-div (f64-from-bits a) (f64-from-bits b))))
(defn- itof [i :i64] :i64 (f64-to-bits (i64-to-f64-rounded i)))
(defn- neg [a :i64] :i64 (f64-to-bits (f64-neg (f64-from-bits a))))

;; the bfloat16 stored at byte offset i of a hex string (little-endian), or -1
(defn bf16-bits [s :string i :i64] :i64 (gd/half-bits s i))

(defn- bf16-exp [h :i64] :i64 (mod (quot h 128) 256))

;; false for inf / nan (exponent 255) and for an unreadable element (-1)
(defn bf16-finite? [h :i64] :bool
  (and (>= h 0) (< (bf16-exp h) 255)))

;; v * 2^k by repeated doubling / halving
(defn- scale2 [v :i64 k :i64] :i64
  (cond (= k 0) v
        (> k 0) (scale2 (fmul v (f64-to-bits 2.0)) (- k 1))
        :else (scale2 (fdiv v (f64-to-bits 2.0)) (+ k 1))))

;; exact value of a finite bfloat16
(defn bf16-to-f64 [h :i64] :i64
  (let [e (bf16-exp h)
        m (mod h 128)
        mag (if (= e 0)
              (scale2 (itof m) -133)
              (scale2 (itof (+ 128 m)) (- e 134)))]
    (if (>= h 32768) (neg mag) mag)))

;; ---- gate fixtures --------------------------------------------------------------
(defn- special [i :i64] :i64
  (cond
        (= i 0) 0
        (= i 1) 32768
        (= i 2) 16256
        (= i 3) 49024
        (= i 4) 32639
        (= i 5) 1
        (= i 6) 128
        (= i 7) 255
        (= i 8) 16457
        (= i 9) 65407
        :else 0))
(defn- special-want [i :i64] :i64
  (cond
        (= i 0) 0
        (= i 1) -9223372036854775808
        (= i 2) 4607182418800017408
        (= i 3) -4616189618054758400
        (= i 4) 5183607986731352064
        (= i 5) 4008203668359741440
        (= i 6) 4039728865751334912
        (= i 7) 4044197281006616576
        (= i 8) 4614254477589872640
        (= i 9) -4039764050123423744
        :else 0))
(defn- nonfinite [i :i64] :i64
  (cond
        (= i 0) 32640
        (= i 1) 65408
        (= i 2) 32704
        :else 0))
