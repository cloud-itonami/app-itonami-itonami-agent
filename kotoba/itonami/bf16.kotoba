(defn- special-run [i :i64 acc :i64] :i64
  (if (>= i 10)
    acc
    (special-run (+ i 1) (if (= (bf16-to-f64 (special i)) (special-want i)) (+ acc 1) acc))))
(defn- nonfinite-run [i :i64 acc :i64] :i64
  (if (>= i 3)
    acc
    (nonfinite-run (+ i 1) (if (bf16-finite? (nonfinite i)) acc (+ acc 1)))))
(defn- real-run [i :i64 acc :i64] :i64
  (if (>= i 64)
    acc
    (real-run (+ i 1)
              (if (= (bf16-to-f64 (bf16-bits (real) (* 2 i))) (real-want i)) (+ acc 1) acc))))

;; 10 special values + 3 refused non-finite + 1 accepted max finite + 64 real weights
;; + 1 unreadable element refused = 79
(defn match-count [] :i64
  (+ (special-run 0 0)
  (+ (nonfinite-run 0 0)
  (+ (if (bf16-finite? 32639) 1 0)
  (+ (real-run 0 0)
     (if (bf16-finite? (bf16-bits "00" 0)) 0 1))))))
