(ns itonami.delivery-policy
  "Pure Kotoba port of itonami.agent.delivery/classify-outcome. `facts` is
  seven ASCII 0/1 flags in this order: delivery-error, should-deliver,
  delivery-queued, notification-suppressed, unresolved-origin, incident-acked,
  success. The caller supplies resolved facts explicitly, so this policy has
  no promise, map, adapter-registry, or host dependency. Branch order is part
  of the contract. The bot-chat parser encodes nil as `none` and a string
  result as `value:<name>` (empty for the current profile)."
  (:export [classify-outcome parse-bot-chat-token]))

(defn- flag? [facts :string i :i64] :bool
  (and (> (string-length facts) i)
       (= 49 (string-code-point-at facts i))))

(defn classify-outcome [facts :string normalized-deliver :string] :string
  (cond (flag? facts 0) "failed"
        (and (flag? facts 1) (flag? facts 2)) "queued"
        (flag? facts 3) "suppressed"
        (and (flag? facts 1) (flag? facts 4)) "not_configured"
        (and (flag? facts 1) (not (string=? "local" normalized-deliver))) "delivered"
        (and (flag? facts 5) (not (flag? facts 6))) "suppressed_acked"
        :else "suppressed"))

(defn- js-trim-ws? [c :i64] :bool
  (cond (= c 9) true
        (= c 10) true
        (= c 11) true
        (= c 12) true
        (= c 13) true
        (= c 32) true
        (= c 160) true
        (= c 5760) true
        (and (>= c 8192) (<= c 8202)) true
        (= c 8232) true
        (= c 8233) true
        (= c 8239) true
        (= c 8287) true
        (= c 12288) true
        (= c 65279) true
        :else false))

(defn- utf8-width [c :i64] :i64
  (cond (< c 128) 1
        (< c 2048) 2
        (< c 65536) 3
        :else 4))

(defn- trim-run [s :string i :i64 n :i64 start :i64 end :i64 started :bool] :string
  (if (>= i n)
    (string-substring s start end)
    (let [c (string-code-point-at s i)
          next (+ i (utf8-width c))]
      (if (js-trim-ws? c)
        (trim-run s next n (if started start next) (if started end next) started)
        (trim-run s next n (if started start i) next true)))))

(defn- trimmed [s :string] :string
  (trim-run s 0 (string-length s) 0 0 false))

(defn- lower-ascii [c :i64] :i64
  (if (and (>= c 65) (<= c 90)) (+ c 32) c))

(defn- same-ci-from? [s :string w :string i :i64] :bool
  (cond (>= i (string-length w)) true
        (>= i (string-length s)) false
        (= (lower-ascii (string-code-point-at s i))
           (string-code-point-at w i))
        (same-ci-from? s w (+ i 1))
        :else false))

(defn parse-bot-chat-token [part :string] :string
  (let [raw (trimmed part)
        prefix "bot-chat"
        prefix-length (string-length prefix)]
    (cond (not (same-ci-from? raw prefix 0)) "none"
          (= (string-length raw) prefix-length) "value:"
          (not (= 58 (string-code-point-at raw prefix-length))) "none"
          :else
          (string-concat "value:"
                         (trimmed (string-substring raw (+ prefix-length 1)
                                                   (string-length raw)))))))
