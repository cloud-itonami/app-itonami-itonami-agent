(ns agent-cli-cron-jobs-store
  "Create and mutate cron jobs in an Itonami app-data directory using Kotoba
  and the scoped Hata store adapter."
  (:require [itonami.cron-jobs-store :as store])
  (:export [main])
  (:capabilities #{:cli/args :clock/now :entropy/draw :fs/app-data :io/write :io/write-error}))

(defn- arg [index :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 index)))

(defn- say [s :string] :i64
  (let [w (typed-cap-call :io/write :string :string (string-concat s "\n"))]
    0))

(defn- fail [s :string] :i64
  (let [w (typed-cap-call :io/write-error :string :string (string-concat "cron jobs: " s))]
    2))

(defn- include-disabled? [value :string] :bool
  (not (string=? value "false")))

(defn- list-command [directory :string option :string] :i64
  (let [result (store/list-jobs directory (include-disabled? option))]
    (if (result-ok?-of [:result :string :string] result)
      (say (result-value-of [:result :string :string] result "{}"))
      (fail (result-error-of [:result :string :string] result "cron-store/list-failed")))))

(defn- pause-command [directory :string job-id :string reason :string] :i64
  (let [why (if (string=? reason "") "Paused by agent" reason)
        result (store/pause-job directory job-id why)]
    (if (result-ok?-of [:result :string :string] result)
      0
      (fail (result-error-of [:result :string :string] result "cron-store/pause-failed")))))

(defn- resume-command [directory :string job-id :string offset :string] :i64
  (let [result (store/resume-job directory job-id offset)]
    (if (result-ok?-of [:result :string :string] result)
      0
      (fail (result-error-of [:result :string :string] result "cron-store/resume-failed")))))

(defn- create-command [directory :string schedule-text :string prompt :string
                      name :string offset :string] :i64
  (let [result (store/create-job directory schedule-text prompt name offset)]
    (if (result-ok?-of [:result :string :string] result)
      (say (result-value-of [:result :string :string] result ""))
      (fail (result-error-of [:result :string :string] result "cron-store/create-failed")))))

(defn main [] :i64
  (let [action (arg 0)
        directory (arg 1)]
    (cond
      (string=? action "list")
        (list-command directory (arg 2))
      (string=? action "pause")
        (pause-command directory (arg 2) (arg 3))
      (string=? action "resume")
        (resume-command directory (arg 2) (arg 3))
      (string=? action "create")
        (create-command directory (arg 2) (arg 3) (arg 4) (arg 5))
      (string=? action "remove")
        (let [job-id (arg 2)
              result (store/remove-job directory job-id)]
          (if (result-ok?-of [:result :string :string] result) 0 1))
      :else (fail "usage: itonami-agent cron jobs list <absolute-app-data-dir> [false] | pause <absolute-app-data-dir> <job-id> [reason] | resume <absolute-app-data-dir> <job-id> | remove <absolute-app-data-dir> <job-id> | create <absolute-app-data-dir> <schedule> <prompt> [name] <utc-offset>"))))
