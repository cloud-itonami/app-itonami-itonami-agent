(ns agent-cli.audio-front-cli
  "One-shot native guest for the front end of the Qwen3-ASR audio encoder (JUN-923). argv 0 is the
  model path inside the granted directory (for example /d/model.safetensors). It runs the
  synthetic 128-bin x 24-frame mel input through the three conv2d blocks, conv_out and the
  position embedding and prints the three 896-wide tokens as 43,008 hex characters (16 per f64
  bit pattern), exit 0. A missing argument or an unreadable model prints one named line on stderr,
  nothing on stdout, exit 2. Weights are read with FS2 range requests from fd 3 (amu-command-fs35)."
  (:require [itonami.audio-ffn :as af])
  (:export [main])
  (:capabilities #{:cli/args :io/write :io/write-error :fs/app-data}))

(defn- wire-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))

(defn- wire-say [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn- wire-die [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn main [] :i64
  (let [path (wire-arg 0)]
    (if (= (string-length path) 0)
      (let [_ (wire-die "audio-front: argv 0 must be the model path\n")] 2)
      (let [out (af/front-hex path)]
        (if (= (string-length out) 0)
          (let [_ (wire-die "audio-front: model unreadable\n")] 2)
          (let [_ (wire-say (string-concat out "\n"))] 0))))))
