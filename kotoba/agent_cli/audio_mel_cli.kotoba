(ns agent-cli.audio-mel-cli
  "One-shot native guest for the 128-bin log-mel of a short real clip (JUN-925). argv 0 is the clip:
  3840 samples of 16 kHz audio, each as 4 hex digits of the int16 sample + 32768 (15,360
  characters). It applies whisper's front end (200-sample reflect padding, 400-sample periodic
  Hann frames with hop 160, 128 Slaney mel bins, log10 with the 1e-10 floor, the clamp at
  maximum - 8, then (x + 4) / 4) and prints the 128 x 24 result, index bin * 24 + frame, as 49,152
  hex characters (16 per f64 bit pattern) on one line, exit 0. A missing or malformed clip prints
  one named line on stderr, nothing on stdout, exit 2. Capabilities are argv, stdout and stderr."
  (:require [itonami.audio-ffn :as af])
  (:export [main])
  (:capabilities #{:cli/args :io/write :io/write-error :fs/app-data}))

(defn- wire-arg [i :i64] :string
  (typed-cap-call :cli/args :string :string (string-from-i64 i)))

(defn- wire-say [s :string] :string
  (typed-cap-call :io/write :string :string s))

(defn- wire-die [s :string] :string
  (typed-cap-call :io/write-error :string :string s))

(defn main [] :i64
  (let [out (af/mel-hex (wire-arg 0))]
    (if (= (string-length out) 0)
      (let [_ (wire-die "audio-mel: argv 0 must be 15360 hex characters (3840 offset-binary int16 samples)\n")] 2)
      (let [_ (wire-say (string-concat out "\n"))] 0))))
