;; Appended to the exact github_checkpoint_core.kotoba source after replacing
;; its namespace for single-source native runners. No network or secret data.
(defn main [] :i64
  (if (and
        ;; A valid publication requires all four independent facts.
        (= 1 (commit-admitted 1 1 1 1))
        (= 0 (commit-admitted 0 1 1 1))
        (= 0 (commit-admitted 1 0 1 1))
        (= 0 (commit-admitted 1 1 0 1))
        (= 0 (commit-admitted 1 1 1 0))
        (= 0 (commit-admitted 1 1 1 2))
        ;; An acknowledgement alone is not remote readback.
        (= 2 (remote-result 1 0 0))
        (= 1 (remote-result 1 1 1))
        (= 2 (remote-result 1 1 0))
        ;; A lost acknowledgement is resolved only by verified exact readback.
        (= 1 (remote-result 3 1 1))
        (= 2 (remote-result 3 2 0))
        (= 2 (remote-result 3 0 0))
        ;; Ref conflicts or failed pushes must not become success.
        (= 3 (remote-result 1 3 1))
        (= 3 (remote-result 2 1 1))
        (= 0 (remote-result 0 1 1))
        ;; Invalid host observations remain UNKNOWN, not success.
        (= 2 (remote-result -1 1 1))
        (= 2 (remote-result 1 4 1))
        (= 2 (remote-result 1 1 -1)))
    0
    1))
