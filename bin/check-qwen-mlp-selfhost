#!/bin/sh
# Compile and execute the BF16 weight-row linear steps and the SiLU-gated MLP (built on
# itonami.bf16, itonami.qwen-ops, itonami.nn-ops, itonami.log-mel and
# itonami.ggml-dequant) with the pinned Amu multi-module project CLI, against a one-off
# stdlib reference and three real rows of the downloaded Qwen3-ASR-0.6B gate_proj
# weights. It does not read a model file at gate time, run a model, or exercise the
# agent turn or launcher.

set -eu

if [ "$#" -ne 2 ]; then
  printf '%s\n' "usage: $0 <amu-cli.macho> <absolute-workspace-output-dir>" >&2
  exit 2
fi

CLI=$1
OUT_DIR=$2
EXPECTED_CLI_SHA256=ae94dc99ffe489ef77cb5eb0044bea1d2500a4273d45c55bcf57b887994f390a
EXPECTED_LOGMEL_SHA256=daf0d273329a7b5a05aef4255b985f2e1c031c74f32596e9578add46980b1f5e
EXPECTED_NN_SHA256=4693d227291a31b8c59378b0ab114715a983dfbfd17308d5b478181793a3604d
EXPECTED_QWENOPS_SHA256=a5a8744046a81edd21d0740395e874c89ed518e24092a5e889c78b2b2ba51576
EXPECTED_BF16_SHA256=09de868917eb1ba9764794cdd5e3c890e462ec22709d9ede4cf1e1554a33549b
EXPECTED_DEQUANT_SHA256=c3f22e7c3f189346d8e6a6225c0ae41796369e6045d142dfb031e6fcb429e8d5
EXPECTED_ATTN_SHA256=e6eca61967f49ac304b6b9e73842ef10edb43e40ed3ea2226a7c86085480d252
AMU_COMMIT=d673111b66f43a8569e545c772a70e51737e1707
EXPECTED_RESULT=15

REPO_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
GITHUB_ROOT=$(CDPATH= cd -- "$REPO_ROOT/../../.." && pwd)

case "$OUT_DIR" in
  "$GITHUB_ROOT"/workspaces/*) ;;
  *) printf '%s\n' "refusing output outside $GITHUB_ROOT/workspaces" >&2; exit 2 ;;
esac
case "$CLI" in
  /*) ;;
  *) printf '%s\n' "Amu CLI path must be absolute" >&2; exit 2 ;;
esac
[ -x "$CLI" ] || { printf '%s\n' "Amu CLI is missing or not executable: $CLI" >&2; exit 2; }
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi
check_sha() {
  actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
  if [ "$actual" != "$2" ]; then
    printf 'unexpected digest for %s: %s\n' "$1" "$actual" >&2
    exit 2
  fi
}
CLI_SHA256=$(shasum -a 256 "$CLI" | cut -d ' ' -f 1)
check_sha "$CLI" "$EXPECTED_CLI_SHA256"
LOGMEL="$REPO_ROOT/kotoba/itonami/log_mel.kotoba"
NNOPS="$REPO_ROOT/kotoba/itonami/nn_ops.kotoba"
QWENOPS="$REPO_ROOT/kotoba/itonami/qwen_ops.kotoba"
BF16="$REPO_ROOT/kotoba/itonami/bf16.kotoba"
DEQUANT="$REPO_ROOT/kotoba/itonami/ggml_dequant.kotoba"
SOURCE="$REPO_ROOT/kotoba/itonami/qwen_mlp.kotoba"
check_sha "$LOGMEL" "$EXPECTED_LOGMEL_SHA256"
check_sha "$NNOPS" "$EXPECTED_NN_SHA256"
check_sha "$QWENOPS" "$EXPECTED_QWENOPS_SHA256"
check_sha "$BF16" "$EXPECTED_BF16_SHA256"
check_sha "$DEQUANT" "$EXPECTED_DEQUANT_SHA256"
check_sha "$SOURCE" "$EXPECTED_ATTN_SHA256"
SOURCE_SHA256=$EXPECTED_ATTN_SHA256

# run_gate <dir> <qwen-mlp-source-file>: lock + compile. Modules sorted by
# name, files sorted by path.
run_gate() {
  dir=$1
  src=$2
  gate="$dir/src/qwen_mlp_gate.kotoba"
  mkdir -p "$dir/src"
  cp "$LOGMEL" "$dir/src/log_mel.kotoba"
  cp "$NNOPS" "$dir/src/nn_ops.kotoba"
  cp "$QWENOPS" "$dir/src/qwen_ops.kotoba"
  cp "$BF16" "$dir/src/bf16.kotoba"
  cp "$DEQUANT" "$dir/src/ggml_dequant.kotoba"
  cp "$src" "$dir/src/qwen_mlp.kotoba"
  cat > "$gate" <<'EOF2'
(ns itonami.qwen-mlp-gate
  (:require [itonami.qwen-mlp :as m])
  (:export [main]))
(defn main [] :i64 (m/match-count))
EOF2
  lm="$dir/src/log_mel.kotoba"
  nn="$dir/src/nn_ops.kotoba"
  at="$dir/src/qwen_mlp.kotoba"
  qo="$dir/src/qwen_ops.kotoba"
  bf="$dir/src/bf16.kotoba"
  gd="$dir/src/ggml_dequant.kotoba"
  # modules sorted by name, files sorted by path:
  # bf16 < ggml-dequant < log-mel < nn-ops < qwen-mlp < qwen-mlp-gate < qwen-ops
  printf 'KSL2\nentry %s\nmodule itonami.bf16 %s\nmodule itonami.ggml-dequant %s\nmodule itonami.log-mel %s\nmodule itonami.nn-ops %s\nmodule itonami.qwen-mlp %s\nmodule itonami.qwen-mlp-gate %s\nmodule itonami.qwen-ops %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\n' \
    "$gate" "$bf" "$gd" "$lm" "$nn" "$at" "$gate" "$qo" \
    "$(shasum -a 256 "$bf" | cut -d ' ' -f 1)" "$bf" \
    "$(shasum -a 256 "$gd" | cut -d ' ' -f 1)" "$gd" \
    "$(shasum -a 256 "$lm" | cut -d ' ' -f 1)" "$lm" \
    "$(shasum -a 256 "$nn" | cut -d ' ' -f 1)" "$nn" \
    "$(shasum -a 256 "$at" | cut -d ' ' -f 1)" "$at" \
    "$(shasum -a 256 "$gate" | cut -d ' ' -f 1)" "$gate" \
    "$(shasum -a 256 "$qo" | cut -d ' ' -f 1)" "$qo" > "$dir/qwen-mlp.ksl"
  "$CLI" compile "$gate" --source-lock "$dir/qwen-mlp.ksl" -o "$dir/qwen-mlp-tests.macho"
  codesign --verify --strict "$dir/qwen-mlp-tests.macho"
}

POS="$OUT_DIR/positive"
run_gate "$POS" "$SOURCE"
GATE_PATH="$POS/src/qwen_mlp_gate.kotoba"
LOCK="$POS/qwen-mlp.ksl"
PROGRAM="$POS/qwen-mlp-tests.macho"
DIRECT_RESULT=$("$PROGRAM")
LOCKED_RESULT=$("$CLI" run "$GATE_PATH" --source-lock "$LOCK")
ARTIFACT_RESULT=$("$CLI" run "$PROGRAM")
for result in "$DIRECT_RESULT" "$LOCKED_RESULT" "$ARTIFACT_RESULT"; do
  if [ "$result" != "$EXPECTED_RESULT" ]; then
    printf 'qwen-mlp result mismatch: expected %s, got %s\n' "$EXPECTED_RESULT" "$result" >&2
    exit 1
  fi
done

# negative controls: each mutation must change the source and stop the gate
# from returning the full match count
NEG="$OUT_DIR/negative"
mkdir -p "$NEG"
NEG_RESULTS=""
mutate() {
  name=$1
  pattern=$2
  replacement=$3
  sed "s/$pattern/$replacement/" "$SOURCE" > "$NEG/$name.kotoba"
  if cmp -s "$SOURCE" "$NEG/$name.kotoba"; then
    printf 'negative control %s did not change the source\n' "$name" >&2
    exit 1
  fi
  run_gate "$NEG/$name" "$NEG/$name.kotoba"
  result=$("$NEG/$name/qwen-mlp-tests.macho")
  if [ "$result" = "$EXPECTED_RESULT" ]; then
    printf 'negative control %s still passed the gate\n' "$name" >&2
    exit 1
  fi
  NEG_RESULTS="$NEG_RESULTS $name=$result"
}
mutate mac-index '(bf\/bf16-bits w (\* 2 j))' '(bf\/bf16-bits w j)'
mutate no-silu '(fmul (qo\/silu (gate-run k r 0 (zero))) (up-run k r 0 (zero)))' '(fmul (gate-run k r 0 (zero)) (up-run k r 0 (zero)))'
mutate silu-on-up '(fmul (qo\/silu (gate-run k r 0 (zero))) (up-run k r 0 (zero)))' '(fmul (qo\/silu (up-run k r 0 (zero))) (gate-run k r 0 (zero)))'
mutate down-width '(if (>= r 3) acc (down-run' '(if (>= r 2) acc (down-run'
mutate real-columns '(if (>= j 16)' '(if (>= j 15)'
mutate input-index '(gate-row r) c (xin k c)' '(gate-row r) c (xin 0 c)'
mutate gate-up-rows '(bf16-mac acc (up-row r) c (xin k c))' '(bf16-mac acc (gate-row r) c (xin k c))'

# negative control: a source changed after locking is refused
SOURCE_PATH="$POS/src/qwen_mlp.kotoba"
printf '\n' >> "$SOURCE_PATH"
if "$CLI" compile "$GATE_PATH" --source-lock "$LOCK" \
  -o "$OUT_DIR/should-not-exist.macho" > "$OUT_DIR/refusal.stdout" 2> "$OUT_DIR/refusal.stderr"; then
  printf '%s\n' "changed locked source unexpectedly compiled" >&2
  exit 1
fi
grep -q 'EINPUT a locked project source' "$OUT_DIR/refusal.stderr" || { cat "$OUT_DIR/refusal.stderr" >&2; printf '%s\n' "changed source refusal did not identify the locked input" >&2; exit 1; }
[ ! -e "$OUT_DIR/should-not-exist.macho" ] || { printf '%s\n' "refused compile left an output artifact" >&2; exit 1; }

{
  printf 'format: itonami.qwen-mlp-selfhost-gate.v1\n'
  printf 'amu_pr_commit: %s\n' "$AMU_COMMIT"
  printf 'amu_cli_sha256: %s\n' "$CLI_SHA256"
  printf 'log_mel_source_sha256: %s\n' "$EXPECTED_LOGMEL_SHA256"
  printf 'nn_ops_source_sha256: %s\n' "$EXPECTED_NN_SHA256"
  printf 'qwen_ops_source_sha256: %s\n' "$EXPECTED_QWENOPS_SHA256"
  printf 'bf16_source_sha256: %s\n' "$EXPECTED_BF16_SHA256"
  printf 'ggml_dequant_source_sha256: %s\n' "$EXPECTED_DEQUANT_SHA256"
  printf 'qwen-mlp_source_sha256: %s\n' "$SOURCE_SHA256"
  printf 'program_sha256: %s\n' "$(shasum -a 256 "$PROGRAM" | cut -d ' ' -f 1)"
  printf 'direct_result: %s\n' "$DIRECT_RESULT"
  printf 'locked_run_result: %s\n' "$LOCKED_RESULT"
  printf 'artifact_run_result: %s\n' "$ARTIFACT_RESULT"
  printf 'negative_control_results:%s\n' "$NEG_RESULTS"
  printf 'changed_source_refusal: PASS\n'
  printf 'qualification: bounded BF16 linear steps and a small SiLU-gated MLP, plus 3 real weight rows; no real sizes, residuals, turn or launcher\n'
} > "$OUT_DIR/build-receipt.txt"

cat "$OUT_DIR/build-receipt.txt"
