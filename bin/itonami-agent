#!/bin/sh
# Covered routes run as one-shot kexe guests through the loader. Unported
# routes fail closed until their Kotoba guest is implemented and qualified.
#
# Guest manifest (offset/arity/grants per guest -- from the amu build;
# one offset serves every target of one source build):
#   notepad-cli        28280 0 3,34,35,37,38,39
#   kanban-cli         67512 0 3,7,34,35,37,38   (7 = clock for heartbeat)
#   session-search-cli 62564 0 3,34,35,37,38
#   turn-cli            18544 0 3,34,35,37,38,11
#   turn-loop-cli       61004 0 3,34,35,37,38,11
#
# Env: KEXE_LOADER (the loader binary), KEXE_GUESTS (dir with the .raw
# guests), ITONAMI_ARCH (aarch64|x86_64, default from uname).

set -e
HERE=$(dirname "$0")
LOADER=${KEXE_LOADER:-$HERE/kexe-loader}
GUESTS=${KEXE_GUESTS:-$HERE/guests}
ARCH=${ITONAMI_ARCH:-$(uname -m | sed 's/arm64/aarch64/;s/x86_64/x86_64/')}

run_guest() {
  raw=$1; offset=$2; grants=$3; shift 3
  # KEXE_COMMAND: the guest return value is the process exit code and
  # the loader prints nothing extra (the CLI own stdout is the answer).
  KEXE_COMMAND=1 exec "$LOADER" "$GUESTS/$raw" "$offset" 0 "$ARCH" "$grants" -- "$@"
}

blocked() {
  printf '%s\n' "itonami-agent: route '$*' is blocked pending Kotoba/Amu selfhost port" >&2
  exit 78
}

usage() {
  cat <<'EOF'
Usage: itonami-agent <route> [arguments]

Selfhost routes:
  cron schedule <expression>
  cron next-run <expression> <epoch-ms> <utc-offset-minutes>
  cron notepad <base> <verb> [key] [value]
  kanban <base> <verb> [arguments]
  session-search <base> <query> [limit] [after] [before] [detail] [sort] [sid] [pbase]
  turn <base> <job-id> <task>
  turn-loop <base> <job-id> <task>

Other routes are blocked until their Kotoba/Amu selfhost port is qualified.
EOF
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

case "$1" in
  help|--help|-h)
    usage
    exit 0
    ;;
esac

case "$1" in
  cron)
    case "$2" in
      schedule)
        shift 2
        schedule_cli="$HERE/cron-schedule-cli"
        if [ ! -x "$schedule_cli" ]; then
          blocked "cron schedule (native artifact missing)"
        fi
        exec "$schedule_cli" "$@"
        ;;
      next-run)
        shift 2
        schedule_cli="$HERE/cron-schedule-cli"
        if [ ! -x "$schedule_cli" ]; then
          blocked "cron next-run (native artifact missing)"
        fi
        exec "$schedule_cli" --next-run "$@"
        ;;
      notepad)
        shift 2
        # argv: <base> <verb> [key] [value]  (guest order: verb base key value)
        base=$1; verb=$2; key=$3; value=$4
        run_guest notepad-cli.raw 28280 3,34,35,37,38,39 "$verb" "$base" "$key" "$value"
        ;;
      *)
        blocked "$@"
        ;;
    esac
    ;;
  kanban)
    shift
    # argv: <base> <verb> [a2] [a3] [a4] [a5]  (guest order: verb base ...)
    base=$1; verb=$2
    shift 2
    run_guest kanban-cli.raw 67512 3,7,34,35,37,38 "$verb" "$base" "$@"
    ;;
  session-search)
    shift
    # argv: <base> <query> [limit] [after] [before] [detail] [sort] [sid] [pbase]
    base=$1; query=$2; limit=${3:-100}; after=${4:-}; before=${5:-}; detail=${6:-adaptive}; sort=${7:-}; sid=${8:-}; pbase=${9:-}
    run_guest session-search-cli.raw 62564 3,34,35,37,38 "$base" "$query" "$limit" "$after" "$before" "$detail" "$sort" "$sid" "$pbase"
    ;;
  turn)
    shift
    # argv: <base> <job-id> <task>  (guest order matches)
    run_guest turn-cli.raw 18544 3,34,35,37,38,11 "$@"
    ;;
  turn-loop)
    shift
    # argv: <base> <job-id> <task>
    run_guest turn-loop.raw 61004 3,34,35,37,38,11 "$@"
    ;;
  *)
    blocked "$@"
    ;;
esac
