#!/bin/sh
# Qualified routes use their Amu native artifacts. Legacy loader guests remain
# migration inventory and are not a fallback for the native notepad route.
#
# Legacy loader guest manifest (unqualified migration inventory):
#   kanban-cli         67512 0 3,7,34,35,37,38   (7 = clock for heartbeat)
#   session-search-cli 62564 0 3,34,35,37,38
#   turn-cli            18544 0 3,34,35,37,38,11
#   turn-loop-cli       61004 0 3,34,35,37,38,11
#
# Native notepad artifacts: ITONAMI_NOTEPAD_RUNNER and
# ITONAMI_NOTEPAD_PAYLOAD. Other loader routes are migration inventory.

set -e
HERE=$(dirname "$0")
LOADER=${KEXE_LOADER:-$HERE/kexe-loader}
GUESTS=${KEXE_GUESTS:-$HERE/guests}
ARCH=${ITONAMI_ARCH:-$(uname -m | sed 's/arm64/aarch64/;s/x86_64/x86_64/')}

run_guest() {
  raw=$1; offset=$2; grants=$3; shift 3
  # KEXE_COMMAND: the guest return value is the process exit code and
  # the loader prints nothing extra (the CLI own stdout is the answer).
  KEXE_COMMAND=1 exec "$LOADER" "$GUESTS/$raw" "$offset" 0 "$ARCH" "$grants" -- "$@"
}

blocked() {
  printf '%s\n' "itonami-agent: route '$*' is blocked pending Kotoba/Amu selfhost port" >&2
  exit 78
}

run_cron_schedule_cli() {
  schedule_cli=$1
  shift
  output_dir=$(mktemp -d "${TMPDIR:-/tmp}/itonami-cron-schedule.XXXXXX") || {
    printf '%s\n' "itonami-agent: cannot create cron schedule result buffer" >&2
    exit 78
  }
  if "$schedule_cli" "$@" > "$output_dir/stdout" 2> "$output_dir/stderr"; then
    host_status=0
  else
    host_status=$?
  fi
  if [ "$host_status" -ne 0 ]; then
    cat "$output_dir/stdout"
    cat "$output_dir/stderr" >&2
    rm -rf "$output_dir"
    exit "$host_status"
  fi
  guest_status=$(tail -n 1 "$output_dir/stdout")
  case "$guest_status" in
    0)
      cat "$output_dir/stderr" >&2
      sed '$d' "$output_dir/stdout"
      rm -rf "$output_dir"
      exit 0
      ;;
    1|2)
      cat "$output_dir/stderr" >&2
      rm -rf "$output_dir"
      exit "$guest_status"
      ;;
    *)
      printf '%s\n' "itonami-agent: cron schedule returned an invalid native result" >&2
      rm -rf "$output_dir"
      exit 78
      ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: itonami-agent <route> [arguments]

Selfhost routes:
  cron schedule <expression>
  cron next-run <expression> <epoch-ms> <utc-offset-minutes>
  cron jobs list <absolute-app-data-dir> [false]  (Linux x86_64; false = active only)
  cron jobs pause <absolute-app-data-dir> <job-id> [reason]  (Linux x86_64)
  cron jobs resume <absolute-app-data-dir> <job-id>  (Linux x86_64)
  cron jobs remove <absolute-app-data-dir> <job-id>  (Linux x86_64)
  cron jobs create <absolute-app-data-dir> <schedule> <prompt> [name]  (Linux x86_64)
  cron jobs update <absolute-app-data-dir> <job-id-or-name> <patch-json>  (Linux x86_64)
  cron jobs pause-global [reason]  (Linux x86_64; ITONAMI_DIR/paused)
  cron jobs resume-global  (Linux x86_64; ITONAMI_DIR/paused)
  cron jobs status-global  (Linux x86_64; ITONAMI_DIR/paused)
  cron notepad <base> <verb> [key] [value]
  kanban <base> <verb> [arguments]
  session-search <base> <query> [limit] [after] [before] [detail] [sort] [sid] [pbase]
  turn <base> <job-id> <task>
  turn-loop <base> <job-id> <task>

Other routes are blocked until their Kotoba/Amu selfhost port is qualified.
EOF
}

run_cron_jobs_linux() {
  action=$1
  base=$2
  value=$3
  option=$4
  extra1=${5:-}
  extra2=${6:-}
  if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
    blocked "cron jobs $action (native runtime is Linux x86_64 only)"
  fi
  case "$base" in
    /*) ;;
    *) printf '%s\n' "itonami-agent: cron jobs $action requires an absolute app-data directory" >&2; exit 2 ;;
  esac
  if [ ! -d "$base" ]; then
    printf '%s\n' "itonami-agent: cron jobs $action app-data directory does not exist" >&2
    exit 2
  fi
  runner=${ITONAMI_CRON_JOBS_RUNNER:-$HERE/cron-jobs-runner}
  payload=${ITONAMI_CRON_JOBS_PAYLOAD:-$HERE/cron-jobs.payload}
  if [ ! -x "$runner" ] || [ ! -f "$payload" ]; then
    blocked "cron jobs $action (native artifact missing)"
  fi
  capabilities=7,35,37,38,39
  if [ "$action" = create ]; then
    capabilities=7,23,35,37,38,39
  fi
  report=$(KEXE_ALLOW="$capabilities" \
    KEXE_CAP_RESOURCES_35="$base" \
    KEXE_STACK_BYTES=8388608 \
    KEXE_STRUCTURED_REPORT=1 \
    "$runner" "$payload" 0 0 x86_64 "$capabilities" -- "$action" "$base" "$value" "$option" "$extra1" "$extra2")
  printf '%s\n' "$report"
  case "$report" in
    *":status :ok :result 0 "*) exit 0 ;;
    *":status :ok :result 1 "*) printf '%s\n' "itonami-agent: cron jobs $action refused" >&2; exit 1 ;;
    *":status :ok :result 2 "*) printf '%s\n' "itonami-agent: cron jobs $action refused" >&2; exit 2 ;;
    *) printf '%s\n' "itonami-agent: cron jobs $action returned an invalid native report" >&2; exit 78 ;;
  esac
}

run_notepad_linux() {
  base=$1
  verb=$2
  key=$3
  value=$4
  argument_count=$5
  if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
    blocked "cron notepad (native runtime is Linux x86_64 only)"
  fi
  case "$base" in
    /*) ;;
    *) printf '%s\n' "itonami-agent: cron notepad requires an absolute job directory" >&2; exit 2 ;;
  esac
  if [ ! -d "$base" ]; then
    printf '%s\n' "itonami-agent: cron notepad job directory does not exist" >&2
    exit 2
  fi
  case "$verb" in
    set)
      if [ "$argument_count" -ne 4 ]; then
        printf '%s\n' "usage: itonami-agent cron notepad <job-directory> set <key> <value>" >&2
        exit 2
      fi
      ;;
    get|delete)
      if [ "$argument_count" -ne 3 ]; then
        printf '%s\n' "usage: itonami-agent cron notepad <job-directory> $verb <key>" >&2
        exit 2
      fi
      ;;
    list|clear)
      if [ "$argument_count" -ne 2 ]; then
        printf '%s\n' "usage: itonami-agent cron notepad <job-directory> $verb" >&2
        exit 2
      fi
      ;;
    *)
      printf '%s\n' "usage: itonami-agent cron notepad <job-directory> set <key> <value> | get <key> | list" >&2
      exit 2
      ;;
  esac
  case "$verb" in
    delete|clear)
      printf '%s\n' "itonami-agent: cron notepad $verb is blocked pending native unlink qualification" >&2
      exit 78
      ;;
  esac
  updated_at=""
  if [ "$verb" = set ]; then
    updated_at=$(date -u '+%Y-%m-%dT%H:%M:%S.%3NZ' 2>/dev/null) \
      || blocked "cron notepad set (UTC clock unavailable)"
    case "$updated_at" in
      ????-??-??T??:??:??.???Z) ;;
      *) blocked "cron notepad set (invalid UTC timestamp)" ;;
    esac
  fi
  runner=${ITONAMI_NOTEPAD_RUNNER:-$HERE/notepad-runner}
  payload=${ITONAMI_NOTEPAD_PAYLOAD:-$HERE/notepad.payload}
  if [ ! -x "$runner" ] || [ ! -f "$payload" ]; then
    blocked "cron notepad (native artifact missing)"
  fi
  capabilities=3,34,35,37,38,39
  if report=$(KEXE_ALLOW="$capabilities" \
    KEXE_CAP_RESOURCES_34="$base" \
    KEXE_CAP_RESOURCES_35="$base" \
    KEXE_STACK_BYTES=8388608 \
    KEXE_STRUCTURED_REPORT=1 \
    "$runner" "$payload" 0 0 x86_64 "$capabilities" -- "$verb" "$base" "$key" "$value" "$updated_at"); then
    host_status=0
  else
    host_status=$?
  fi
  printf '%s\n' "$report"
  case "$report" in
    *":status :ok :result 0 "*)
      if [ "$host_status" -eq 0 ]; then exit 0; fi
      ;;
    *":status :ok :result 2 "*)
      printf '%s\n' "itonami-agent: cron notepad $verb refused" >&2
      exit 2
      ;;
    *":status :trap :exit 120 "*)
      printf '%s\n' "itonami-agent: cron notepad $verb refused by native capability boundary" >&2
      exit 1
      ;;
  esac
  printf '%s\n' "itonami-agent: cron notepad $verb returned an invalid native report (exit $host_status)" >&2
  exit 78
}

if [ "$#" -eq 0 ]; then
  usage
  exit 0
fi

case "$1" in
  help|--help|-h)
    usage
    exit 0
    ;;
esac

case "$1" in
  cron)
    case "$2" in
      schedule)
        shift 2
        schedule_cli="$HERE/cron-schedule-cli"
        if [ ! -x "$schedule_cli" ]; then
          blocked "cron schedule (native artifact missing)"
        fi
        run_cron_schedule_cli "$schedule_cli" "$@"
        ;;
      next-run)
        shift 2
        schedule_cli="$HERE/cron-schedule-cli"
        if [ ! -x "$schedule_cli" ]; then
          blocked "cron next-run (native artifact missing)"
        fi
        run_cron_schedule_cli "$schedule_cli" --next-run "$@"
        ;;
      jobs)
        if [ "$3" = pause-global ] && { [ "$#" -eq 3 ] || [ "$#" -eq 4 ]; }; then
          itonami_dir=${ITONAMI_DIR:-${HOME:-}/.itonami}
          case "$itonami_dir" in
            /*) ;;
            *) printf '%s\n' "itonami-agent: cron jobs pause-global requires an absolute ITONAMI_DIR" >&2; exit 2 ;;
          esac
          if [ ! -d "$itonami_dir" ]; then
            printf '%s\n' "itonami-agent: cron jobs pause-global ITONAMI_DIR does not exist" >&2
            exit 2
          fi
          if [ "$(uname -s)" != Linux ] || [ "$(uname -m)" != x86_64 ]; then
            blocked "cron jobs pause-global (native runtime is Linux x86_64 only)"
          fi
          pause_stamp=$(date '+%Y-%m-%dT%H:%M:%S%:z' 2>/dev/null) || blocked "cron jobs pause-global (local timestamp unavailable)"
          case "$pause_stamp" in
            ????-??-??T??:??:??[+-][0-9][0-9]:[0-9][0-9]) ;;
            *) blocked "cron jobs pause-global (invalid local timestamp)" ;;
          esac
          run_cron_jobs_linux pause-global "$itonami_dir" "$pause_stamp" "${4:-}"
        fi
        if [ "$3" = resume-global ] && [ "$#" -eq 3 ]; then
          itonami_dir=${ITONAMI_DIR:-${HOME:-}/.itonami}
          case "$itonami_dir" in
            /*) ;;
            *) printf '%s\n' "itonami-agent: cron jobs resume-global requires an absolute ITONAMI_DIR" >&2; exit 2 ;;
          esac
          run_cron_jobs_linux resume-global "$itonami_dir" "" ""
        fi
        if [ "$3" = status-global ] && [ "$#" -eq 3 ]; then
          itonami_dir=${ITONAMI_DIR:-${HOME:-}/.itonami}
          case "$itonami_dir" in
            /*) ;;
            *) printf '%s\n' "itonami-agent: cron jobs status-global requires an absolute ITONAMI_DIR" >&2; exit 2 ;;
          esac
          run_cron_jobs_linux status-global "$itonami_dir" "" ""
        fi
        if [ "$3" = list ] && { [ "$#" -eq 4 ] || [ "$#" -eq 5 ]; }; then
          run_cron_jobs_linux list "$4" "${5:-}" ""
        fi
        if [ "$3" = pause ] && { [ "$#" -eq 5 ] || [ "$#" -eq 6 ]; }; then
          run_cron_jobs_linux pause "$4" "${5:-}" "${6:-}"
        fi
        if [ "$3" = resume ] && [ "$#" -eq 5 ]; then
          local_offset=$(date +%z 2>/dev/null) || blocked "cron jobs resume (local timezone unavailable)"
          case "$local_offset" in
            [+-][0-9][0-9][0-9][0-9]) ;;
            *) blocked "cron jobs resume (invalid local timezone offset)" ;;
          esac
          run_cron_jobs_linux resume "$4" "$5" "$local_offset"
        fi
        if [ "$3" = remove ] && [ "$#" -eq 5 ]; then
          run_cron_jobs_linux remove "$4" "$5" ""
        fi
        if [ "$3" = create ] && { [ "$#" -eq 6 ] || [ "$#" -eq 7 ]; }; then
          local_offset=$(date +%z 2>/dev/null) || blocked "cron jobs create (local timezone unavailable)"
          case "$local_offset" in
            [+-][0-9][0-9][0-9][0-9]) ;;
            *) blocked "cron jobs create (invalid local timezone offset)" ;;
          esac
          run_cron_jobs_linux create "$4" "$5" "$6" "${7:-}" "$local_offset"
        fi
        if [ "$3" = update ] && [ "$#" -eq 6 ]; then
          local_offset=$(date +%z 2>/dev/null) || blocked "cron jobs update (local timezone unavailable)"
          case "$local_offset" in
            [+-][0-9][0-9][0-9][0-9]) ;;
            *) blocked "cron jobs update (invalid local timezone offset)" ;;
          esac
          run_cron_jobs_linux update "$4" "$5" "$6" "$local_offset"
        fi
        blocked "$@"
        ;;
      notepad)
        shift 2
        # argv: <base> <verb> [key] [value] (guest order: verb base key value)
        if [ "$#" -lt 2 ] || [ "$#" -gt 4 ]; then
          printf '%s\n' "usage: itonami-agent cron notepad <job-directory> set <key> <value> | get <key> | list" >&2
          exit 2
        fi
        argument_count=$#
        base=$1; verb=$2; key=${3:-}; value=${4:-}
        run_notepad_linux "$base" "$verb" "$key" "$value" "$argument_count"
        ;;
      *)
        blocked "$@"
        ;;
    esac
    ;;
  kanban)
    shift
    # argv: <base> <verb> [a2] [a3] [a4] [a5]  (guest order: verb base ...)
    base=$1; verb=$2
    shift 2
    run_guest kanban-cli.raw 67512 3,7,34,35,37,38 "$verb" "$base" "$@"
    ;;
  session-search)
    shift
    # argv: <base> <query> [limit] [after] [before] [detail] [sort] [sid] [pbase]
    base=$1; query=$2; limit=${3:-100}; after=${4:-}; before=${5:-}; detail=${6:-adaptive}; sort=${7:-}; sid=${8:-}; pbase=${9:-}
    run_guest session-search-cli.raw 62564 3,34,35,37,38 "$base" "$query" "$limit" "$after" "$before" "$detail" "$sort" "$sid" "$pbase"
    ;;
  turn)
    shift
    # argv: <base> <job-id> <task>  (guest order matches)
    run_guest turn-cli.raw 18544 3,34,35,37,38,11 "$@"
    ;;
  turn-loop)
    shift
    # argv: <base> <job-id> <task>
    run_guest turn-loop.raw 61004 3,34,35,37,38,11 "$@"
    ;;
  *)
    blocked "$@"
    ;;
esac
