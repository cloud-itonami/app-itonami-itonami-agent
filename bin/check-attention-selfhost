#!/bin/sh
# Compile and execute the scalar attention and GEMM core (non-causal, causal
# and cross attention with a max-shifted softmax; C = A.B + bias; built on
# itonami.nn-ops and itonami.log-mel) with the pinned Amu multi-module project
# CLI, against a one-off f64 reference. It does not load weights, run a model,
# or exercise the agent turn or launcher.

set -eu

if [ "$#" -ne 2 ]; then
  printf '%s\n' "usage: $0 <amu-cli.macho> <absolute-workspace-output-dir>" >&2
  exit 2
fi

CLI=$1
OUT_DIR=$2
EXPECTED_CLI_SHA256=ae94dc99ffe489ef77cb5eb0044bea1d2500a4273d45c55bcf57b887994f390a
EXPECTED_LOGMEL_SHA256=c8fe6a1035f5ef2c7681a3175702f0240c2764eb4db8d8335bfa194311389b69
EXPECTED_NN_SHA256=4693d227291a31b8c59378b0ab114715a983dfbfd17308d5b478181793a3604d
EXPECTED_ATTN_SHA256=e66eaec2c210cb7aa2201ec82cac55cf49cae65197fb519bbae821971f13173a
AMU_COMMIT=d673111b66f43a8569e545c772a70e51737e1707
EXPECTED_RESULT=50

REPO_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
GITHUB_ROOT=$(CDPATH= cd -- "$REPO_ROOT/../../.." && pwd)

case "$OUT_DIR" in
  "$GITHUB_ROOT"/workspaces/*) ;;
  *) printf '%s\n' "refusing output outside $GITHUB_ROOT/workspaces" >&2; exit 2 ;;
esac
case "$CLI" in
  /*) ;;
  *) printf '%s\n' "Amu CLI path must be absolute" >&2; exit 2 ;;
esac
[ -x "$CLI" ] || { printf '%s\n' "Amu CLI is missing or not executable: $CLI" >&2; exit 2; }
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi
check_sha() {
  actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
  if [ "$actual" != "$2" ]; then
    printf 'unexpected digest for %s: %s\n' "$1" "$actual" >&2
    exit 2
  fi
}
CLI_SHA256=$(shasum -a 256 "$CLI" | cut -d ' ' -f 1)
check_sha "$CLI" "$EXPECTED_CLI_SHA256"
LOGMEL="$REPO_ROOT/kotoba/itonami/log_mel.kotoba"
NNOPS="$REPO_ROOT/kotoba/itonami/nn_ops.kotoba"
SOURCE="$REPO_ROOT/kotoba/itonami/attention.kotoba"
check_sha "$LOGMEL" "$EXPECTED_LOGMEL_SHA256"
check_sha "$NNOPS" "$EXPECTED_NN_SHA256"
check_sha "$SOURCE" "$EXPECTED_ATTN_SHA256"
SOURCE_SHA256=$EXPECTED_ATTN_SHA256

# run_gate <dir> <attention-source-file>: lock + compile. Modules sorted by
# name, files sorted by path.
run_gate() {
  dir=$1
  src=$2
  gate="$dir/src/attention_gate.kotoba"
  mkdir -p "$dir/src"
  cp "$LOGMEL" "$dir/src/log_mel.kotoba"
  cp "$NNOPS" "$dir/src/nn_ops.kotoba"
  cp "$src" "$dir/src/attention.kotoba"
  cat > "$gate" <<'EOF2'
(ns itonami.attention-gate
  (:require [itonami.attention :as at])
  (:export [main]))
(defn main [] :i64 (at/match-count))
EOF2
  lm="$dir/src/log_mel.kotoba"
  nn="$dir/src/nn_ops.kotoba"
  at="$dir/src/attention.kotoba"
  printf 'KSL2\nentry %s\nmodule itonami.attention %s\nmodule itonami.attention-gate %s\nmodule itonami.log-mel %s\nmodule itonami.nn-ops %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\n' \
    "$gate" "$at" "$gate" "$lm" "$nn" \
    "$(shasum -a 256 "$at" | cut -d ' ' -f 1)" "$at" \
    "$(shasum -a 256 "$gate" | cut -d ' ' -f 1)" "$gate" \
    "$(shasum -a 256 "$lm" | cut -d ' ' -f 1)" "$lm" \
    "$(shasum -a 256 "$nn" | cut -d ' ' -f 1)" "$nn" > "$dir/attention.ksl"
  "$CLI" compile "$gate" --source-lock "$dir/attention.ksl" -o "$dir/attention-tests.macho"
  codesign --verify --strict "$dir/attention-tests.macho"
}

POS="$OUT_DIR/positive"
run_gate "$POS" "$SOURCE"
GATE_PATH="$POS/src/attention_gate.kotoba"
LOCK="$POS/attention.ksl"
PROGRAM="$POS/attention-tests.macho"
DIRECT_RESULT=$("$PROGRAM")
LOCKED_RESULT=$("$CLI" run "$GATE_PATH" --source-lock "$LOCK")
ARTIFACT_RESULT=$("$CLI" run "$PROGRAM")
for result in "$DIRECT_RESULT" "$LOCKED_RESULT" "$ARTIFACT_RESULT"; do
  if [ "$result" != "$EXPECTED_RESULT" ]; then
    printf 'attention result mismatch: expected %s, got %s\n' "$EXPECTED_RESULT" "$result" >&2
    exit 1
  fi
done

# negative controls: each mutation must change the source and stop the gate
# from returning the full match count
NEG="$OUT_DIR/negative"
mkdir -p "$NEG"
NEG_RESULTS=""
mutate() {
  name=$1
  pattern=$2
  replacement=$3
  sed "s/$pattern/$replacement/" "$SOURCE" > "$NEG/$name.kotoba"
  if cmp -s "$SOURCE" "$NEG/$name.kotoba"; then
    printf 'negative control %s did not change the source\n' "$name" >&2
    exit 1
  fi
  run_gate "$NEG/$name" "$NEG/$name.kotoba"
  result=$("$NEG/$name/attention-tests.macho")
  if [ "$result" = "$EXPECTED_RESULT" ]; then
    printf 'negative control %s still passed the gate\n' "$name" >&2
    exit 1
  fi
  NEG_RESULTS="$NEG_RESULTS $name=$result"
}
mutate no-scale '(f64-to-bits (f64-sqrt 2.0))' '(f64-to-bits 1.0)'
mutate no-max-shift '(fadd acc (fmul (fdiv (nn\/exp-wide (fsub (score h i j) mx)) z) (fv j (+ (\* 2 h) d)))))))' '(fadd acc (fmul (fdiv (nn\/exp-wide (score h i j)) z) (fv j (+ (* 2 h) d)))))))'
mutate mask-direction '(or (= causal 0) (<= j i))' '(or (= causal 0) (>= j i))'
mutate gemm-bias '(fadd (gemm-run i j 0 (zero)) (fbias j))' '(gemm-run i j 0 (zero))'
mutate value-head-offset '(fv j (+ (\* 2 h) d))' '(fv j d)'
mutate query-head-offset '(fq i (\* 2 h))' '(fq i 0)'
mutate key-head-offset '(fk j (+ (\* 2 h) 1))' '(fk j 1)'
mutate softmax-denominator '(fadd acc (nn\/exp-wide (fsub (score h i j) mx))))))' '(fadd acc (fmul (f64-to-bits 2.0) (nn\/exp-wide (fsub (score h i j) mx)))))))'

# negative control: a source changed after locking is refused
SOURCE_PATH="$POS/src/attention.kotoba"
printf '\n' >> "$SOURCE_PATH"
if "$CLI" compile "$GATE_PATH" --source-lock "$LOCK" \
  -o "$OUT_DIR/should-not-exist.macho" > "$OUT_DIR/refusal.stdout" 2> "$OUT_DIR/refusal.stderr"; then
  printf '%s\n' "changed locked source unexpectedly compiled" >&2
  exit 1
fi
grep -q 'EINPUT a locked project source' "$OUT_DIR/refusal.stderr" || { cat "$OUT_DIR/refusal.stderr" >&2; printf '%s\n' "changed source refusal did not identify the locked input" >&2; exit 1; }
[ ! -e "$OUT_DIR/should-not-exist.macho" ] || { printf '%s\n' "refused compile left an output artifact" >&2; exit 1; }

{
  printf 'format: itonami.attention-selfhost-gate.v1\n'
  printf 'amu_pr_commit: %s\n' "$AMU_COMMIT"
  printf 'amu_cli_sha256: %s\n' "$CLI_SHA256"
  printf 'log_mel_source_sha256: %s\n' "$EXPECTED_LOGMEL_SHA256"
  printf 'nn_ops_source_sha256: %s\n' "$EXPECTED_NN_SHA256"
  printf 'attention_source_sha256: %s\n' "$SOURCE_SHA256"
  printf 'program_sha256: %s\n' "$(shasum -a 256 "$PROGRAM" | cut -d ' ' -f 1)"
  printf 'direct_result: %s\n' "$DIRECT_RESULT"
  printf 'locked_run_result: %s\n' "$LOCKED_RESULT"
  printf 'artifact_run_result: %s\n' "$ARTIFACT_RESULT"
  printf 'negative_control_results:%s\n' "$NEG_RESULTS"
  printf 'changed_source_refusal: PASS\n'
  printf 'qualification: bounded scalar attention and GEMM on analytic two-head width-2 fixtures; no weights, real shapes, model, turn or launcher\n'
} > "$OUT_DIR/build-receipt.txt"

cat "$OUT_DIR/build-receipt.txt"
