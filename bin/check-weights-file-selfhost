#!/bin/sh
# Compile and run the native safetensors file reader (itonami.weights-file, built on
# itonami.safetensors and itonami.bf16) against the real Qwen3-ASR-0.6B model.safetensors
# with the pinned Amu multi-module project CLI. The file is cloned (APFS clonefile) into
# a granted directory handed to the guest on fd 3; the guest reads it only through FS2
# F (size) and E (range) requests. Expected values come from a CPython struct/json read
# of the same file. It does not run a model or exercise the agent turn or launcher.

set -eu

if [ "$#" -ne 3 ]; then
  printf '%s\n' "usage: $0 <amu-cli.macho> <absolute-workspace-output-dir> <model.safetensors>" >&2
  exit 2
fi

CLI=$1
OUT_DIR=$2
MODEL=$3
EXPECTED_CLI_SHA256=ee9a94e406f90dd1c899121708bed01b44818f2c3bc0b9780f266b0408c61ff0
EXPECTED_MODEL_SHA256=79d6cbd4c98c7bbffe9db2edac07f56cd6637d0d5944b27f6c2b8353840323ea
EXPECTED_BF16_SHA256=09de868917eb1ba9764794cdd5e3c890e462ec22709d9ede4cf1e1554a33549b
EXPECTED_DEQUANT_SHA256=c3f22e7c3f189346d8e6a6225c0ae41796369e6045d142dfb031e6fcb429e8d5
EXPECTED_ST_SHA256=20562030183d7a09fd43303821ecab5ed9065275a1ad68494eb3bb456e9c8f75
EXPECTED_SOURCE_SHA256=708c6dff5f022757be7250e7b7c6e4c99c311df865527fd7ea05b86ed92b2263
EXPECTED_GATE_SHA256=42a315cd76dc7d531f308d4609e3de8fa9db03aa67350201bfa9bcde0a0af538
EXPECTED_RESULT=36

REPO_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
GITHUB_ROOT=$(CDPATH= cd -- "$REPO_ROOT/../../.." && pwd)

case "$OUT_DIR" in
  "$GITHUB_ROOT"/workspaces/*) ;;
  *) printf '%s\n' "refusing output outside $GITHUB_ROOT/workspaces" >&2; exit 2 ;;
esac
case "$CLI" in
  /*) ;;
  *) printf '%s\n' "Amu CLI path must be absolute" >&2; exit 2 ;;
esac
case "$MODEL" in
  /*) ;;
  *) printf '%s\n' "model path must be absolute" >&2; exit 2 ;;
esac
if [ ! -x "$CLI" ]; then
  printf '%s\n' "Amu CLI is missing or not executable: $CLI" >&2
  exit 2
fi
if [ ! -f "$MODEL" ]; then
  printf '%s\n' "model file is missing: $MODEL" >&2
  exit 2
fi
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi

check_sha() {
  actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
  if [ "$actual" != "$2" ]; then
    printf 'unexpected digest for %s: %s\n' "$1" "$actual" >&2
    exit 2
  fi
}
check_sha "$CLI" "$EXPECTED_CLI_SHA256"
check_sha "$MODEL" "$EXPECTED_MODEL_SHA256"
BF16="$REPO_ROOT/kotoba/itonami/bf16.kotoba"
DEQUANT="$REPO_ROOT/kotoba/itonami/ggml_dequant.kotoba"
ST="$REPO_ROOT/kotoba/itonami/safetensors.kotoba"
SOURCE="$REPO_ROOT/kotoba/itonami/weights_file.kotoba"
GATE="$REPO_ROOT/test/native/weights_file_gate.kotoba"
check_sha "$BF16" "$EXPECTED_BF16_SHA256"
check_sha "$DEQUANT" "$EXPECTED_DEQUANT_SHA256"
check_sha "$ST" "$EXPECTED_ST_SHA256"
check_sha "$SOURCE" "$EXPECTED_SOURCE_SHA256"
check_sha "$GATE" "$EXPECTED_GATE_SHA256"

# The scope directory holds the model as /d/model.safetensors; a clone costs no disk.
SCOPE="$OUT_DIR/scope"
mkdir -m 700 -p "$SCOPE/d"
/bin/cp -c "$MODEL" "$SCOPE/d/model.safetensors"

# run_gate <dir> <weights_file-source>: lock + compile with the FS35 command profile
run_gate() {
  dir=$1
  src=$2
  mkdir -p "$dir/src"
  cp "$BF16" "$dir/src/bf16.kotoba"
  cp "$DEQUANT" "$dir/src/ggml_dequant.kotoba"
  cp "$ST" "$dir/src/safetensors.kotoba"
  cp "$src" "$dir/src/weights_file.kotoba"
  cp "$GATE" "$dir/src/weights_file_gate.kotoba"
  s="$dir/src"
  # modules sorted by name, files sorted by path
  printf 'KSL2\nentry %s\nmodule itonami.bf16 %s\nmodule itonami.ggml-dequant %s\nmodule itonami.safetensors %s\nmodule itonami.weights-file %s\nmodule itonami.weights-file-gate %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\nfile %s %s\n' \
    "$s/weights_file_gate.kotoba" \
    "$s/bf16.kotoba" "$s/ggml_dequant.kotoba" "$s/safetensors.kotoba" "$s/weights_file.kotoba" "$s/weights_file_gate.kotoba" \
    "$(shasum -a 256 "$s/bf16.kotoba" | cut -d ' ' -f 1)" "$s/bf16.kotoba" \
    "$(shasum -a 256 "$s/ggml_dequant.kotoba" | cut -d ' ' -f 1)" "$s/ggml_dequant.kotoba" \
    "$(shasum -a 256 "$s/safetensors.kotoba" | cut -d ' ' -f 1)" "$s/safetensors.kotoba" \
    "$(shasum -a 256 "$s/weights_file.kotoba" | cut -d ' ' -f 1)" "$s/weights_file.kotoba" \
    "$(shasum -a 256 "$s/weights_file_gate.kotoba" | cut -d ' ' -f 1)" "$s/weights_file_gate.kotoba" \
    > "$dir/weights-file.ksl"
  "$CLI" compile "$s/weights_file_gate.kotoba" --source-lock "$dir/weights-file.ksl" \
    --runtime-profile amu-command-fs35 -o "$dir/weights-file-tests.macho"
  codesign --verify --strict "$dir/weights-file-tests.macho"
}

# The guest reports its match count as the exit status and on stdout.
run_program() {
  set +e
  RUN_STDOUT=$("$1" 3< "$SCOPE" 2>/dev/null)
  RUN_STATUS=$?
  set -e
}

POS="$OUT_DIR/positive"
run_gate "$POS" "$SOURCE"
PROGRAM="$POS/weights-file-tests.macho"
run_program "$PROGRAM"
if [ "$RUN_STATUS" -ne "$EXPECTED_RESULT" ] || [ "$RUN_STDOUT" != "checks $EXPECTED_RESULT" ]; then
  printf 'weights-file result mismatch: expected %s, got status %s stdout %s\n' \
    "$EXPECTED_RESULT" "$RUN_STATUS" "$RUN_STDOUT" >&2
  exit 1
fi
POS_STATUS=$RUN_STATUS

# without the FS35 profile the guest gets no filesystem: amu run traps instead of reading
set +e
"$CLI" run "$POS/src/weights_file_gate.kotoba" --source-lock "$POS/weights-file.ksl" \
  3< "$SCOPE" > "$OUT_DIR/no-fs-run.stdout" 2> "$OUT_DIR/no-fs-run.stderr"
NO_FS_STATUS=$?
set -e
if [ "$NO_FS_STATUS" -eq "$EXPECTED_RESULT" ]; then
  printf '%s\n' "amu run unexpectedly read the model without the FS35 profile" >&2
  exit 1
fi

# negative controls: each mutation must change the source and stop the gate from
# returning the full match count
NEG="$OUT_DIR/negative"
mkdir -p "$NEG"
NEG_RESULTS=""
mutate() {
  name=$1
  pattern=$2
  replacement=$3
  sed "s/$pattern/$replacement/" "$SOURCE" > "$NEG/$name.kotoba"
  if cmp -s "$SOURCE" "$NEG/$name.kotoba"; then
    printf 'negative control %s did not change the source\n' "$name" >&2
    exit 1
  fi
  run_gate "$NEG/$name" "$NEG/$name.kotoba"
  run_program "$NEG/$name/weights-file-tests.macho"
  if [ "$RUN_STATUS" -eq "$EXPECTED_RESULT" ]; then
    printf 'negative control %s still passed the gate\n' "$name" >&2
    exit 1
  fi
  NEG_RESULTS="$NEG_RESULTS $name=$RUN_STATUS"
}
mutate le-scale '(\* scale 256)' '(* scale 16)'
mutate bf16-byte-order '(\* 256 (bytes-at r 6))' '(* 256 (bytes-at r 5))'
mutate header-offset '"8:"' '"9:"'
mutate data-base '(+ (+ 8 n) (+ b (\* 2 idx)))' '(+ (+ 9 n) (+ b (* 2 idx)))'
mutate header-reply-size '(= (bytes-count r) 13)' '(= (bytes-count r) 12)'
mutate x-vector '(mod (+ i seed) 7)' '(mod i 7)'
mutate row-stride '(\* row (\* cols 2))' '(* row cols)'
mutate dot-order '(f64-mul (f64-from-bits (bf\/bf16-to-f64 v))' '(f64-add (f64-from-bits (bf\/bf16-to-f64 v))'
mutate element-bound '(> (+ (+ b (\* 2 idx)) 2) e)' '(> (+ (+ b (* 2 idx)) 2) (+ e 4))'

# negative control: a source changed after locking is refused
printf '\n' >> "$POS/src/weights_file.kotoba"
if "$CLI" compile "$POS/src/weights_file_gate.kotoba" --source-lock "$POS/weights-file.ksl" \
  --runtime-profile amu-command-fs35 -o "$OUT_DIR/should-not-exist.macho" \
  > "$OUT_DIR/refusal.stdout" 2> "$OUT_DIR/refusal.stderr"; then
  printf '%s\n' "changed locked source unexpectedly compiled" >&2
  exit 1
fi
if ! grep -q 'EINPUT a locked project source' "$OUT_DIR/refusal.stderr"; then
  cat "$OUT_DIR/refusal.stderr" >&2
  printf '%s\n' "changed source refusal did not identify the locked input" >&2
  exit 1
fi
if [ -e "$OUT_DIR/should-not-exist.macho" ]; then
  printf '%s\n' "refused compile left an output artifact" >&2
  exit 1
fi

rm -f "$SCOPE/d/model.safetensors"
{
  printf 'format: itonami.weights-file-selfhost-gate.v1\n'
  printf 'amu_cli_sha256: %s\n' "$EXPECTED_CLI_SHA256"
  printf 'model_sha256: %s\n' "$EXPECTED_MODEL_SHA256"
  printf 'bf16_source_sha256: %s\n' "$EXPECTED_BF16_SHA256"
  printf 'ggml_dequant_source_sha256: %s\n' "$EXPECTED_DEQUANT_SHA256"
  printf 'safetensors_source_sha256: %s\n' "$EXPECTED_ST_SHA256"
  printf 'weights_file_source_sha256: %s\n' "$EXPECTED_SOURCE_SHA256"
  printf 'gate_source_sha256: %s\n' "$EXPECTED_GATE_SHA256"
  printf 'runtime_profile: amu-command-fs35 (directory on fd 3)\n'
  printf 'program_sha256: %s\n' "$(shasum -a 256 "$PROGRAM" | cut -d ' ' -f 1)"
  printf 'program_result: %s\n' "$POS_STATUS"
  printf 'amu_run_without_fs35_status: %s (not the full count)\n' "$NO_FS_STATUS"
  printf 'negative_control_results:%s\n' "$NEG_RESULTS"
  printf 'changed_source_refusal: PASS\n'
  printf 'qualification: bounded native reads of the real Qwen3-ASR-0.6B header and nine BF16 elements and three row dot products; no tensor-sized reads, no model run, turn or launcher\n'
} > "$OUT_DIR/build-receipt.txt"

cat "$OUT_DIR/build-receipt.txt"
