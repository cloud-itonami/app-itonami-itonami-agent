#!/bin/sh
# Compile and execute the scalar nn-ops core (wide exp, tanh, tanh-approx GELU,
# LayerNorm steps; built on itonami.log-mel's series) with the pinned Amu
# multi-module project CLI, against a one-off f64 reference. It does not run a
# model, load weights, or exercise the agent turn or launcher.

set -eu

if [ "$#" -ne 2 ]; then
  printf '%s\n' "usage: $0 <amu-cli.macho> <absolute-workspace-output-dir>" >&2
  exit 2
fi

CLI=$1
OUT_DIR=$2
EXPECTED_CLI_SHA256=ae94dc99ffe489ef77cb5eb0044bea1d2500a4273d45c55bcf57b887994f390a
EXPECTED_LOGMEL_SHA256=19f892cd437a994661354c3ec90963c3b5ef84ee4885cc157e3a96595049fcd4
EXPECTED_NN_SHA256=4693d227291a31b8c59378b0ab114715a983dfbfd17308d5b478181793a3604d
AMU_COMMIT=d673111b66f43a8569e545c772a70e51737e1707
EXPECTED_RESULT=38

REPO_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
GITHUB_ROOT=$(CDPATH= cd -- "$REPO_ROOT/../../.." && pwd)

case "$OUT_DIR" in
  "$GITHUB_ROOT"/workspaces/*) ;;
  *) printf '%s\n' "refusing output outside $GITHUB_ROOT/workspaces" >&2; exit 2 ;;
esac
case "$CLI" in
  /*) ;;
  *) printf '%s\n' "Amu CLI path must be absolute" >&2; exit 2 ;;
esac
if [ ! -x "$CLI" ]; then
  printf '%s\n' "Amu CLI is missing or not executable: $CLI" >&2
  exit 2
fi
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi

CLI_SHA256=$(shasum -a 256 "$CLI" | cut -d ' ' -f 1)
if [ "$CLI_SHA256" != "$EXPECTED_CLI_SHA256" ]; then
  printf '%s\n' "unexpected Amu CLI digest: $CLI_SHA256" >&2
  exit 2
fi
LOGMEL="$REPO_ROOT/kotoba/itonami/log_mel.kotoba"
SOURCE="$REPO_ROOT/kotoba/itonami/nn_ops.kotoba"
LOGMEL_SHA256=$(shasum -a 256 "$LOGMEL" | cut -d ' ' -f 1)
SOURCE_SHA256=$(shasum -a 256 "$SOURCE" | cut -d ' ' -f 1)
if [ "$LOGMEL_SHA256" != "$EXPECTED_LOGMEL_SHA256" ]; then
  printf '%s\n' "unexpected log-mel source digest: $LOGMEL_SHA256" >&2
  exit 2
fi
if [ "$SOURCE_SHA256" != "$EXPECTED_NN_SHA256" ]; then
  printf '%s\n' "unexpected nn-ops source digest: $SOURCE_SHA256" >&2
  exit 2
fi

# run_gate <dir> <nn-ops-source-file>: lock + compile
run_gate() {
  dir=$1
  src=$2
  gate="$dir/src/nn_ops_gate.kotoba"
  mkdir -p "$dir/src"
  cp "$LOGMEL" "$dir/src/log_mel.kotoba"
  cp "$src" "$dir/src/nn_ops.kotoba"
  cat > "$gate" <<'EOF2'
(ns itonami.nn-ops-gate
  (:require [itonami.nn-ops :as nn])
  (:export [main]))
(defn main [] :i64 (nn/match-count))
EOF2
  lm="$dir/src/log_mel.kotoba"
  nn="$dir/src/nn_ops.kotoba"
  # module lines sorted by name: itonami.log-mel < itonami.nn-ops < itonami.nn-ops-gate
  printf 'KSL2\nentry %s\nmodule itonami.log-mel %s\nmodule itonami.nn-ops %s\nmodule itonami.nn-ops-gate %s\nfile %s %s\nfile %s %s\nfile %s %s\n' \
    "$gate" "$lm" "$nn" "$gate" \
    "$(shasum -a 256 "$lm" | cut -d ' ' -f 1)" "$lm" \
    "$(shasum -a 256 "$nn" | cut -d ' ' -f 1)" "$nn" \
    "$(shasum -a 256 "$gate" | cut -d ' ' -f 1)" "$gate" > "$dir/nn-ops.ksl"
  "$CLI" compile "$gate" --source-lock "$dir/nn-ops.ksl" -o "$dir/nn-ops-tests.macho"
  codesign --verify --strict "$dir/nn-ops-tests.macho"
}

POS="$OUT_DIR/positive"
run_gate "$POS" "$SOURCE"
GATE_PATH="$POS/src/nn_ops_gate.kotoba"
LOCK="$POS/nn-ops.ksl"
PROGRAM="$POS/nn-ops-tests.macho"
DIRECT_RESULT=$("$PROGRAM")
LOCKED_RESULT=$("$CLI" run "$GATE_PATH" --source-lock "$LOCK")
ARTIFACT_RESULT=$("$CLI" run "$PROGRAM")
for result in "$DIRECT_RESULT" "$LOCKED_RESULT" "$ARTIFACT_RESULT"; do
  if [ "$result" != "$EXPECTED_RESULT" ]; then
    printf 'nn-ops result mismatch: expected %s, got %s\n' "$EXPECTED_RESULT" "$result" >&2
    exit 1
  fi
done

# negative controls: each mutation must change the source and stop the gate
# from returning the full match count
NEG="$OUT_DIR/negative"
mkdir -p "$NEG"
NEG_RESULTS=""
mutate() {
  name=$1
  pattern=$2
  replacement=$3
  sed "s/$pattern/$replacement/" "$SOURCE" > "$NEG/$name.kotoba"
  if cmp -s "$SOURCE" "$NEG/$name.kotoba"; then
    printf 'negative control %s did not change the source\n' "$name" >&2
    exit 1
  fi
  run_gate "$NEG/$name" "$NEG/$name.kotoba"
  result=$("$NEG/$name/nn-ops-tests.macho")
  if [ "$result" = "$EXPECTED_RESULT" ]; then
    printf 'negative control %s still passed the gate\n' "$name" >&2
    exit 1
  fi
  NEG_RESULTS="$NEG_RESULTS $name=$result"
}
mutate gelu-coefficient '(f64-to-bits 0.044715)' '(f64-to-bits 0.04)'
mutate tanh-numerator '(fdiv (f64-to-bits 2.0) (fadd (exp-wide' '(fdiv (f64-to-bits 1.0) (fadd (exp-wide'
mutate exp-reduction '(fmul (itof k) ' '(fmul (itof (+ k 1)) '
mutate exp-clamp '(f64-min 60.0 (f64-from-bits x))' '(f64-min 10.0 (f64-from-bits x))'
mutate variance-divisor '(fdiv (var-run 0 mean (zero)) (f64-to-bits 16.0))' '(fdiv (var-run 0 mean (zero)) (f64-to-bits 15.0))'
mutate layernorm-shift '(fadd (fmul (fmul (fsub x mean) inv) g) b)' '(fadd (fmul (fmul (fsub x mean) inv) g) (zero))'

# negative control: a source changed after locking is refused
SOURCE_PATH="$POS/src/nn_ops.kotoba"
printf '\n' >> "$SOURCE_PATH"
if "$CLI" compile "$GATE_PATH" --source-lock "$LOCK" \
  -o "$OUT_DIR/should-not-exist.macho" > "$OUT_DIR/refusal.stdout" 2> "$OUT_DIR/refusal.stderr"; then
  printf '%s\n' "changed locked source unexpectedly compiled" >&2
  exit 1
fi
if ! grep -q 'EINPUT a locked project source' "$OUT_DIR/refusal.stderr"; then
  cat "$OUT_DIR/refusal.stderr" >&2
  printf '%s\n' "changed source refusal did not identify the locked input" >&2
  exit 1
fi
if [ -e "$OUT_DIR/should-not-exist.macho" ]; then
  printf '%s\n' "refused compile left an output artifact" >&2
  exit 1
fi

{
  printf 'format: itonami.nn-ops-selfhost-gate.v1\n'
  printf 'amu_pr_commit: %s\n' "$AMU_COMMIT"
  printf 'amu_cli_sha256: %s\n' "$CLI_SHA256"
  printf 'log_mel_source_sha256: %s\n' "$LOGMEL_SHA256"
  printf 'nn_ops_source_sha256: %s\n' "$SOURCE_SHA256"
  printf 'program_sha256: %s\n' "$(shasum -a 256 "$PROGRAM" | cut -d ' ' -f 1)"
  printf 'direct_result: %s\n' "$DIRECT_RESULT"
  printf 'locked_run_result: %s\n' "$LOCKED_RESULT"
  printf 'artifact_run_result: %s\n' "$ARTIFACT_RESULT"
  printf 'negative_control_results:%s\n' "$NEG_RESULTS"
  printf 'changed_source_refusal: PASS\n'
  printf 'qualification: bounded scalar nn ops on fixed fixtures; no weights, matrix ops, model, turn or launcher\n'
} > "$OUT_DIR/build-receipt.txt"

cat "$OUT_DIR/build-receipt.txt"
