#!/bin/sh
# Compile and run the native audio-encoder feed-forward sublayer (itonami.audio-ffn) on the real
# Qwen3-ASR-0.6B weights with the pinned Amu multi-module project CLI. The model is cloned
# (APFS clonefile) into a directory granted to the guest on fd 3; the guest reads it only through
# FS2 F/E requests. Expected values come from a CPython float64 computation of the same sublayer
# (struct/json for the weights, math.erf for GELU) and are compared to 1e-12 relative (the native results differ from CPython by 18 and 54 ulps on the two sums). One
# evaluation allocates a lot and the seed has no collector, so the gate program runs once per
# case (argv 0) and the script counts the cases that exit 1. It does not run attention, the conv
# front end, a model, the agent turn or the launcher.

set -eu

if [ "$#" -ne 3 ]; then
  printf '{'bf16': '09de868917eb1ba9764794cdd5e3c890e462ec22709d9ede4cf1e1554a33549b', 'dq': 'c3f22e7c3f189346d8e6a6225c0ae41796369e6045d142dfb031e6fcb429e8d5', 'lm': 'daf0d273329a7b5a05aef4255b985f2e1c031c74f32596e9578add46980b1f5e', 'nn': '4693d227291a31b8c59378b0ab114715a983dfbfd17308d5b478181793a3604d', 'ge': '36b4c98a4df8fd817695a62d1602320f23d93fb38ddf97c1fb124bdcbd7c18a6', 'st': '20562030183d7a09fd43303821ecab5ed9065275a1ad68494eb3bb456e9c8f75', 'wf': '8ec4fb02f9fdaa6a3d89f68f69a95d77ff878c21e4a531922333ce2b1e44a2c6', 'src': '34a8acd0d611d2171ef8059bb5ef841f93987519fcfb942c7dceaff566f7134c', 'gate': '3ed8b6d837a356e0b9908661f660d9a1bd395cc088388883aa3d807915999054'}\n' "usage: $0 <amu-cli.macho> <absolute-workspace-output-dir> <model.safetensors>" >&2
  exit 2
fi

CLI=$1
OUT_DIR=$2
MODEL=$3
EXPECTED_CLI_SHA256=ee9a94e406f90dd1c899121708bed01b44818f2c3bc0b9780f266b0408c61ff0
EXPECTED_MODEL_SHA256=79d6cbd4c98c7bbffe9db2edac07f56cd6637d0d5944b27f6c2b8353840323ea
EXPECTED_BF16_SHA256=09de868917eb1ba9764794cdd5e3c890e462ec22709d9ede4cf1e1554a33549b
EXPECTED_DEQUANT_SHA256=c3f22e7c3f189346d8e6a6225c0ae41796369e6045d142dfb031e6fcb429e8d5
EXPECTED_LOGMEL_SHA256=daf0d273329a7b5a05aef4255b985f2e1c031c74f32596e9578add46980b1f5e
EXPECTED_NNOPS_SHA256=4693d227291a31b8c59378b0ab114715a983dfbfd17308d5b478181793a3604d
EXPECTED_GELU_SHA256=36b4c98a4df8fd817695a62d1602320f23d93fb38ddf97c1fb124bdcbd7c18a6
EXPECTED_ST_SHA256=20562030183d7a09fd43303821ecab5ed9065275a1ad68494eb3bb456e9c8f75
EXPECTED_WF_SHA256=8ec4fb02f9fdaa6a3d89f68f69a95d77ff878c21e4a531922333ce2b1e44a2c6
EXPECTED_SOURCE_SHA256=4cec3f3eae02e8b7b681cb2b7fac3dbe8f98ca85cb2eac608c4fbf4affe47e91
EXPECTED_STEP_SHA256=84376ac04492c187fa7a6278fd5a0ecf8fc5ac343d1f5f41a85618111585dc6d
EXPECTED_GATE_SHA256=dd07a54f42edf03c17eeba390f97de45de87ad06b553d9b4e3af723dd083083e
CASES=33
STACK_CASES=8
REFUSALS=5
LAYERS=18
TOTAL=$((CASES + STACK_CASES + REFUSALS))

REPO_ROOT=$(git -C "$(dirname "$0")/.." rev-parse --show-toplevel)
GITHUB_ROOT=$(CDPATH= cd -- "$REPO_ROOT/../../.." && pwd)

case "$OUT_DIR" in
  "$GITHUB_ROOT"/workspaces/*) ;;
  *) printf '%s\n' "refusing output outside $GITHUB_ROOT/workspaces" >&2; exit 2 ;;
esac
case "$CLI" in
  /*) ;;
  *) printf '%s\n' "Amu CLI path must be absolute" >&2; exit 2 ;;
esac
case "$MODEL" in
  /*) ;;
  *) printf '%s\n' "model path must be absolute" >&2; exit 2 ;;
esac
if [ ! -x "$CLI" ]; then
  printf '%s\n' "Amu CLI is missing or not executable: $CLI" >&2
  exit 2
fi
if [ ! -f "$MODEL" ]; then
  printf '%s\n' "model file is missing: $MODEL" >&2
  exit 2
fi
if [ -e "$OUT_DIR" ]; then
  printf '%s\n' "refusing to overwrite existing output: $OUT_DIR" >&2
  exit 2
fi

check_sha() {
  actual=$(shasum -a 256 "$1" | cut -d ' ' -f 1)
  if [ "$actual" != "$2" ]; then
    printf 'unexpected digest for %s: %s\n' "$1" "$actual" >&2
    exit 2
  fi
}
KD="$REPO_ROOT/kotoba/itonami"
BF16="$KD/bf16.kotoba"
DEQUANT="$KD/ggml_dequant.kotoba"
LOGMEL="$KD/log_mel.kotoba"
NNOPS="$KD/nn_ops.kotoba"
GELU="$KD/gelu_erf.kotoba"
ST="$KD/safetensors.kotoba"
WF="$KD/weights_file.kotoba"
SOURCE="$KD/audio_ffn.kotoba"
GATE="$REPO_ROOT/test/native/audio_ffn_gate.kotoba"
STEP="$REPO_ROOT/kotoba/agent_cli/audio_layer_step_cli.kotoba"
check_sha "$CLI" "$EXPECTED_CLI_SHA256"
check_sha "$MODEL" "$EXPECTED_MODEL_SHA256"
check_sha "$BF16" "$EXPECTED_BF16_SHA256"
check_sha "$DEQUANT" "$EXPECTED_DEQUANT_SHA256"
check_sha "$LOGMEL" "$EXPECTED_LOGMEL_SHA256"
check_sha "$NNOPS" "$EXPECTED_NNOPS_SHA256"
check_sha "$GELU" "$EXPECTED_GELU_SHA256"
check_sha "$ST" "$EXPECTED_ST_SHA256"
check_sha "$WF" "$EXPECTED_WF_SHA256"
check_sha "$SOURCE" "$EXPECTED_SOURCE_SHA256"
check_sha "$GATE" "$EXPECTED_GATE_SHA256"
check_sha "$STEP" "$EXPECTED_STEP_SHA256"

SCOPE="$OUT_DIR/scope"
mkdir -m 700 -p "$SCOPE/d"
/bin/cp -c "$MODEL" "$SCOPE/d/model.safetensors"

# run_gate <dir> <audio_ffn-source>: lock + compile with the FS35 command profile
run_gate() {
  dir=$1
  src=$2
  s="$dir/src"
  mkdir -p "$s"
  cp "$BF16" "$s/bf16.kotoba"
  cp "$DEQUANT" "$s/ggml_dequant.kotoba"
  cp "$LOGMEL" "$s/log_mel.kotoba"
  cp "$NNOPS" "$s/nn_ops.kotoba"
  cp "$GELU" "$s/gelu_erf.kotoba"
  cp "$ST" "$s/safetensors.kotoba"
  cp "$WF" "$s/weights_file.kotoba"
  cp "$src" "$s/audio_ffn.kotoba"
  cp "$GATE" "$s/audio_ffn_gate.kotoba"
  # modules sorted by name, files sorted by path
  {
    printf 'KSL2\nentry %s/audio_ffn_gate.kotoba\n' "$s"
    printf 'module itonami.audio-ffn %s/audio_ffn.kotoba\n' "$s"
    printf 'module itonami.audio-ffn-gate %s/audio_ffn_gate.kotoba\n' "$s"
    printf 'module itonami.bf16 %s/bf16.kotoba\n' "$s"
    printf 'module itonami.gelu-erf %s/gelu_erf.kotoba\n' "$s"
    printf 'module itonami.ggml-dequant %s/ggml_dequant.kotoba\n' "$s"
    printf 'module itonami.log-mel %s/log_mel.kotoba\n' "$s"
    printf 'module itonami.nn-ops %s/nn_ops.kotoba\n' "$s"
    printf 'module itonami.safetensors %s/safetensors.kotoba\n' "$s"
    printf 'module itonami.weights-file %s/weights_file.kotoba\n' "$s"
    for f in audio_ffn audio_ffn_gate bf16 gelu_erf ggml_dequant log_mel nn_ops safetensors weights_file; do
      printf 'file %s %s/%s.kotoba\n' "$(shasum -a 256 "$s/$f.kotoba" | cut -d ' ' -f 1)" "$s" "$f"
    done
  } > "$dir/audio-ffn.ksl"
  "$CLI" compile "$s/audio_ffn_gate.kotoba" --source-lock "$dir/audio-ffn.ksl" \
    --runtime-profile amu-command-fs35 -o "$dir/audio-ffn-tests.macho"
  codesign --verify --strict "$dir/audio-ffn-tests.macho"
}

# run_cases <program>: sets PASSED to the number of cases that exit 1
run_cases() {
  PASSED=0
  CASE_LINES=""
  k=0
  while [ "$k" -lt "$CASES" ]; do
    set +e
    line=$("$1" "$k" 3< "$SCOPE" 2>/dev/null)
    status=$?
    set -e
    if [ "$status" -eq 1 ]; then
      PASSED=$((PASSED + 1))
    fi
    CASE_LINES="$CASE_LINES$line;"
    k=$((k + 1))
  done
}

# build_step <dir>: the one-layer CLI over the same sources as the gate program in <dir>
build_step() {
  dir=$1
  s="$dir/src"
  cp "$STEP" "$s/audio_layer_step_cli.kotoba"
  {
    printf 'KSL2\nentry %s/audio_layer_step_cli.kotoba\n' "$s"
    printf 'module agent-cli.audio-layer-step-cli %s/audio_layer_step_cli.kotoba\n' "$s"
    printf 'module itonami.audio-ffn %s/audio_ffn.kotoba\n' "$s"
    printf 'module itonami.bf16 %s/bf16.kotoba\n' "$s"
    printf 'module itonami.gelu-erf %s/gelu_erf.kotoba\n' "$s"
    printf 'module itonami.ggml-dequant %s/ggml_dequant.kotoba\n' "$s"
    printf 'module itonami.log-mel %s/log_mel.kotoba\n' "$s"
    printf 'module itonami.nn-ops %s/nn_ops.kotoba\n' "$s"
    printf 'module itonami.safetensors %s/safetensors.kotoba\n' "$s"
    printf 'module itonami.weights-file %s/weights_file.kotoba\n' "$s"
    for f in audio_ffn audio_layer_step_cli bf16 gelu_erf ggml_dequant log_mel nn_ops safetensors weights_file; do
      printf 'file %s %s/%s.kotoba\n' "$(shasum -a 256 "$s/$f.kotoba" | cut -d ' ' -f 1)" "$s" "$f"
    done
  } > "$dir/audio-layer-step.ksl"
  "$CLI" compile "$s/audio_layer_step_cli.kotoba" --source-lock "$dir/audio-layer-step.ksl" \
    --runtime-profile amu-command-fs35 -o "$dir/audio-layer-step.macho"
  codesign --verify --strict "$dir/audio-layer-step.macho"
}

# step_status <program> <args...>: runs the CLI with the scope on fd 3; sets STEP_OUT and STEP_STATUS
step_status() {
  prog=$1
  shift
  set +e
  STEP_OUT=$("$prog" "$@" 3< "$SCOPE" 2>/dev/null)
  STEP_STATUS=$?
  set -e
}

# run_stack <dir>: chains the layers as separate processes (hex on argv in, stdout out), checks
# the activations after 3 and 18 layers with the gate program, then the five refusals; sets
# STACK_PASSED (out of STACK_CASES + REFUSALS)
run_stack() {
  dir=$1
  STACK_PASSED=0
  build_step "$dir"
  step="$dir/audio-layer-step.macho"
  gate="$dir/audio-ffn-tests.macho"
  h=""
  h3=""
  l=0
  while [ "$l" -lt "$LAYERS" ]; do
    step_status "$step" /d/model.safetensors "$l" "$h"
    if [ "$STEP_STATUS" -ne 0 ] || [ "${#STEP_OUT}" -ne 43008 ]; then
      h=""
      break
    fi
    h=$STEP_OUT
    if [ "$l" -eq 2 ]; then
      h3=$h
    fi
    l=$((l + 1))
  done
  k=33
  while [ "$k" -le 40 ]; do
    if [ "$k" -le 36 ]; then
      arg=$h
    else
      arg=$h3
    fi
    set +e
    "$gate" "$k" "$arg" 3< "$SCOPE" > /dev/null 2>&1
    status=$?
    set -e
    if [ "$status" -eq 1 ]; then
      STACK_PASSED=$((STACK_PASSED + 1))
    fi
    k=$((k + 1))
  done
  # refusals: exit 2 and nothing on stdout
  good=$h3
  step_status "$step" /d/model.safetensors 18 "$good"
  [ "$STEP_STATUS" -eq 2 ] && [ -z "$STEP_OUT" ] && STACK_PASSED=$((STACK_PASSED + 1))
  short=$(printf '%s' "$good" | cut -c 2-)
  step_status "$step" /d/model.safetensors 0 "$short"
  [ "$STEP_STATUS" -eq 2 ] && [ -z "$STEP_OUT" ] && STACK_PASSED=$((STACK_PASSED + 1))
  bad="g$(printf '%s' "$good" | cut -c 2-)"
  step_status "$step" /d/model.safetensors 0 "$bad"
  [ "$STEP_STATUS" -eq 2 ] && [ -z "$STEP_OUT" ] && STACK_PASSED=$((STACK_PASSED + 1))
  step_status "$step" /d/model.safetensors x "$good"
  [ "$STEP_STATUS" -eq 2 ] && [ -z "$STEP_OUT" ] && STACK_PASSED=$((STACK_PASSED + 1))
  step_status "$step" /d/missing.bin 0 "$good"
  [ "$STEP_STATUS" -eq 2 ] && [ -z "$STEP_OUT" ] && STACK_PASSED=$((STACK_PASSED + 1))
  return 0
}

POS="$OUT_DIR/positive"
run_gate "$POS" "$SOURCE"
PROGRAM="$POS/audio-ffn-tests.macho"
run_cases "$PROGRAM"
if [ "$PASSED" -ne "$CASES" ]; then
  printf 'audio-ffn: %s of %s cases passed: %s\n' "$PASSED" "$CASES" "$CASE_LINES" >&2
  exit 1
fi
POS_PASSED=$PASSED
POS_LINES=$CASE_LINES
run_stack "$POS"
if [ "$STACK_PASSED" -ne $((STACK_CASES + REFUSALS)) ]; then
  printf 'audio-ffn stack: %s of %s checks passed\n' "$STACK_PASSED" $((STACK_CASES + REFUSALS)) >&2
  exit 1
fi
POS_STACK=$STACK_PASSED

# negative controls: each mutation must change the source and stop at least one case from passing
NEG="$OUT_DIR/negative"
mkdir -p "$NEG"
NEG_RESULTS=""
mutate() {
  name=$1
  pattern=$2
  replacement=$3
  sed "s/$pattern/$replacement/" "$SOURCE" > "$NEG/$name.kotoba"
  if cmp -s "$SOURCE" "$NEG/$name.kotoba"; then
    printf 'negative control %s did not change the source\n' "$name" >&2
    exit 1
  fi
  run_gate "$NEG/$name" "$NEG/$name.kotoba"
  run_cases "$NEG/$name/audio-ffn-tests.macho"
  total=$PASSED
  if [ "$PASSED" -eq "$CASES" ]; then
    run_stack "$NEG/$name"
    total=$((CASES + STACK_PASSED))
  fi
  if [ "$total" -eq "$TOTAL" ]; then
    printf 'negative control %s still passed the gate\n' "$name" >&2
    exit 1
  fi
  NEG_RESULTS="$NEG_RESULTS $name=$total/$TOTAL"
}
mutate ln-eps '(f64-to-bits 0.00001)' '(f64-to-bits 0.0001)'
mutate ln-variance '(sq-dev x 0 mean (zero)) n)' '(sq-dev x 0 mean (zero)) (itof 895))'
mutate ln-gamma-beta '(ln-run x g b 0 mean inv' '(ln-run x b g 0 mean inv'
mutate bias-dropped '(vector-at bias (+ r0 k))' '(zero)'
mutate activation-identity '(ge\/gelu-erf (vector-at v i))' '(vector-at v i)'
mutate residual '(add-run x c 0' '(add-run c c 0'
mutate input-vector '(\* 3 i) (+ 1' '(* 2 i) (+ 1'
mutate row-offset '(+ woff (\* r (\* cols 2)))' '(+ woff (* r cols))'
mutate fc2-weight 'linear-run path w2 896 3584' 'linear-run path w1 896 3584'
mutate attn-scale '(f64-to-bits 0.125)' '(f64-to-bits 0.25)'
mutate attn-heads '(>= h 14)' '(>= h 13)'
mutate attn-softmax-sum 'z (fadd e0 (fadd e1 e2))' 'z (fadd e0 e1)'
mutate attn-bias '(read-vec path boff 896)' '(read-vec path (+ boff 2) 896)'
mutate attn-residual '(add-run x o 0' '(add-run o o 0'
mutate attn-value-mix '(fmul p2 (vector-at v2 j))' '(fmul p2 (vector-at v1 j))'
mutate attn-key 'k2 (project path wk bk h2)' 'k2 (project path wk bk h1)'
mutate attn-token-offset '(+ 1 (\* 5 t))' '(+ 1 (* 4 t))'
mutate layer-token-input '(token-of a 1)' '(token-of a 0)'
mutate layer-token-order '(concat3 f0 f1 f2)' '(concat3 f0 f2 f1)'
mutate layer-ffn-skipped 'f2 (ffn-on path layer (token-of a 2))' 'f2 (token-of a 2)'
mutate layer-slice-offset '(- i (- end 896))' '(- i (- end 895))'
mutate hex-decode-shift '(i64-shift-left acc 4)' '(i64-shift-left acc 3)'
mutate hex-encode-order '(string-concat (enc-range v lo mid) (enc-range v mid hi))' '(string-concat (enc-range v mid hi) (enc-range v lo mid))'
mutate hex-nibble-table '"0123456789abcdef"' '"0123456789abcdee"'
mutate step-ignores-input '(if synth (synth-input)' '(if true (synth-input)'
mutate step-skips-hex-check '(not synth) (or (not (= (bytes-count b) 43008)) (not (all-hex? b 0 43008)))' '(not synth) (or (not (= (bytes-count b) 43008)) false)'

# negative control: a source changed after locking is refused
printf '\n' >> "$POS/src/audio_ffn.kotoba"
if "$CLI" compile "$POS/src/audio_ffn_gate.kotoba" --source-lock "$POS/audio-ffn.ksl" \
  --runtime-profile amu-command-fs35 -o "$OUT_DIR/should-not-exist.macho" \
  > "$OUT_DIR/refusal.stdout" 2> "$OUT_DIR/refusal.stderr"; then
  printf '%s\n' "changed locked source unexpectedly compiled" >&2
  exit 1
fi
if ! grep -q 'EINPUT a locked project source' "$OUT_DIR/refusal.stderr"; then
  cat "$OUT_DIR/refusal.stderr" >&2
  printf '%s\n' "changed source refusal did not identify the locked input" >&2
  exit 1
fi
if [ -e "$OUT_DIR/should-not-exist.macho" ]; then
  printf '%s\n' "refused compile left an output artifact" >&2
  exit 1
fi

rm -f "$SCOPE/d/model.safetensors"
{
  printf 'format: itonami.audio-ffn-selfhost-gate.v1\n'
  printf 'amu_cli_sha256: %s\n' "$EXPECTED_CLI_SHA256"
  printf 'model_sha256: %s\n' "$EXPECTED_MODEL_SHA256"
  printf 'audio_ffn_source_sha256: %s\n' "$EXPECTED_SOURCE_SHA256"
  printf 'weights_file_source_sha256: %s\n' "$EXPECTED_WF_SHA256"
  printf 'gate_source_sha256: %s\n' "$EXPECTED_GATE_SHA256"
  printf 'runtime_profile: amu-command-fs35 (directory on fd 3), one process per case\n'
  printf 'program_sha256: %s\n' "$(shasum -a 256 "$PROGRAM" | cut -d ' ' -f 1)"
  printf 'cases_passed: %s of %s\n' "$POS_PASSED" "$CASES"
  printf 'stack_checks_passed: %s of %s (8 values after 3 and 18 layers, 5 refusals)\n' "$POS_STACK" $((STACK_CASES + REFUSALS))
  printf 'cases: %s\n' "$POS_LINES"
  printf 'negative_control_checks_passed:%s\n' "$NEG_RESULTS"
  printf 'changed_source_refusal: PASS\n'
  printf 'qualification: layers 0 and 5: feed-forward sublayer of one 896-wide token, self-attention sublayer of three, the two composed into the whole pre-LN encoder layer, and the 18-layer stack (one process per layer, activations as hex on argv) on the real weights to 1e-12 (1e-11 for the stack) relative against CPython float64; not the conv front end, positional handling, chunking, an equality claim with the original model implementation, a model run, turn or launcher\n'
} > "$OUT_DIR/build-receipt.txt"

cat "$OUT_DIR/build-receipt.txt"
