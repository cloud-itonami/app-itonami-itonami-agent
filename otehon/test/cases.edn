  ;; :seed writes a scratch profile (scripts run for real — echo/printf/
  ;; shell builtins only, no network). :request carries the job and a
  ;; pinned :now. :needles assert doc substrings; :output-doc pins the
  ;; full document on the core cases.
  {:id :run/no-agent-ok :op :run
   :seed {"config.yaml" "model:\n  default: mishima\n  provider: murakumo\n  base_url: https://api.murakumo.cloud/v1\n"
          "itonami.edn" "{:itonami/schema \"cloud.itonami.profile.v2\" :profile/id \"run-no-agent-ok\" :profile/hermes-compatible true :runtime {:engine :itonami-agent :scheduler :itonami} :placement {:mode :local :order [:local] :inference-rail :murakumo} :inference {:rails [:murakumo] :authorities [\"api.murakumo.cloud\"] :deny-hosts [\"openrouter.ai\"]} :state {} :bundle {:cid \"bafkreix\" :files 1} :capabilities [] :cron? true}"
          "cron/jobs.json" "{\"note\": \"keep me\", \"jobs\": [{\"id\": \"nightly\", \"name\": \"nightly\", \"enabled\": true, \"state\": \"scheduled\", \"next_run_at\": \"2026-11-08T01:00:00+09:00\", \"no_agent\": true, \"script\": \"hello.sh\", \"prompt\": \"say hi\", \"schedule\": {\"kind\": \"interval\", \"minutes\": 60, \"display\": \"every 60m\"}}]}"
          "scripts/hello.sh" "#!/bin/sh\necho hi\n"}
   :request {:job "nightly"}
   :expect {:exit 0 :status "ok" :lines ["ran nightly: ok"]
            :output-doc "# Cron Job: nightly\n\n**Job ID:** nightly\n**Run Time:** 2026-11-08 00:00:00\n**Schedule:** every 60m\n**Engine:** itonami-agent\n\n## Prompt\n\n[IMPORTANT: You are running as a scheduled cron job. DELIVERY: The configured lane is 'local'. Return your report as the final response; do NOT use send_message or try to deliver the output yourself. The scheduler stores local-lane output in the cron output record and sends non-local lanes through its configured delivery adapter. A missing adapter is recorded as delivery_failed. SILENT: If there is genuinely nothing new to report, respond with exactly \"[SILENT]\" (nothing else) to suppress delivery. [SILENT] is a literal ASCII control token — never translate or rephrase it, whatever language the rest of your answer uses. Never combine [SILENT] with content — either report your findings normally, or say [SILENT] and nothing more. FAILURE: If a delegated child fails and this cron run must be recorded as failed, put [CRON_FAILURE] on the first line by itself, then explain the child failure on following lines. RECURSION: This is a run of an EXISTING scheduled job — execute the task now. NEVER create or update a cron job because of recurring or future-schedule language in the task prompt below; treat phrasing like \"each Monday\" or \"every day at 9\" as context for this run, not as a request to schedule another job.]\n\n## Script Output\nThe following data was collected by a pre-run script. Use it as context for your analysis.\n\n```\nhi\n```\n\nsay hi\n\n## Response\n\nhi\n"
            :job-after {"id" "nightly" "name" "nightly" "enabled" true "state" "scheduled" "no_agent" true "script" "hello.sh" "prompt" "say hi" "schedule" {"kind" "interval" "minutes" 60 "display" "every 60m"} "last_run_at" "2026-11-08T00:00:00.000000+09:00" "last_status" "ok" "last_error" nil "last_delivery_error" nil "failure_streak" 0 "repeat" {"completed" 1}}
            :jobs-doc {"note" "keep me" "updated_at" "2026-11-08T00:00:00.000000+09:00"}}}
