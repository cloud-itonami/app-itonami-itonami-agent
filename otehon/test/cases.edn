   :edit [["yakuwari.edn" "{:capability :read_source :decision :autonomous}" "{:capability :read_source :decision :blocked}"]]
   :expect {:status :refused :reason "authority/blocked"}}

  ;; ------------------------------------------------------------ apply-order
  {:id :apply-order/basic :op :apply-order
   :job-id "a1" :stamp "2026-11-08_00-00-00" :result-status "ok"
   :output-path "cron/output/a1/2026-11-08_00-00-00.md"
   :record {:repeat-completed 1} :deliver "local,line"
   :expect {:idempotency-key "a1/2026-11-08_00-00-00/ok"
            :order [:write-output :apply-record :append-ledger :deliver]
            :steps [{:step :write-output :path "cron/output/a1/2026-11-08_00-00-00.md"
                     :key "a1/2026-11-08_00-00-00/ok/output"}
                    {:step :apply-record :record {:repeat-completed 1}
                     :key "a1/2026-11-08_00-00-00/ok/record"}
                    {:step :append-ledger :job "a1" :stamp "2026-11-08_00-00-00"
                     :key "a1/2026-11-08_00-00-00/ok/ledger"}
                    {:step :deliver :lanes ["local" "line"]
                     :key "a1/2026-11-08_00-00-00/ok/deliver"}]}}
  {:id :apply-order/default-lane :op :apply-order
   :job-id "a1" :stamp "2026-11-08_00-00-00" :result-status "silent"
   :output-path "cron/output/a1/2026-11-08_00-00-00.md"
   :record {:repeat-completed 2 :terminal? false}
   :expect {:idempotency-key "a1/2026-11-08_00-00-00/silent"
            :order [:write-output :apply-record :append-ledger :deliver]
            :steps [{:step :write-output :path "cron/output/a1/2026-11-08_00-00-00.md"
                     :key "a1/2026-11-08_00-00-00/silent/output"}
                    {:step :apply-record :record {:repeat-completed 2 :terminal? false}
                     :key "a1/2026-11-08_00-00-00/silent/record"}
                    {:step :append-ledger :job "a1" :stamp "2026-11-08_00-00-00"
                     :key "a1/2026-11-08_00-00-00/silent/ledger"}
                    {:step :deliver :lanes ["local"]
                     :key "a1/2026-11-08_00-00-00/silent/deliver"}]}}

