  {:id :mcp/login-ok :op :mcp
   :call ["login-plan" "login" "x" {"url" "https://h"} false]
   :expect {:value {:login {:server "x" :url "https://h" :device? false}}}}
  {:id :mcp/login-device :op :mcp
   :call ["login-plan" "login" "x" {"url" "https://h"} true]
   :expect {:value {:login {:server "x" :url "https://h" :device? true}}}}
  {:id :mcp/login-no-server :op :mcp
   :call ["login-plan" "login" nil {"url" "https://h"} false]
