  ;; ------------------------------------------------------------ turn-exec
  {:id :turn-exec/ok-single :op :turn-exec
   :plan {:status :ok :exec [{:id "inference"}]}
   :expect {:status :done :ran 1 :stub-calls 1
            :steps [{:id "inference" :index 0 :result {:status :ok :id "inference"}}]}}
  {:id :turn-exec/ok-multi :op :turn-exec
   :plan {:status :ok :exec [{:id "a"} {:id "b"} {:id "c"}]}
   :expect {:status :done :ran 3 :stub-calls 3
            :steps [{:id "a" :index 0 :result {:status :ok :id "a"}}
                    {:id "b" :index 1 :result {:status :ok :id "b"}}
                    {:id "c" :index 2 :result {:status :ok :id "c"}}]}}
  {:id :turn-exec/held-passthrough :op :turn-exec :via "throw"
