  {:id :neg/dry-run-job-missing :negative true :op :dry-run :profile "itonami-ok" :job "digest-tick"
   :edit [["cron/jobs.json" "\"name\": \"digest-tick\"" "\"name\": \"renamed\""]]
   :expect {:status :refused :reason "job/not-found"}}
  {:id :neg/dry-run-cron-disabled :negative true :op :dry-run :profile "itonami-ok" :job "digest-tick"
   :edit [["itonami.edn" ":cron? true" ":cron? false"]]
   :expect {:status :refused :reason "profile/cron-disabled"}}
  {:id :neg/dry-run-capability-blocked :negative true :op :dry-run :profile "itonami-ok" :job "digest-tick"
