  {:id :pause/set-show-lift :op :pause
   :steps [{:action "set" :reason "owner check" :at "2026-11-08T00:00:00+09:00"}
           {:action "show"}
           {:action "lift"}]
   :expect {:steps [{:action "set" :active true
                     :record "2026-11-08T00:00:00+09:00 owner check"
                     :message "paused — cron dispatch and new gateway turns are stopped (owner check). lift with: itonami-agent resume"}
                    {:action "show" :active true
                     :record "2026-11-08T00:00:00+09:00 owner check"}
                    {:action "lift" :was-active true :active false
                     :message "resumed — emergency stop lifted"}]}}
  {:id :pause/set-no-reason-lift-idempotent :op :pause
   :steps [{:action "lift"}
           {:action "set" :at "2026-11-08T00:00:00+09:00"}
           {:action "lift"}
           {:action "lift"}]
   :expect {:steps [{:action "lift" :was-active false :active false
                     :message "nothing to resume (not paused)"}
                    {:action "set" :active true
                     :record "2026-11-08T00:00:00+09:00"
                     :message "paused — cron dispatch and new gateway turns are stopped. lift with: itonami-agent resume"}
                    {:action "lift" :was-active true :active false
                     :message "resumed — emergency stop lifted"}
                    {:action "lift" :was-active false :active false
                     :message "nothing to resume (not paused)"}]}}
