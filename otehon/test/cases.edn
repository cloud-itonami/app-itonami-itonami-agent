   :expect {:status :held :reason "authority/needs-owner"}}
  {:id :turn-gate/empty-prompt :op :turn-gate :profile "itonami-ok" :prompt ""
   :expect {:status :refused :reason "turn/empty-prompt"}}
  {:id :neg/turn-gate-without-manifest :negative true :op :turn-gate :profile "itonami-ok" :prompt "hello"
   :edit [["itonami.edn" :delete]]
   :expect {:status :refused :reason "rail/itonami-without-manifest"}}
  {:id :turn-gate/selection-exec :op :turn-gate :profile "itonami-ok" :prompt "hello"
   :capabilities [:read_source]
   :expect {:status :ok
            :selection {:requested ["hermes-cli"] :selected ["hermes-cli"]
                        :denied [] :unknown [] :platform "cli"}
            :exec [{:id "inference"
                    :request {:kind :inference :prompt "hello" :toolsets ["hermes-cli"]
                              :reasoning-effort "low"
                              :decisions [{:capability :read_source :decision :autonomous :source :yakuwari}]
                              :target {:provider "murakumo" :model "mishima" :host "api.murakumo.cloud"
