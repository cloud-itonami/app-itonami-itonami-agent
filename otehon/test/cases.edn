  {:id :mcp/login-no-spec :op :mcp
   :call ["login-plan" "login" "x" nil false]
   :expect {:value {:usage "usage: itonami-agent mcp login <server> [--device]   (the server must be in config.yaml mcp_servers)"}}}
  {:id :mcp/login-wrong-sub :op :mcp
   :call ["login-plan" "serve" "x" {"url" "https://h"} false]
   :expect {:value {:usage "usage: itonami-agent mcp login <server> [--device]   (the server must be in config.yaml mcp_servers)"}}}
  {:id :mcp/login-empty-server :op :mcp
   :call ["login-plan" "login" "" {"url" "https://h"} false]
