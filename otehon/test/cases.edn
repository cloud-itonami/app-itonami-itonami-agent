   :expect {:checked 0 :mismatch [] :missing []}}

  ;; ------------------------------------------------------------ peer
  {:id :peer-plan-fetch :op :peer-plan
   :local {"a" {:sha "aa" :size 1}}
   :remote {"a" {:sha "aa" :size 1} "b" {:sha "bb" :size 2}}
   :expect {:fetch [{:sha "bb" :size 2}] :send [] :same 1}}
  {:id :peer-plan-send :op :peer-plan
   :local {"a" {:sha "aa" :size 1} "b" {:sha "bb" :size 2}}
   :remote {"a" {:sha "aa" :size 1}}
   :expect {:fetch [] :send [{:sha "bb" :size 2}] :same 1}}
  {:id :peer-plan-equal :op :peer-plan
   :local {"a" {:sha "aa" :size 1}} :remote {"a" {:sha "aa" :size 1}}
   :expect {:fetch [] :send [] :same 1}}
  {:id :peer-plan-empty :op :peer-plan :local {} :remote {}
   :expect {:fetch [] :send [] :same 0}}

  ;; ------------------------------------------------------------ peer repair
  {:id :peer-repair-basic :op :peer-repair-plan
   :mismatch ["b"] :missing ["c"]
   :remote {"b" {:sha "bb" :size 2} "d" {:sha "dd" :size 4}}
   :expect {:repair [{:rel "b" :sha "bb" :size 2}] :unrepairable ["c"]}}
  {:id :peer-repair-none :op :peer-repair-plan
   :mismatch [] :missing []
   :remote {"a" {:sha "aa" :size 1}}
   :expect {:repair [] :unrepairable []}}
  {:id :peer-repair-unrepairable :op :peer-repair-plan
   :mismatch ["x"] :missing []
   :remote {}
   :expect {:repair [] :unrepairable ["x"]}}
  {:id :peer-repair-sorted :op :peer-repair-plan
   :mismatch ["z" "a"] :missing ["m"]
   :remote {"z" {:sha "zz" :size 26} "a" {:sha "aa" :size 1} "m" {:sha "mm" :size 13}}
   :expect {:repair [{:rel "a" :sha "aa" :size 1}
                      {:rel "m" :sha "mm" :size 13}
                      {:rel "z" :sha "zz" :size 26}]
            :unrepairable []}}

