   :files {"a.txt" [97] "b.bin" [98 99]} :tamper {"b.bin" [120]}
   :expect {:checked 2 :mismatch ["b.bin"] :missing []}}
  {:id :cas-manifest-missing :op :cas-manifest
   :files {"a.txt" [97] "b.bin" [98 99]} :absent ["b.bin"]
