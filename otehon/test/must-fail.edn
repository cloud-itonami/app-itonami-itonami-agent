   :request {:profile "p1"
             :steps [["claim" "j1" "cron" "2026-11-08T10:00:01.000000+09:00"]
                     ["claim" "j1" "cron" "2026-11-08T10:00:02.000000+09:00"]]}
   :expect {:results [{:claimed true} {:claimed true}]}}
