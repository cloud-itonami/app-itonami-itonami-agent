;; Harness self-test: every case here is wrong on purpose. A runner must
;; report each one as FAIL and exit non-zero; if it passes any of them the
;; harness cannot tell a broken core from a working one.
{:fixtures "fixtures"
 :cases
 [;; wrong expectation on a clean profile
  {:id :must-fail/clean-profile-has-errors :op :check :profile "itonami-ok"
   :expect {:errors 1}}
  ;; an unlisted capability claimed autonomous
  {:id :must-fail/unlisted-autonomous :op :decide :profile "itonami-ok" :capability :spend
   :expect {:decision :autonomous}}
  ;; a negative control whose edit changes nothing: the automatic control
  ;; (unedited input must not satisfy :expect) has to catch it
  {:id :must-fail/no-op-edit :negative true :op :decide :profile "itonami-ok" :capability :git_push
   :edit [["SOUL.md" "Propose only." "Propose only."]]
   :expect {:decision :blocked}}
  ;; a Hermes profile planned as an itonami run
  {:id :must-fail/hermes-dry-run-ok :op :dry-run :profile "hermes-ok" :job "daily"
   :expect {:status :ok}}
  ;; a wrong next fire time on a clean profile
  {:id :must-fail/tick-wrong-next :op :tick :profile "itonami-ok"
   :now {:iso "2026-11-08T00:00:00+09:00"
         :parts {:year 2026 :month 11 :day 8 :hour 0 :minute 0}}
   :expect {:due [] :next {"a1b2c3d4e5f6" {:year 2026 :month 11 :day 8 :hour 0 :minute 18}}}}
  ;; a wrong scheduler on a seeded itonami profile (proves the status
  ;; scheduler assertion bites)
  {:id :must-fail/status-wrong-scheduler :op :status
   :seed {"profiles/p1/itonami.edn" "{:profile/id \"p1\" :runtime {:engine :itonami-agent :scheduler :itonami}}"
          "profiles/p1/cron/jobs.json" "{\"jobs\": []}"}
   :expect {:profiles [{:name "p1" :scheduler "hermes" :jobs 0}]}}
  ;; a lift claimed active on a fresh store (proves was-active is read,
  ;; not assumed)
  {:id :must-fail/pause-lift-was-active :op :pause
   :steps [{:action "lift"}]
   :expect {:steps [{:action "lift" :was-active true :active false
                     :message "resumed — emergency stop lifted"}]}}
  ;; a wrong model line on a clean config
  {:id :must-fail/model-wrong-line :op :model
   :seed {"config.yaml" "model:\n  default: mishima\n  provider: murakumo\n"}
   :expect {:lines ["model:     WRONG   (model.default)"]}}
  ;; a wrong rewritten text on a set
  {:id :must-fail/model-wrong-written :op :model
   :seed {"config.yaml" "model:\n  default: mishima\n"}
   :request {:pos ["k2"]}
   :expect {:written "WRONG"}}]}
