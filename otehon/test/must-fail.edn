   :request {:profile "p1"
             :steps [["enqueue" "e1" {"id" "j1"} "c" false "2026-11-08T10:00:01.000000+09:00"]
                     ["claim" "e1" 100]
                     ["finish" "e1" "delivered" nil "2026-11-08T10:00:02.000000+09:00"]
                     ["finish" "e1" "delivered" nil "2026-11-08T10:00:03.000000+09:00"]]}
   :expect {:results [{"execution_id" "e1"} {:claimed true} {:finished true} {:finished true}]}}
  ;; S5a: claiming from an empty queue answers nil (proves the drain reads)
  {:id :must-fail/queue-claim-next-empty :op :queue
   :request {:profile "p1" :steps [["claim-next" 100]]}
   :expect {:results [{"execution_id" "e1"}]}}
