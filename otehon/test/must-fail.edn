;; Harness self-test: every case here is wrong on purpose. A runner must
;; report each one as FAIL and exit non-zero; if it passes any of them the
;; harness cannot tell a broken core from a working one.
{:fixtures "fixtures"
 :cases
 [;; wrong expectation on a clean profile
  {:id :must-fail/clean-profile-has-errors :op :check :profile "itonami-ok"
   :expect {:errors 1}}
  ;; an unlisted capability claimed autonomous
  {:id :must-fail/unlisted-autonomous :op :decide :profile "itonami-ok" :capability :spend
   :expect {:decision :autonomous}}
  ;; a negative control whose edit changes nothing: the automatic control
  ;; (unedited input must not satisfy :expect) has to catch it
  {:id :must-fail/no-op-edit :negative true :op :decide :profile "itonami-ok" :capability :git_push
   :edit [["SOUL.md" "Propose only." "Propose only."]]
   :expect {:decision :blocked}}
  ;; a Hermes profile planned as an itonami run
  {:id :must-fail/hermes-dry-run-ok :op :dry-run :profile "hermes-ok" :job "daily"
   :expect {:status :ok}}
  ;; a wrong next fire time on a clean profile
  {:id :must-fail/tick-wrong-next :op :tick :profile "itonami-ok"
   :now {:iso "2026-11-08T00:00:00+09:00"
         :parts {:year 2026 :month 11 :day 8 :hour 0 :minute 0}}
   :expect {:due [] :next {"a1b2c3d4e5f6" {:year 2026 :month 11 :day 8 :hour 0 :minute 18}}}}
  ;; a wrong scheduler on a seeded itonami profile (proves the status
  ;; scheduler assertion bites)
  {:id :must-fail/status-wrong-scheduler :op :status
   :seed {"profiles/p1/itonami.edn" "{:profile/id \"p1\" :runtime {:engine :itonami-agent :scheduler :itonami}}"
          "profiles/p1/cron/jobs.json" "{\"jobs\": []}"}
   :expect {:profiles [{:name "p1" :scheduler "hermes" :jobs 0}]}}
  ;; a lift claimed active on a fresh store (proves was-active is read,
  ;; not assumed)
  {:id :must-fail/pause-lift-was-active :op :pause
   :steps [{:action "lift"}]
   :expect {:steps [{:action "lift" :was-active true :active false
                     :message "resumed — emergency stop lifted"}]}}
  ;; a wrong model line on a clean config
  {:id :must-fail/model-wrong-line :op :model
   :seed {"config.yaml" "model:\n  default: mishima\n  provider: murakumo\n"}
   :expect {:lines ["model:     WRONG   (model.default)"]}}
  ;; a wrong rewritten text on a set
  {:id :must-fail/model-wrong-written :op :model
   :seed {"config.yaml" "model:\n  default: mishima\n"}
   :request {:pos ["k2"]}
   :expect {:written "WRONG"}}
  ;; a wrong first line on a finished run (proves lines are asserted)
  {:id :must-fail/run-wrong-line :op :run
   :seed {"config.yaml" "model:\n  default: mishima\n  provider: murakumo\n  base_url: https://api.murakumo.cloud/v1\n"
          "itonami.edn" "{:itonami/schema \"cloud.itonami.profile.v2\" :profile/id \"run-wrong-line\" :profile/hermes-compatible true :runtime {:engine :itonami-agent :scheduler :itonami} :placement {:mode :local :order [:local] :inference-rail :murakumo} :inference {:rails [:murakumo] :authorities [\"api.murakumo.cloud\"] :deny-hosts [\"openrouter.ai\"]} :state {} :bundle {:cid \"bafkreix\" :files 1} :capabilities [] :cron? true}"
          "cron/jobs.json" "{\"jobs\": [{\"id\": \"nightly\", \"name\": \"nightly\", \"enabled\": true, \"state\": \"scheduled\", \"next_run_at\": \"2026-11-08T01:00:00+09:00\", \"no_agent\": true, \"script\": \"hello.sh\", \"prompt\": \"say hi\", \"schedule\": {\"kind\": \"interval\", \"minutes\": 60, \"display\": \"every 60m\"}}]}"
          "scripts/hello.sh" "#!/bin/sh\necho hi\n"}
   :request {:job "nightly"}
   :expect {:exit 0 :status "ok" :lines ["ran nightly: WRONG"]}}
  ;; a wrong status on a refused run
  {:id :must-fail/run-wrong-status :op :run
   :seed {"config.yaml" "model:\n  default: mishima\n  provider: murakumo\n  base_url: https://api.murakumo.cloud/v1\n"
          "cron/jobs.json" "{\"jobs\": []}"}
   :request {:job "nightly"}
   :expect {:status "ok"}}
  ;; a wrong profile list row (proves list rows are asserted)
  {:id :must-fail/profile-wrong-row :op :profile
   :seed {"profiles/p1/itonami.edn" "{:profile/id \"p1\" :runtime {:scheduler :itonami}}"
          "profiles/p1/config.yaml" "model:\n  default: mishima\n"}
   :request {}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong runs line (proves execution rows are asserted)
  {:id :must-fail/runs-wrong-line :op :runs
   :request {:profile "p1" :setup-sql ["CREATE TABLE executions (id TEXT PRIMARY KEY, job_id TEXT, source TEXT, status TEXT, claimed_at TEXT, delivery_outcome TEXT)"
                                       "INSERT INTO executions (id, job_id, source, status, claimed_at, delivery_outcome) VALUES ('e1', 'j1', 'tick', 'completed', '2026-11-08T00:00:01+09:00', NULL)"]}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong incidents line (proves incident rows are asserted)
  {:id :must-fail/incidents-wrong-line :op :incidents
   :request {:profile "p1" :setup-sql ["CREATE TABLE cron_incidents (id TEXT PRIMARY KEY, job_id TEXT, state TEXT, failure_type TEXT, first_seen_at TEXT, last_seen_at TEXT)"
                                       "INSERT INTO cron_incidents (id, job_id, state, failure_type, first_seen_at, last_seen_at) VALUES ('s1', 'j1', 'detected', 'timeout', '2026-11-08T00:00:01+09:00', '2026-11-08T00:00:01+09:00')"]}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong refresh-bundle line (proves the refresh line is asserted)
  {:id :must-fail/profile-refresh-bundle-wrong-line :op :profile
   :seed {"profiles/ph/SOUL.md" "soul\n"
          "profiles/ph/profile.yaml" "name: ph\n"
          "profiles/ph/config.yaml" "model:\n  default: mishima\n"
          "profiles/ph/cron/jobs.json" "{\"jobs\": []}\n"
          "profiles/ph/itonami.edn" "{:profile/id \"ph\"}\n"}
   :request {:sub "refresh-bundle" :name "ph"}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong release line (proves release lines are asserted)
  {:id :must-fail/profile-release-wrong-line :op :profile
   :seed {"profiles/ph/SOUL.md" "soul\n"
          "profiles/ph/profile.yaml" "name: ph\n"
          "profiles/ph/config.yaml" "model:\n  default: mishima\n"
          "profiles/ph/cron/jobs.json" "{\"jobs\": []}\n"}
   :request {:sub "release" :name "ph"}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong import line (proves copy lines are asserted)
  {:id :must-fail/profile-import-wrong-line :op :profile
   :seed {"hermes/profiles/p1/SOUL.md" "soul\n"
          "hermes/profiles/p1/profile.yaml" "name: p1\n"
          "hermes/profiles/p1/config.yaml" "model:\n  default: mishima\n"
          "hermes/profiles/p1/cron/jobs.json" "{\"jobs\": []}\n"}
   :request {:sub "import" :from "hermes" :to "store" :name "p1"}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong adopt line (proves adopt lines are asserted)
  {:id :must-fail/profile-adopt-wrong-line :op :profile
   :seed {"profiles/p2/SOUL.md" "soul p2\n"
          "profiles/p2/profile.yaml" "name: p2\n"
          "profiles/p2/config.yaml" "model:\n  default: mishima\n"
          "profiles/p2/cron/jobs.json" "{\"jobs\": []}\n"}
   :request {:sub "adopt" :name "p2"}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong soul size (proves soul-written is asserted)
  {:id :must-fail/profile-soul-wrong-size :op :profile
   :seed {"profiles/p1/SOUL.md" "soul p1\n"
          "profiles/p1/profile.yaml" "name: p1\n"
          "profiles/p1/yakuwari.edn" "{:yakuwari/capabilities [{:capability :digest :decision :autonomous}]}\n"
          "registry.edn" "{:agents [{:agent/id \"p1\" :org/unit :u1 :org/world :default :agent/kind :worker :agent/capabilities [:digest]}]}\n"
          "worlds.edn" "{:worlds {:default {:name \"Default\" :units {:u1 {:what \"unit one\"}}}} :soul/common [{:line \"common line\"}]}\n"}
   :request {:sub "soul" :name "p1" :registry "registry.edn" :worlds "worlds.edn"}
   :expect {:exit 0 :soul-written [{:generated-chars 999}] :soul-backup "WRONG"}}
  ;; a wrong stage count (proves staged counts are asserted)
  {:id :must-fail/profile-stage-wrong-count :op :profile
   :seed {"profiles/p2/SOUL.md" "soul p2\n"
          "profiles/p2/profile.yaml" "name: p2\n"
          "profiles/p2/cron/jobs.json" "{\"jobs\": [{\"id\": \"j1\", \"schedule\": \"*-*-* *:00:00\", \"script\": \"a.py\", \"deliver\": \"local\", \"enabled\": true}]}\n"
          "profiles/p2/scripts/a.py" "print(1)\n"
          "artifact/migration.json" "{\"format\": \"kotoba-hermes-cron-hy-patch-v2\", \"script_files\": [{\"profile\": \"p2\", \"source\": \"scripts/a.py\", \"target\": \"scripts/a.hy\", \"source_sha256\": \"cc42155088fca5730758db72b2a5bca33112a941dfaa2d43098ec422ce4ea213\", \"target_sha256\": \"67fb159b26750ff6047ee163578aaed927b0f9052775cb6e23f39761cd439256\"}]}"
          "artifact/p2/scripts/a.hy" "(print 1)\n"}
   :request {:sub "hy-stage" :name "p2" :artifact "artifact"}
   :expect {:exit 0 :messages-include ["staged p2  files=9"]}}
  ;; a wrong migrate jobs doc (proves jobs-doc is asserted)
  {:id :must-fail/profile-migrate-wrong-jobs :op :profile
   :seed {"profiles/p2/SOUL.md" "soul p2\n"
          "profiles/p2/profile.yaml" "name: p2\n"
          "profiles/p2/cron/jobs.json" "{\"jobs\": [{\"id\": \"j1\", \"schedule\": \"*-*-* *:00:00\", \"script\": \"a.py\", \"deliver\": \"local\", \"enabled\": true}]}\n"
          "profiles/p2/scripts/a.py" "print(1)\n"
          "profiles/p2/scripts/a.hy" "(print 1)\n"
          "profiles/p2/itonami.edn" "{:itonami/schema \"cloud.itonami.profile.v2\" :profile/id \"p2\" :profile/hermes-compatible true :runtime {:engine :itonami-agent, :scheduler :itonami} :placement {:mode :local :order [:local] :inference-rail :murakumo} :inference {:rails [:murakumo] :authorities [\"api.murakumo.cloud\"] :deny-hosts [\"openrouter.ai\"]} :state {} :bundle {:cid \"bafkreix\" :files 1} :capabilities [] :cron? true}\n"
          "profiles/p2/gateway.parked" "2026-11-08T00:00:00+09:00\n"}
   :request {:sub "hy-migrate" :name "p2" :env {"KOTOBA_HY_DEPS" "test/fixtures/hydeps"}}
   :expect {:exit 0 :jobs-doc "WRONG"}}
  ;; a wrong did line (proves did:key output is asserted)
  {:id :must-fail/profile-did-wrong-did :op :profile
   :seed {"profiles/p1/SOUL.md" "soul p1\n"
          "profiles/p1/profile.yaml" "name: p1\n"}
   :request {:sub "did" :name "p1" :env {"ITONAMI_AGENT_IDENTITY_SEED" "9d61b19deffd5a60ba844af492ec2af44445687652b3cca8f0d0d3f7c5f5f5f0"}}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; a wrong bundle CID (proves the manifest lines are asserted)
  {:id :must-fail/profile-bundle-wrong-cid :op :profile
   :seed {"profiles/p2/SOUL.md" "soul p2\n"
          "profiles/p2/profile.yaml" "name: p2\n"
          "profiles/p2/cron/jobs.json" "{\"jobs\": []}\n"}
   :request {:sub "bundle" :name "p2"}
   :expect {:exit 0 :lines ["WRONG"]}}
  ;; S5a: a re-terminalized send answers false (proves the finish fence)
  {:id :must-fail/queue-finish-twice :op :queue
   :request {:profile "p1"
             :steps [["enqueue" "e1" {"id" "j1"} "c" false "2026-11-08T10:00:01.000000+09:00"]
                     ["claim" "e1" 100]
                     ["finish" "e1" "delivered" nil "2026-11-08T10:00:02.000000+09:00"]
                     ["finish" "e1" "delivered" nil "2026-11-08T10:00:03.000000+09:00"]]}
   :expect {:results [{"execution_id" "e1"} {:claimed true} {:finished true} {:finished true}]}}
  ;; S5a: claiming from an empty queue answers nil (proves the drain reads)
  {:id :must-fail/queue-claim-next-empty :op :queue
   :request {:profile "p1" :steps [["claim-next" 100]]}
   :expect {:results [{"execution_id" "e1"}]}}
  ;; S5a: a second claim on the same job answers fenced (proves the fence)
  {:id :must-fail/ledger-double-claim :op :ledger
   :request {:profile "p1"
             :steps [["claim" "j1" "cron" "2026-11-08T10:00:01.000000+09:00"]
                     ["claim" "j1" "cron" "2026-11-08T10:00:02.000000+09:00"]]}
   :expect {:results [{:claimed true} {:claimed true}]}}
  ;; S5a: finishing an unknown execution answers false (proves the fence)
  {:id :must-fail/ledger-finish-unknown :op :ledger
   :request {:profile "p1"
             :steps [["finish" "nope" true "delivered" "2026-11-08T10:00:01.000000+09:00"]]}
   :expect {:results [{:finished true}]}}
  ;; S5a: acking an unknown incident answers false (proves the fence)
  {:id :must-fail/ledger-ack-unknown :op :ledger
   :request {:profile "p1"
             :steps [["ack" "nope" "2026-11-08T10:00:01.000000+09:00"]]}
   :expect {:results [{:closed true}]}}
  ;; S5b: settling a non-latest execution answers nil (proves the fence)
  {:id :must-fail/drain-settle-stale :op :drain
   :request {:profile "p1"
             :jobs [{"id" "j1" "name" "J1" "deliver" "telegram"}]
             :setup-sql {"executions.db" ["INSERT INTO executions(id,job_id,source,process_id,pid,status,claimed_at) VALUES ('exec-old','j1','cron','seed',1,'claimed','2026-11-08T09:00:00.000000+09:00')"]}
             :steps [["settle" "exec-new" "j1" nil "delivered"]]}
   :expect {:results [true]}}
  ;; S5b: a failing adapter answers its error (proves the row is marked)
  {:id :must-fail/drain-deliver-error :op :drain
   :request {:profile "p1"
             :jobs [{"id" "j2" "name" "J2" "deliver" "sms"}]
             :delivery-fn "err:down"
             :steps [["deliver" "exec-2" "j2" "x" false "2026-11-08T10:00:01.000000+09:00"]]}
   :expect {:results [nil]}}
  ;; S5b: an empty queue drains zero rows (proves the drain reads)
  {:id :must-fail/drain-empty :op :drain
   :request {:profile "p1"
             :steps [["drain" "2026-11-08T10:00:01.000000+09:00"]]}
   :expect {:results [{:drained 1}]}}
  ;; S5b: a blind send answers nil when nothing is sent (proves the guard)
  {:id :must-fail/gateway-send-blind :op :gateway
   :request {:adapters {"telegram" "ok"}
             :steps [["send" "telegram" "" "" "hi"]]}
   :expect {:results ["sent"]}}
{:id :must-fail/watcher-max-ticks :op :watcher
   :request {:watcher {"session_id" "s1"}
             :sessions {"s1" {"state" "running"}}
             :session-seq ["s1" "s1" "s1" "s1" "s1"]
             :max-ticks 2
             :steps [["watch"]]}
   :expect {:results [nil]}}
  {:id :must-fail/watcher-silent-sends-nothing :op :watcher
   :request {:watcher {"session_id" "s1" "platform" "telegram" "chat_id" "-100"}
             :config {"display" {"background_process_notifications" "off"}}
             :sessions {"s1" {"state" "exited" "exit-code" 0 "output" "done"}}
             :session-seq ["s1"]
             :steps [["watch"] ["sends"]]}
   :expect {:results [nil [{"chat" "-100"}]]}}
  {:id :must-fail/watcher-consumed-skips-inject :op :watcher
   :request {:watcher {"session_id" "s1" "platform" "telegram" "chat_id" "-100" "notify_on_complete" true}
             :sessions {"s1" {"state" "exited" "exit-code" 0 "output" "done"}}
             :session-seq ["s1"]
             :consumed-ids ["s1"]
             :enqueue ["ok"]
             :steps [["watch"] ["enqueues"]]}
   :expect {:results [nil [{"session" "s1"}]]}}
  ;; S5c unit 2: unknown lanes/steps/verbs throw -----------------------
  {:id :must-fail/adapters-build-unknown :op :adapters :request {:steps [["build" "sms" {}]]} :expect {:results [{}]}}
    {:id :must-fail/adapters-unknown-step :op :adapters :request {:steps [["frobnicate"]]} :expect {:results [nil]}}
    {:id :must-fail/gateway-unknown-fan-in :op :gateway :request {:steps [["fan-in" "bogus"]]} :expect {:results [nil]}}
    {:id :must-fail/gateway-producer-invalid :op :gateway :request {:steps [["producer-identity" {"type" "nope"}]]} :expect {:results ["x"]}}
    {:id :must-fail/chat-chunk-zero :op :chat :request {:steps [["chunk" "x" 0]]} :expect {:results [["x"]]}}
    {:id :must-fail/chat-unknown-step :op :chat :request {:steps [["bogus"]]} :expect {:results [nil]}}
]}
